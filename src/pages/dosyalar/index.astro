---
import Layout from '../../layouts/Layout.astro';
import dosyalar from '../../data/dosyalar.json';
---
<Layout title="Dosyalar ve Windows uygulamaları | 657.com.tr" description="657.com.tr uygulamalarını indirin: kesinleşme, yargılama gideri, Müdürün Dolabı, GYS tercih robotu ve mülhakat sorgusu. Kullanım yazıları ve tarayıcı araçları." path="/dosyalar/">
 <header class="portal-sayfa-basligi"><div class="container"><nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span>/</span><span>Dosyalar</span></nav><div class="portal-sayfa-basligi__satir"><div class="dir__head"><h1>Dosyalar ve uygulamalar</h1><p>Windows uygulamaları, kullanım yazıları ve tarayıcıdan çalışan karşılıkları.</p></div></div></div></header>
 <div class="container page">
 <section class="panel" data-solid><div class="panel__head"><h2>İndirilebilir programlar</h2><span>{dosyalar.length} dosya</span></div><div class="prose"><table data-tablo><thead><tr><th scope="col">Program ve kullanım</th><th scope="col">İndirme</th><th scope="col">Tarayıcı aracı</th></tr></thead><tbody>{dosyalar.map(d=><tr><td><a href={d.kaynakYazi}><strong>{d.baslik}</strong></a><p>{d.aciklama}</p></td><td><a href={d.indirme} data-indirme-id={d.id} download>{d.dosya}</a><br/><small data-indirme-sayi={d.id}>Sayaç yükleniyor…</small><br/><small>{(d.boyut/1024/1024).toLocaleString('tr-TR',{maximumFractionDigits:1})} MB · Windows</small><details><summary>SHA-256</summary><code class="dosya-hash">{d.sha256}</code></details></td><td>{d.webAraci?<a href={d.webAraci}>Tarayıcıda kullan</a>:'Kullanım yazısını inceleyin'}</td></tr>)}</tbody></table></div></section>
 <p><a href="/avukatlik-asgari-ucret-tarifesi/">Güncel AAÜT ve kaynak PDF</a> · <a href="/devlet-personel-baskanligi-mutalaalari/">DPB görüşleri ve kaynak PDF’leri</a> · <a href="/dosyalar/yargilama-gideri-tum-tarifeler.pdf" download>Yargılama gideri tarifeleri · Tek A4 PDF</a></p></div>
</Layout>
<style>.dosya-hash{overflow-wrap:anywhere;font-size:var(--text-xs);}td{vertical-align:top;}td p{font-size:var(--text-sm);}</style>

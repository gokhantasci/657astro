---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import YaziKarti from '../../components/YaziKarti.astro';
import { ayarlar } from '../../lib/settings';

const site = ayarlar.site.url;
const yazilar = (await getCollection('yazilar', y => !y.data.taslak)).sort((a, b) => +b.data.date - +a.data.date);
const description = 'Enflasyon, tarifeler, atama ve kararname duyuruları: kamu personelini ilgilendiren kısa yazılar.';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Yazılar', item: `${site}/yazilar/` },
  ] },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Yazılar', url: `${site}/yazilar/`, inLanguage: 'tr-TR',
    mainEntity: { '@type': 'ItemList', itemListElement: yazilar.map((y, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site}/${y.id}/`, name: y.data.title })) } },
];
---
<Layout title="Yazılar | 657.com.tr" description={description} path="/yazilar/" jsonLd={jsonLd}>
 <div class="container page">
  <nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span aria-hidden="true">/</span><span aria-current="page">Yazılar</span></nav>
  <div class="dir__head"><h1>Yazılar</h1><p>{description}</p></div>
  <div class="panel" data-solid>
   <ul class="posts__list posts__list--full">
    {yazilar.map(y => <YaziKarti yazi={y}/>)}
   </ul>
  </div>
 </div>
</Layout>

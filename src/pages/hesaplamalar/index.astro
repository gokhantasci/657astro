---
import Layout from '../../layouts/Layout.astro';
import { gunlukAraclar, gunlukAracYolu } from '../../lib/gunluk-araclar';
const title = 'Günlük Hesaplamalar';
const description = 'Yüzde, KDV, tarih farkı, vücut kitle indeksi ve metin sayacı araçları.';
const araclar = [...gunlukAraclar.map(a => ({ ...a, yol: gunlukAracYolu(a.id) })), { baslik: 'İKM boy-kilo uygunluğu', aciklama: 'İnfaz ve koruma memuru alımlarındaki boy ve kilo koşullarını kontrol edin.', yol: '/infaz-ve-koruma-memuru-boy-kilo-hesaplama/' }];
---
<Layout title={title} description={description} path="/hesaplamalar/">
  <header class="portal-sayfa-basligi"><div class="container">
    <nav class="crumbs" aria-label="Konum"><a href="/araclar/">Araçlar</a><span aria-hidden="true">/</span><span aria-current="page">Günlük hesaplamalar</span></nav>
    <div class="dir__head"><h1>{title}</h1><p>{description}</p></div>
  </div></header>
  <div class="container page">
    <ul class="hesap-dizin">
      {araclar.map(a => <li class="panel" data-solid><a href={a.yol}><h2>{a.baslik}</h2><p>{a.aciklama}</p><span aria-hidden="true">→</span></a></li>)}
    </ul>
  </div>
</Layout>
<style>
  /* Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 */
  .hesap-dizin { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit,minmax(min(20rem,100%),1fr)); gap: var(--space-md); }
  .hesap-dizin a { display: block; min-block-size: 100%; padding: var(--space-md); color: var(--color-ink); text-decoration: none; }
  .hesap-dizin a:hover h2 { text-decoration: underline; }
  .hesap-dizin h2 { font-size: var(--text-lead); max-inline-size: none; margin: 0; }
  .hesap-dizin p { color: var(--color-muted); margin-block: .35rem; }
  .hesap-dizin a span { color: var(--color-accent-text); }
</style>

---
import Layout from '../../layouts/Layout.astro';
import { gunlukAraclar, gunlukAracYolu } from '../../lib/gunluk-araclar';
export function getStaticPaths() { return gunlukAraclar.map(arac => ({ params: { arac: arac.id }, props: { arac } })); }
const { arac } = Astro.props;
const path = gunlukAracYolu(arac.id);
---
<Layout title={arac.baslik} description={arac.aciklama} path={path}>
  <header class="portal-sayfa-basligi"><div class="container">
    <nav class="crumbs" aria-label="Konum"><a href="/hesaplamalar/">Günlük hesaplamalar</a><span aria-hidden="true">/</span><span aria-current="page">{arac.baslik}</span></nav>
    <div class="dir__head"><h1>{arac.baslik}</h1><p>{arac.aciklama}</p></div>
  </div></header>
  <div class="container page" data-gunluk={arac.id}>
    <div class="arac">
      <section class="panel" data-solid aria-labelledby="gunluk-girdi"><div class="panel__head"><h2 id="gunluk-girdi">{arac.id === 'kelime-sayaci' ? 'Metin' : 'Hesap bilgileri'}</h2></div>
        <div class="gunluk-girdi">
          {arac.id === 'yuzde' && <><label>Sayı (A)<input type="number" value="1000" step="any" data-alan="a"/></label><label>Oran / karşılaştırılan sayı (B)<input type="number" value="27.83" step="any" data-alan="b"/></label></>}
          {arac.id === 'kdv' && <><label>Tutar (TL)<input type="number" value="1000" min="0" step="0.01" data-alan="tutar"/></label><label>KDV oranı<select data-alan="oran"><option value="1">%1</option><option value="10">%10</option><option value="20" selected>%20</option></select></label><label>Girilen tutar<select data-alan="tur"><option value="haric">KDV hariç</option><option value="dahil">KDV dâhil</option></select></label></>}
          {arac.id === 'tarih-farki' && <><label for="gun-ilk">Başlangıç tarihi</label><input id="gun-ilk" type="date" value="2026-01-01" data-alan="ilk"/><label for="gun-son">Bitiş tarihi</label><input id="gun-son" type="date" value="2026-11-28" data-alan="son"/></>}
          {arac.id === 'vki' && <><label>Boy (cm)<input type="number" value="175" min="1" step="0.1" data-alan="boy"/></label><label>Ağırlık (kg)<input type="number" value="72" min="0.1" step="0.1" data-alan="kilo"/></label></>}
          {arac.id === 'kelime-sayaci' && <label>Sayılacak metin<textarea rows="8" data-alan="metin" placeholder="Metni yazın veya yapıştırın"></textarea></label>}
        </div>
      </section>
      <section class="panel sonuc" data-solid aria-labelledby="gunluk-sonuc"><div class="panel__head"><h2 id="gunluk-sonuc">Sonuç</h2></div><div aria-live="polite"><div class="sonuc__ana"><p class="sonuc__deger" data-gunluk-ana>—</p></div><dl class="sonuc__satirlar" data-gunluk-dokum></dl></div></section>
    </div>
    {arac.id === 'vki' && <section class="panel" data-solid><div class="panel__head"><h2>VKİ nasıl yorumlanır?</h2></div><div class="prose"><p>DSÖ yetişkin hesabı kadınlar ve erkekler için aynı formülü kullanır. Kilogram cinsinden ağırlık, metre cinsinden boyun karesine bölünür. Çocuklar için yaşa ve cinsiyete göre büyüme referansları kullanılır.</p><p><a href="https://www.who.int/data/nutrition/nlis/info/malnutrition-in-women">DSÖ kaynağı ↗</a> · <a href="/infaz-ve-koruma-memuru-boy-kilo-hesaplama/">İKM başvurusu için boy-kilo kontrolü</a></p></div></section>}
  </div>
</Layout>
<script>import '../../scripts/hesaplamalar';</script>
<style>
  .gunluk-girdi { display: grid; gap: var(--space-sm); padding: var(--space-md); }
  .gunluk-girdi label { display: grid; gap: .35rem; }
  .gunluk-girdi :is(input,select,textarea) { inline-size: 100%; min-inline-size: 0; min-block-size: 44px; padding: .5rem .75rem; border: 1px solid var(--color-rule); border-radius: var(--radius-sm); background: var(--color-paper-2); color: var(--color-ink); font: inherit; }
</style>

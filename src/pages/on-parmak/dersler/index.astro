---
import Layout from '../../../layouts/Layout.astro';
import { ayarlar } from '../../../lib/settings';

const site = ayarlar.site.url;
const path = '/on-parmak/dersler/';
const title = 'On Parmak F ve Q Klavye Dersleri (Temel Sıra, Üst ve Alt Sıra) | 657.com.tr';
const description = 'TS 2117 Türk F Klavye standardına ve Q klavyeye göre sıfırdan interaktif on parmak klavye dersleri. Temel sıra, üst sıra, alt sıra, büyük harf ve parmak rehberi.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '657.com.tr On Parmak F ve Q Klavye Dersleri',
    description,
    url: new URL(path, site).href,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Tarayıcı',
    inLanguage: 'tr-TR',
    isAccessibleForFree: true,
  },
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <header class="portal-sayfa-basligi">
    <div class="container">
      <nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span>/</span><a href="/on-parmak/">On Parmak</a><span>/</span><span>Dersler</span></nav>
      <div class="dir__head">
        <h1>On Parmak F ve Q Klavye Dersleri</h1>
        <p><strong>TS 2117 Türk F Klavye</strong> (İhsan Sıtkı Yener’in TDK harf sıklığı araştırmasına dayalı bilimsel düzen) ve <strong>Türkçe Q Klavye</strong> için temel sıradan hıza kademeli on parmak eğitimi.</p>
      </div>
    </div>
  </header>

  <div class="container page dr-sayfa" data-dersler>
    <div class="dr-ust">
      <div class="dr-duzen" role="group" aria-label="Klavye düzeni seçimi">
        <button type="button" class="btn btn--kucuk" data-d-duzen="f" aria-pressed="true">Türkçe F Klavye (12 Ders)</button>
        <button type="button" class="btn btn--quiet btn--kucuk" data-d-duzen="q" aria-pressed="false">Türkçe Q Klavye (10 Ders)</button>
      </div>
      <a class="btn btn--quiet btn--kucuk" href="/on-parmak/">3 Dakikalık Resmî Sınav Ekranına Geç →</a>
    </div>

    <div class="dr-grid">
      <aside class="panel dr-menu" data-solid aria-label="Ders listesi">
        <div class="panel__head"><h2>Ders Müfredatı</h2></div>
        <div class="dr-liste" data-d-liste></div>
      </aside>

      <section class="panel dr-sahne" data-solid aria-label="İnteraktif ders alanı">
        <div class="panel__head">
          <div>
            <h2 data-d-baslik>1. Temel Sıra – İşaret Parmakları</h2>
            <p class="dr-aciklama" data-d-aciklama></p>
          </div>
          <button type="button" class="btn btn--quiet btn--kucuk" data-d-sifirla>Sıfırla</button>
        </div>

        <div class="dr-metrik">
          <div><span>Hız (DKS)</span><strong class="num" data-d-dks>0</strong></div>
          <div><span>Doğruluk</span><strong class="num" data-d-dogruluk>%100</strong></div>
          <div><span>Hata</span><strong class="num" data-d-hata>0</strong></div>
        </div>
        <div class="dr-bar"><div class="dr-bar__ic" data-d-ilerleme></div></div>

        <div class="dr-hedef" data-d-hedef></div>
        <div class="dr-giris-kap">
          <label class="visually-hidden" for="dr-giris">Tuş girişi</label>
          <input id="dr-giris" class="dr-giris" data-d-giris type="text" autocomplete="off" spellcheck="false" placeholder="Buraya tıklayıp ekrandaki harflere sırayla basın..." />
        </div>

        <div class="dr-sonuc" data-d-sonuc hidden></div>

        <div class="dr-ipucu" data-d-ipucu></div>
        <div class="op-kb" data-d-kb aria-label="Parmak rehberli sanal klavye"></div>
      </section>
    </div>

    <section class="panel" data-solid>
      <div class="panel__head"><h2>Bilimsel Dayanak: TS 2117 F Klavye Standardı</h2></div>
      <div class="prose" style="padding:var(--space-md) var(--space-lg);">
        <p><strong>Türkçe F Klavye (TS 2117)</strong>, 1955 yılında İhsan Sıtkı Yener başkanlığındaki komisyon tarafından Türk Dil Kurumu sözlüğündeki 29.934 kelimenin harf ve ikili harf (digram) sıklıkları hesaplanarak oluşturulmuştur. Bu bilimsel düzen sayesinde sol el <strong>%49</strong>, sağ el <strong>%51</strong> oranında dengeli çalışır; Türkçe’de en sık kullanılan sesli harfler (<code>a, e, i, u, ü</code>) sol el temel sırasında, en sık sessiz harfler (<code>k, m, l, t, y</code>) sağ el temel sırasında yer alır.</p>
      </div>
    </section>
  </div>

  <script>import '../../../scripts/on-parmak-dersler';</script>
</Layout>

<style>
.dr-sayfa{display:grid;gap:var(--space-lg);}
.dr-ust{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:var(--space-sm);}
.dr-duzen{display:flex;gap:var(--space-xs);flex-wrap:wrap;}
.dr-duzen [aria-pressed="true"]{background:var(--color-accent);color:var(--color-accent-ink);border-color:var(--color-accent);}
.dr-grid{display:grid;grid-template-columns:minmax(260px,320px) minmax(0,1fr);gap:var(--space-lg);align-items:start;}
.dr-liste{display:grid;max-height:580px;overflow-y:auto;}
.dr-liste :global(.dr-item){display:grid;gap:2px;text-align:left;padding:var(--space-sm) var(--space-md);background:transparent;border:0;border-bottom:1px solid var(--color-rule);color:var(--color-ink);cursor:pointer;}
.dr-liste :global(.dr-item:hover){background:var(--color-paper-3);}
.dr-liste :global(.dr-item.is-active){background:var(--color-accent-soft);border-left:3px solid var(--color-accent);}
.dr-liste :global(.dr-item strong){font-size:var(--text-sm);}
.dr-liste :global(.dr-item span),.dr-liste :global(.dr-item small){font-size:var(--text-xs);color:var(--color-muted);}
.dr-aciklama{margin:4px 0 0;font-size:var(--text-xs);color:var(--color-muted);}
.dr-metrik{display:flex;gap:var(--space-xl);padding:var(--space-sm) var(--space-lg);background:var(--color-paper-3);border-bottom:1px solid var(--color-rule);}
.dr-metrik>div{display:grid;}
.dr-metrik span{font-size:var(--text-xs);color:var(--color-muted);}
.dr-metrik strong{font-size:var(--text-lg);}
.dr-bar{height:4px;background:var(--color-rule);}
.dr-bar__ic{height:100%;width:0%;background:var(--color-accent);transition:width .15s;}
.dr-hedef{padding:var(--space-lg);font-family:var(--font-outlier);font-size:1.35rem;line-height:2;letter-spacing:.02em;user-select:none;}
.dr-hedef.is-shake{background:var(--color-accent-soft);}
.dr-hedef :global(.dr-ch--ok){color:var(--color-green);}
.dr-hedef :global(.dr-ch--cur){background:var(--color-accent);color:var(--color-accent-ink);border-radius:3px;padding:0 2px;}
.dr-giris-kap{padding:0 var(--space-lg) var(--space-md);}
.dr-giris{width:100%;min-height:46px;padding:0 var(--space-md);font-size:var(--text-md);}
.dr-sonuc{margin:0 var(--space-lg) var(--space-md);padding:var(--space-md);background:var(--color-green-soft);color:var(--color-green);border:1px solid var(--color-green);border-radius:var(--radius-pill);}
.dr-ipucu{padding:var(--space-xs) var(--space-lg);text-align:center;font-size:var(--text-xs);font-weight:600;color:var(--color-muted);border-top:1px solid var(--color-rule);}
.op-kb{padding:var(--space-sm) var(--space-md) var(--space-md);display:grid;gap:6px;justify-items:center;overflow-x:auto;}
.op-kb :global(.op-kb__row){display:flex;gap:5px;justify-content:center;}
.op-kb :global(.op-kb__key){display:grid;place-items:center;min-width:40px;height:38px;padding:0 6px;border-radius:6px;border:1px solid var(--color-rule);font-size:var(--text-sm);font-weight:600;background:var(--color-paper-3);color:var(--color-ink);}
.op-kb :global(.op-kb__key--space){min-width:240px;font-size:var(--text-xs);}
.op-kb :global(.op-kb__p1),.op-kb :global(.op-kb__p9){border-bottom:3px solid #e11d48;}
.op-kb :global(.op-kb__p2),.op-kb :global(.op-kb__p8){border-bottom:3px solid #d97706;}
.op-kb :global(.op-kb__p3),.op-kb :global(.op-kb__p7){border-bottom:3px solid #059669;}
.op-kb :global(.op-kb__p4),.op-kb :global(.op-kb__p6){border-bottom:3px solid #0284c7;}
.op-kb :global(.op-kb__p5){border-bottom:3px solid #6366f1;}
.op-kb :global(.op-kb__key.is-next){background:var(--color-accent);color:var(--color-accent-ink);border-color:var(--color-accent-strong);}
@media(max-width:960px){.dr-grid{grid-template-columns:minmax(0,1fr);}.dr-liste{max-height:240px;}}
</style>

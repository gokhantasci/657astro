---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Layout from '../../layouts/Layout.astro';
import veri from '../../data/kamu-misafirhaneleri.json';
import { ayarlar } from '../../lib/settings';

const site = ayarlar.site.url;
const path = '/kamu-misafirhaneleri/';
const title = 'Türkiye Kamu Misafirhaneleri Haritası 2026: 81 İl Fiyat, Telefon ve Resmî Adresler | 657.com.tr';
const description = `Türkiye haritası üzerinden 81 ilin kamu misafirhaneleri (Polisevi, Öğretmenevi, Hakimevi, DSİ, Orman). 2026 HMB Tebliğ taban tarifeleri, örnek oda fiyatları, resmî web adresleri ve Google Maps puanları.`;

const ilMap = new Map(veri.iller.map((x) => [x.plaka, x]));
const svgRaw = readFileSync(resolve('src/data/tr-yargi.svg'), 'utf8').replace(
  /<g id="il-(\d{2})"[^>]*>/g,
  (tag, plaka) => {
    const il = ilMap.get(plaka);
    const renk = il && il.dogrulanmisSayisi > 0 ? '#0284c7' : '#64748b';
    return tag.replace(/style="[^"]*"/, `style="--il-renk: ${renk};" data-plaka="${plaka}" data-il="${il?.ad ?? ''}" data-slug="${il?.slug ?? ''}"`);
  }
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Araçlar', item: `${site}/araclar/` },
      { '@type': 'ListItem', position: 3, name: 'Kamu Misafirhaneleri', item: new URL(path, site).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Türkiye Kamu Misafirhaneleri Rehberi (81 İl)',
    url: new URL(path, site).href,
    description,
    inLanguage: 'tr-TR',
  },
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <header class="portal-sayfa-basligi">
    <div class="container">
      <nav class="crumbs" aria-label="Konum">
        <a href="/">Anasayfa</a><span>/</span><a href="/araclar/">Araçlar</a><span>/</span><span>Kamu Misafirhaneleri</span>
      </nav>
      <div class="dir__head">
        <h1>Türkiye Kamu Misafirhaneleri Haritası (2026)</h1>
        <p>Haritadan dilediğiniz ili seçerek <strong>81 ildeki</strong> Polisevi, Öğretmenevi, Hakimevi, DSİ ve Orman misafirhanelerinin 2026 örnek fiyatlarını, resmî web adreslerini, sosyal medya kanallarını ve Google Maps değerlendirmelerini inceleyin.</p>
      </div>
    </div>
  </header>

  <div class="container page km-sayfa" data-km-app>
    <script id="km-veri" type="application/json" set:html={JSON.stringify(veri.iller)}></script>

    <!-- Arama ve Kurum Filtresi -->
    <section class="panel km-arac" data-solid aria-label="Misafirhane arama ve filtre">
      <div class="km-arac__satir">
        <label class="visually-hidden" for="km-ara">İl veya tesis ara</label>
        <input id="km-ara" type="search" data-km-ara placeholder="İl, ilçe veya tesis ara (örn. Sakarya, Hakimevi, Polisevi, DSİ)…" autocomplete="off" />
        <div class="km-filtre" role="group" aria-label="Kurum türü">
          {['', 'Öğretmenevi', 'Polisevi', 'Hakimevi', 'Sendika', 'Orduevi / Askerî', 'DSİ', 'Orman / Tarım', 'Üniversite', 'Ulaştırma / KGM'].map((k) => (
            <button type="button" class="km-pill" data-km-kurum={k} aria-pressed={k === '' ? 'true' : 'false'}>
              {k || 'Tümü'}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Harita + Seçili İl Paneli -->
    <div class="km-ana">
      <section class="panel km-harita-panel" data-solid aria-label="Etkileşimli Türkiye Misafirhane Haritası">
        <div class="panel__head">
          <h2>İl Seçin (81 İl)</h2>
          <span class="km-lejant"><i class="km-dot km-dot--detay"></i> Doğrudan teyitli fiyat/telefon · <i class="km-dot"></i> Resmî il portalı</span>
        </div>
        <div class="km-harita-kap" data-km-harita>
          <div class="km-tooltip" data-km-tooltip hidden></div>
          <Fragment set:html={svgRaw} />
        </div>
      </section>

      <aside class="panel km-detay" data-solid aria-live="polite" aria-label="Seçili ilin misafirhaneleri">
        <div class="panel__head">
          <h2 data-km-il-baslik>Sakarya Kamu Misafirhaneleri</h2>
          <a class="btn btn--kucuk" data-km-il-link href="/kamu-misafirhaneleri/sakarya/">İl sayfasını aç →</a>
        </div>
        <div class="km-kartlar" data-km-kartlar></div>
      </aside>
    </div>

    <!-- 2026 Resmî HMB Tebliğ Özeti -->
    <section class="panel" data-solid aria-labelledby="km-teblig-baslik">
      <div class="panel__head">
        <h2 id="km-teblig-baslik">2026 Resmî Taban Tarife ({veri.teblig2026.ad})</h2>
        <span style="font-size:var(--text-xs);color:var(--color-muted);">{veri.teblig2026.resmiGazete}</span>
      </div>
      <div class="prose" style="padding:var(--space-md) var(--space-lg);">
        <p><strong>Genel Misafirhaneler Asgari Konaklama Ücreti:</strong> {veri.teblig2026.misafirhaneAsgari}. İdareler tesisin standardı, konumu ve maliyetine göre bu alt sınırın üzerinde tarife belirleyebilir.</p>
        <div style="overflow-x:auto;">
          <table class="grid">
            <thead><tr><th>Tesis Kategorisi</th><th>Günlük Yemek (Asgari)</th><th>Günlük Konaklama (Asgari)</th></tr></thead>
            <tbody>
              {veri.teblig2026.egitimDinlenme.map((e) => (
                <tr><td>{e.kategori}</td><td class="num">{e.yemek}</td><td class="num">{e.konaklama}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:var(--text-sm);color:var(--color-muted);margin-top:var(--space-sm);"><strong>Ek Donanım Alt Sınırları:</strong> {veri.teblig2026.ekDonanim}</p>
      </div>
    </section>

    <!-- 81 İl Hızlı SEO Dizini -->
    <section class="panel" data-solid aria-labelledby="km-dizin-baslik">
      <div class="panel__head">
        <h2 id="km-dizin-baslik">81 İl Kamu Misafirhaneleri Dizini (A–Z)</h2>
        <span style="font-size:var(--text-xs);color:var(--color-muted);">{veri.toplamIl} il · {veri.toplamTesis} tesis</span>
      </div>
      <div class="km-dizin">
        {[...veri.iller].sort((a, b) => a.ad.localeCompare(b.ad, 'tr-TR')).map((il) => (
          <a href={`/kamu-misafirhaneleri/${il.slug}/`} class="km-il-chip">
            <span class="num">{il.plaka}</span>
            <strong>{il.ad}</strong>
            <small>{il.tesisSayisi}</small>
          </a>
        ))}
      </div>
    </section>
  </div>

  <script>import '../../scripts/kamu-misafirhaneleri';</script>
</Layout>

<style>
.km-sayfa{display:grid;gap:var(--space-lg);}
.km-arac{padding:var(--space-md) var(--space-lg);}
.km-arac__satir{display:grid;gap:var(--space-sm);}
.km-arac input{width:100%;min-height:44px;}
.km-filtre{display:flex;flex-wrap:wrap;gap:6px;}
.km-pill{min-height:34px;padding:4px 12px;border:1px solid var(--color-rule);border-radius:var(--radius-filter);background:var(--color-paper-2);color:var(--color-ink);font-size:var(--text-xs);font-weight:600;cursor:pointer;}
.km-pill[aria-pressed="true"]{background:var(--color-accent);color:var(--color-accent-ink);border-color:var(--color-accent);}
.km-ana{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,0.95fr);gap:var(--space-lg);align-items:start;}
.km-lejant{font-size:var(--text-xs);color:var(--color-muted);display:inline-flex;align-items:center;gap:6px;flex-wrap:wrap;}
.km-dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:#64748b;}
.km-dot--detay{background:#0284c7;}
.km-harita-kap{position:relative;padding:var(--space-md);overflow:hidden;}
.km-harita-kap :global(svg){width:100%;height:auto;display:block;}
.km-harita-kap :global(g[id^="il-"]){cursor:pointer;transition:opacity .15s,filter .15s;}
.km-harita-kap :global(g[id^="il-"] path){fill:var(--il-renk,#64748b);stroke:var(--color-paper);stroke-width:1.2;transition:fill .15s;}
.km-harita-kap :global(g[id^="il-"]:hover path){filter:brightness(1.18);}
.km-harita-kap :global(g[id^="il-"].is-selected path){fill:var(--color-accent);stroke:var(--color-ink);stroke-width:2;}
.km-tooltip{position:absolute;pointer-events:none;z-index:10;padding:6px 10px;border-radius:6px;background:var(--color-banner);color:var(--color-on-dark);font-size:var(--text-xs);font-weight:600;box-shadow:0 4px 14px rgba(0,0,0,.22);white-space:nowrap;}
.km-kartlar{padding:var(--space-md);display:grid;gap:var(--space-sm);max-height:540px;overflow-y:auto;}
.km-kartlar :global(.km-kart){padding:var(--space-md);background:var(--color-paper-3);border:1px solid var(--color-rule);border-radius:var(--radius-pill);display:grid;gap:6px;}
.km-kartlar :global(.km-kart__ust){display:flex;justify-content:space-between;align-items:start;gap:8px;}
.km-kartlar :global(.km-kart h3){margin:0;font-size:var(--text-md);line-height:1.35;max-width:none;}
.km-kartlar :global(.km-rozet){font-size:var(--text-xs);padding:2px 8px;border-radius:var(--radius-filter);background:var(--color-accent-soft);color:var(--color-accent-text);white-space:nowrap;font-weight:600;}
.km-kartlar :global(.km-meta){margin:0;font-size:var(--text-xs);color:var(--color-muted);line-height:1.5;max-width:none;}
.km-kartlar :global(.km-fiyat){margin:0;font-size:var(--text-sm);color:var(--color-ink);background:var(--color-paper-2);padding:6px 10px;border-radius:6px;border:1px solid var(--color-rule);max-width:none;}
.km-kartlar :global(.km-linkler){display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;font-size:var(--text-xs);}
.km-kartlar :global(.km-linkler a){text-decoration:none;padding:4px 10px;border-radius:var(--radius-filter);border:1px solid var(--color-rule);background:var(--color-paper-2);color:var(--color-ink);font-weight:600;}
.km-kartlar :global(.km-linkler a:hover){border-color:var(--color-accent);color:var(--color-accent-text);}
.km-dizin{padding:var(--space-md) var(--space-lg);display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;}
.km-il-chip{display:flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid var(--color-rule);border-radius:var(--radius-pill);background:var(--color-paper-3);text-decoration:none;color:var(--color-ink);font-size:var(--text-sm);}
.km-il-chip:hover{border-color:var(--color-accent);background:var(--color-paper-2);}
.km-il-chip span{font-size:var(--text-xs);color:var(--color-muted);font-weight:700;}
.km-il-chip strong{flex:1;}
.km-il-chip small{font-size:var(--text-xs);color:var(--color-muted);}
@media(max-width:980px){.km-ana{grid-template-columns:minmax(0,1fr);}.km-kartlar{max-height:none;}}
</style>

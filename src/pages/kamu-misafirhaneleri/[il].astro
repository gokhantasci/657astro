---
import Layout from '../../layouts/Layout.astro';
import veri from '../../data/kamu-misafirhaneleri.json';
import { ayarlar } from '../../lib/settings';

export function getStaticPaths() {
  return veri.iller.map((il) => ({
    params: { il: il.slug },
    props: { il },
  }));
}

const { il } = Astro.props;
const site = ayarlar.site.url;
const path = `/kamu-misafirhaneleri/${il.slug}/`;
const title = `${il.ad} Kamu Misafirhaneleri 2026: Fiyatlar, Telefonlar ve Resmî Adresler | 657.com.tr`;
const description = `${il.ad} kamu misafirhaneleri (Polisevi, Öğretmenevi, Hakimevi, DSİ, Orman) 2026 güncel rehberi: örnek konaklama ücretleri, telefon numaraları, resmî web adresleri ve Google Maps puanları.`;

const sss = [
  {
    soru: `${il.ad} kamu misafirhanelerinde 2026 konaklama fiyatları ne kadar?`,
    cevap: `31.12.2025 tarihli Hazine ve Maliye Bakanlığı Kamu Sosyal Tesislerine İlişkin Tebliğ (2026-1) uyarınca kamu misafirhanelerinde asgari konaklama ücreti 120,00 TL’dir. Kurumların maliyete göre belirlediği 2026 uygulama tarifeleri genellikle kamu personeli için gecelik 600–1.500 TL, sivil/onaylı misafirler için 1.200–2.900 TL bandındadır.`,
  },
  {
    soru: `${il.ad} kamu misafirhanelerinden kimler yararlanabilir?`,
    cevap: `Öncelikli olarak ilgili kurum personeli, emeklileri ve yakınları yararlanır. Boş kontenjan bulunması halinde diğer kamu görevlileri ve sivil vatandaşlar da kurumların misafir kabul esaslarına göre konaklayabilir.`,
  },
  {
    soru: `${il.ad} kamu misafirhaneleri için nasıl rezervasyon yapılır?`,
    cevap: `Rezervasyonlar doğrudan tesisin resmî web sitesi, telefon numarası veya bağlı olduğu il müdürlüğünün (.gov.tr / .pol.tr / .meb.k12.tr) duyuru kanalları üzerinden alınır.`,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Kamu Misafirhaneleri', item: `${site}/kamu-misafirhaneleri/` },
      { '@type': 'ListItem', position: 3, name: `${il.ad} Kamu Misafirhaneleri`, item: new URL(path, site).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${il.ad} Kamu Misafirhaneleri`,
    numberOfItems: il.tesisler.length,
    itemListElement: il.tesisler.map((t, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: t.ad,
      url: t.web || new URL(path, site).href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'tr-TR',
    mainEntity: sss.map((x) => ({
      '@type': 'Question',
      name: x.soru,
      acceptedAnswer: { '@type': 'Answer', text: x.cevap },
    })),
  },
];

const sira = veri.iller.findIndex((x) => x.slug === il.slug);
const onceki = veri.iller[(sira - 1 + veri.iller.length) % veri.iller.length];
const sonraki = veri.iller[(sira + 1) % veri.iller.length];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <header class="portal-sayfa-basligi">
    <div class="container">
      <nav class="crumbs" aria-label="Konum">
        <a href="/">Anasayfa</a><span>/</span><a href="/kamu-misafirhaneleri/">Kamu Misafirhaneleri</a><span>/</span><span>{il.ad}</span>
      </nav>
      <div class="dir__head">
        <h1>{il.ad} Kamu Misafirhaneleri (2026)</h1>
        <p>{il.ad} ({il.plaka}) ilindeki Polisevi, Öğretmenevi, Hakimevi, DSİ ve diğer kamu sosyal tesislerinin 2026 örnek fiyatları, iletişim numaraları, resmî web adresleri ve Google Maps bağlantıları.</p>
        <p style="margin-top:.75rem;"><a href={`/kamu-misafirhaneleri/?il=${il.slug}`} class="btn btn--quiet btn--kucuk">← Türkiye Haritasında {il.ad}’ı Göster</a></p>
      </div>
    </div>
  </header>

  <div class="container page kmi-sayfa">
    <section class="kmi-liste" aria-label={`${il.ad} kamu misafirhaneleri listesi`}>
      {il.tesisler.map((t) => (
        <article class="panel kmi-kart" data-solid>
          <div class="panel__head">
            <h2>{t.ad}</h2>
            <span class="kmi-rozet">{t.kurum}</span>
          </div>
          <div class="kmi-ic">
            <dl class="kmi-dl">
              <div><dt>İlçe / Adres</dt><dd>{t.ilce} · {t.adres}</dd></div>
              {t.telefon && (
                <div>
                  <dt>Telefon</dt>
                  <dd><a href={`tel:${t.telefon.split('/')[0].replace(/[^+\d]/g, '')}`}>{t.telefon}</a></dd>
                </div>
              )}
              <div><dt>2026 Örnek Fiyat / Tarife</dt><dd>{t.fiyat}</dd></div>
              <div><dt>Google Maps Puanı</dt><dd>{t.puan}</dd></div>
            </dl>
            <div class="kmi-eylem">
              {t.web && <a class="btn btn--kucuk" href={t.web} target="_blank" rel="noopener noreferrer">Resmî Web Sitesi ↗</a>}
              {t.sosyal && <a class="btn btn--quiet btn--kucuk" href={t.sosyal} target="_blank" rel="noopener noreferrer">Sosyal / Duyuru Kanalı ↗</a>}
              <a class="btn btn--quiet btn--kucuk" href={t.googleMaps} target="_blank" rel="noopener noreferrer">Google Maps &amp; Canlı Puanlar ↗</a>
              {t.kaynak && <a class="kmi-kaynak" href={t.kaynak} target="_blank" rel="noopener noreferrer">Kaynak ↗</a>}
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="panel" data-solid>
      <div class="panel__head"><h2>2026 Resmî Taban Tarife ve Kurallar</h2></div>
      <div class="prose" style="padding:var(--space-md) var(--space-lg);">
        <p><strong>Dayanak:</strong> {veri.teblig2026.ad} ({veri.teblig2026.resmiGazete}). Misafirhane asgari konaklama bedeli <strong>{veri.teblig2026.misafirhaneAsgari}</strong> olup idareler tesisin imkân ve maliyetine göre daha yüksek ücret uygulayabilir. Kesin müsaitlik ve oda fiyatı için gitmeden önce tesisin resmî telefonundan teyit almanız önerilir.</p>
      </div>
    </section>

    <section class="panel" data-solid>
      <div class="panel__head"><h2>Sık Sorulan Sorular</h2></div>
      <div class="sss__liste">
        {sss.map((x) => (
          <details class="sss__madde"><summary>{x.soru}</summary><p>{x.cevap}</p></details>
        ))}
      </div>
    </section>

    <nav class="panel kmi-nav" data-solid aria-label="Diğer iller">
      <a href={`/kamu-misafirhaneleri/${onceki.slug}/`}>← {onceki.ad} Kamu Misafirhaneleri</a>
      <a href="/kamu-misafirhaneleri/">81 İl Türkiye Haritası</a>
      <a href={`/kamu-misafirhaneleri/${sonraki.slug}/`}>{sonraki.ad} Kamu Misafirhaneleri →</a>
    </nav>
  </div>
</Layout>

<style>
.kmi-sayfa{display:grid;gap:var(--space-lg);}
.kmi-liste{display:grid;gap:var(--space-md);}
.kmi-rozet{font-size:var(--text-xs);padding:3px 10px;border-radius:var(--radius-filter);background:var(--color-accent-soft);color:var(--color-accent-text);font-weight:700;white-space:nowrap;}
.kmi-ic{padding:var(--space-md) var(--space-lg);display:grid;gap:var(--space-md);}
.kmi-dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-sm) var(--space-lg);margin:0;}
.kmi-dl dt{font-size:var(--text-xs);color:var(--color-muted);font-weight:600;}
.kmi-dl dd{margin:2px 0 0;font-size:var(--text-sm);line-height:1.5;}
.kmi-eylem{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-xs);}
.kmi-kaynak{margin-left:auto;font-size:var(--text-xs);color:var(--color-muted);}
.kmi-nav{display:flex;flex-wrap:wrap;justify-content:space-between;gap:var(--space-md);padding:var(--space-md) var(--space-lg);}
.kmi-nav a{min-height:44px;display:inline-flex;align-items:center;font-weight:600;}
@media(max-width:720px){.kmi-dl{grid-template-columns:minmax(0,1fr);}}
</style>

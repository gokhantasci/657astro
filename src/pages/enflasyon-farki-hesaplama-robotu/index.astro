---
import Layout from '../../layouts/Layout.astro';
import { ayarlar, getKatsayilar } from '../../lib/settings';
import { enflasyon, enflasyonDonemleri, ayAdi, donemBaslangici } from '../../lib/enflasyon-veri';
import {enflasyonAnlatimi} from '../../lib/enflasyon-anlatimi';
import {aylikBeklenti,beklentiler} from '../../lib/enflasyon-beklentileri';
import { enflasyonFarki } from '../../lib/enflasyon';
import { yuzde, tl, katsayi, ondalik } from '../../lib/bicim';

const site = ayarlar.site.url;
const k = {...getKatsayilar(donemBaslangici()),damga_orani_binde:ayarlar.maas_parametreleri.damga_vergisi_oran_binde};
const s = ayarlar.sabitler;
const e = enflasyon;
const girdi = {
  bazEndeks: e.baz_endeks.deger,
  topluSozlesmeZam: e.toplu_sozlesme.zam,
  sonrakiZam: e.sonraki_zam.zam,
  aylar: e.aylar.map(a => ({ degisim: a.degisim ?? aylikBeklenti(a.yil,a.ay) ?? 0, endeks: a.endeks })),
};
const r = enflasyonFarki(girdi, k, s);
const resmiSayisi = e.aylar.filter(a => a.endeks).length;
const sonrakiAy = ayAdi(e.sonraki_zam);
const title = `Enflasyon farkı hesaplama: ${e.kisa} memur zammı | 657.com.tr`;
const description = `${e.baslik} için memur enflasyon farkı, ${sonrakiAy} kümülatif zam ve yeni katsayılar. Resmî TÜİK verisiyle hesaplanır, kalan aylara kendi tahmininizi girebilirsiniz.`;
const istemci = { donem: e.kisa, sonrakiAy,tamam:resmiSayisi===6,girdi, katsayi: { memur_maas_aylik_katsayi: k.memur_maas_aylik_katsayi, taban_aylik_katsayi: k.taban_aylik_katsayi, yan_odeme_katsayi: k.yan_odeme_katsayi, asgari_ucret: k.asgari_ucret,damga_orani_binde:k.damga_orani_binde }, sabitler: s };
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Enflasyon farkı hesaplama', item: `${site}/enflasyon-farki-hesaplama-robotu/` },
  ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Enflasyon farkı hesaplama robotu', url: `${site}/enflasyon-farki-hesaplama-robotu/`,
    applicationCategory: 'FinanceApplication', operatingSystem: 'Tarayıcı', inLanguage: 'tr-TR', isAccessibleForFree: true, description },
];
---
<Layout title={title} description={description} path="/enflasyon-farki-hesaplama-robotu/" jsonLd={jsonLd}>
 <header class="portal-sayfa-basligi"><div class="container"><nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span aria-hidden="true">/</span><a href="/araclar/#maas">Maaş ve yolluk</a></nav><div class="portal-sayfa-basligi__satir"><div class="dir__head">
   <h1>Enflasyon farkı hesaplama</h1>
   <p>{e.baslik}: {resmiSayisi} ayın resmî TÜİK verisi girildi. Kalan aylara tahmininizi yazın; sonuç siz yazdıkça yenilenir.</p>
   {beklentiler.kaynak&&<p>Ortak beklenti kaynağı: <a href={beklentiler.kaynak}>{beklentiler.tarih?.split('-').reverse().join('/')} tarihli beklenti kaydı</a>. Tahminler resmî TÜFE olarak sunulmaz.</p>}
  </div></div></div></header>
 <div class="container page" data-enflasyon>
  

  <div class="arac">
   <section class="panel" aria-labelledby="aylar-title" data-solid>
    <div class="panel__head"><h2 id="aylar-title">Aylık enflasyon (TÜFE)</h2><button class="btn btn--quiet btn--kucuk" type="button" data-e-sifirla>Tahminleri sıfırla</button></div>
    <dl class="olgular">
     <div><dt>Baz endeks, {ayAdi(e.baz_endeks)}</dt><dd class="num">{ondalik(e.baz_endeks.deger)}</dd></div>
     <div><dt>{e.toplu_sozlesme.ad}, {ayAdi(e.toplu_sozlesme)} zammı</dt><dd class="num">{yuzde(e.toplu_sozlesme.zam)}</dd></div>
     <div><dt>{sonrakiAy} zammı</dt><dd class="num">{yuzde(e.sonraki_zam.zam)}</dd></div>
    </dl>
    <div class="aylar">
     {e.aylar.map((a, i) => (
      <div class:list={['ay-alan', { 'ay-alan--resmi': a.endeks }]}>
       <label for={`ay-${i}`}>{ayAdi(a)}</label>
       <div class="ay-alan__kutu">
        <span aria-hidden="true">%</span>
        <input id={`ay-${i}`} type="text" inputmode="decimal" autocomplete="off" value={a.endeks ? ondalik(a.degisim!) : aylikBeklenti(a.yil,a.ay)===undefined?'':ondalik(aylikBeklenti(a.yil,a.ay)!)} placeholder="0,00"
         readonly={Boolean(a.endeks)} aria-describedby={`ay-${i}-not`} data-e-ay={i}/>
       </div>
       <small id={`ay-${i}-not`}>{a.endeks ? <>{a.endeksHesaplandi?'Resmî oran; oranla hesaplanan yaklaşık endeks':'Resmî, endeks'} <span class="num">{ondalik(a.endeks)}</span></> : <>Tahmin, endeks <span class="num" data-e-endeks={i}>{ondalik(r.aylikEndeksler[i])}</span></>}</small>
      </div>
     ))}
    </div>
    <p class="arac__hata" role="alert" data-e-hata hidden></p>
   </section>

   <section class="panel sonuc" aria-labelledby="sonuc-title" aria-live="polite" data-solid>
    <div class="panel__head"><h2 id="sonuc-title">Sonuç</h2></div>
    <div class="sonuc__ana">
     <p class="sonuc__etiket" data-e-baslik>{r.fark > 0 ? 'Beklenen enflasyon farkı' : 'Enflasyon farkı oluşmuyor'}</p>
     <p class="sonuc__deger num" data-e-deger>{r.fark > 0 ? yuzde(r.fark) : `${yuzde(r.gerekenEnflasyon)} daha`}</p>
     <p class="sonuc__aciklama" data-e-aciklama>{r.fark > 0 ? `Dönem sonunda maaşlara ${yuzde(r.fark)} enflasyon farkı eklenir.` : 'Enflasyon farkı için bu kadar daha aylık enflasyon gerekiyor.'}</p>
    </div>
    <dl class="sonuc__satirlar">
     <div><dt>{sonrakiAy} toplam zam (fark ve {yuzde(e.sonraki_zam.zam)})</dt><dd class="num" data-e="kumulatif">{yuzde(r.kumulatifZam)}</dd></div>
     <div><dt>Aylık oranların toplamı</dt><dd class="num" data-e="toplam">{yuzde(r.aylikToplam)}</dd></div>
     <div><dt>Endeks artışı (SGK ve Bağ-Kur emeklisi zammı beklentisi)</dt><dd class="num" data-e="endeks">{yuzde(r.endeksArtisi)}</dd></div>
     <div><dt>Dönem sonu endeksi</dt><dd class="num" data-e="sonEndeks">{ondalik(r.sonEndeks)}</dd></div>
    </dl>
   </section>
  </div>

  <section class="panel" aria-labelledby="katsayi-title" data-solid>
   <div class="panel__head"><h2 id="katsayi-title">Katsayılar ve bağlı ödemeler</h2><span class="panel__not">{sonrakiAy} beklentisi</span></div>
   <table class="grid grid--sayi">
    <thead><tr><th scope="col">Gösterge</th><th scope="col">Şu an</th><th scope="col">Beklenen</th></tr></thead>
    <tbody>
     <tr><th scope="row">Memur aylık katsayısı</th><td class="num">{katsayi(k.memur_maas_aylik_katsayi)}</td><td class="num" data-e="aylik">{katsayi(r.yeni.aylik)}</td></tr>
     <tr><th scope="row">Taban aylık katsayısı</th><td class="num">{katsayi(k.taban_aylik_katsayi)}</td><td class="num" data-e="taban">{katsayi(r.yeni.taban)}</td></tr>
     <tr><th scope="row">Yan ödeme katsayısı</th><td class="num">{katsayi(k.yan_odeme_katsayi)}</td><td class="num" data-e="yan">{katsayi(r.yeni.yanOdeme)}</td></tr>
     <tr><th scope="row">Bedelli askerlik ({s.bedelli_askerlik_gosterge.toLocaleString('tr-TR')} gösterge)</th><td class="num">{tl(r.mevcut.bedelli)}</td><td class="num" data-e="bedelli">{tl(r.yeni.bedelli)}</td></tr>
     <tr><th scope="row" colspan="3"><a href="https://www.msb.gov.tr/Askeralma/Duyuru/67032f65cc024348b8cf3fea86c95128">MSB: 01/07/2026–31/12/2026 bedelli tutarı 472.653,60 TL</a></th></tr>
     <tr><th scope="row">Muhtar aylığı <span class="grid__not" data-e-muhtar-not hidden={!r.yeni.muhtarAsgaride}>asgari ücrete tamamlanır</span></th><td class="num">{tl(r.mevcut.muhtar)}</td><td class="num" data-e="muhtar">{tl(r.yeni.muhtar)}</td></tr>
     <tr><th scope="row">Seyyanen zam</th><td class="num">{tl(r.mevcut.seyyanen)}</td><td class="num" data-e="seyyanen">{tl(r.yeni.seyyanen)}</td></tr>
     <tr><th scope="row">Asgari ücret</th><td class="num">{tl(k.asgari_ucret)}</td><td class="num">{tl(k.asgari_ucret)}</td></tr>
    </tbody>
   </table>
  </section>

  <section class="panel" data-solid><div class="panel__head"><h2>Hesabın açıklaması</h2></div><div class="prose prose--kisa" data-e-anlatim>{enflasyonAnlatimi(girdi,r,sonrakiAy,resmiSayisi===6).map(p=><p>{p}</p>)}</div></section>
  <section class="panel" data-solid><div class="panel__head"><h2>Enflasyon haberleri ve geçmiş yarıyıllar</h2></div><div class="prose prose--kisa"><p>Ortak aylık veri kaydı güncellendiğinde aylık yazılar ve yarıyıl özeti derlemede otomatik hazırlanır. Tarayıcınızda girdiğiniz tahminler yayımlanmaz. Endeks tabanı: {e.endeksTabani}. Kaynak: {e.kaynak}.</p><ul>{enflasyonDonemleri.map(d=><li><a href={`/${d.aylar[0].yil}-${d.aylar[0].ay===1?'ocak-haziran':'temmuz-aralik'}-enflasyon-ozeti/`}>{d.baslik}</a> · {d.aylar.filter(a=>a.endeks).length}/6 ay</li>)}</ul></div></section>
  <section class="panel" aria-labelledby="nasil-title" data-solid>
   <div class="panel__head"><h2 id="nasil-title">Hesap nasıl yapılıyor?</h2><a href="/enflasyon-nasil-hesaplaniyor/">Ayrıntılı anlatım</a></div>
   <div class="prose prose--kisa">
    <p>Dönemden önceki ayın TÜFE endeksi ({ayAdi(e.baz_endeks)}: {ondalik(e.baz_endeks.deger)}) ile dönem sonu endeksi karşılaştırılır. Artış, dönem başında yapılan {yuzde(e.toplu_sozlesme.zam)} zammı aşarsa aradaki fark enflasyon farkı olarak ödenir. Fark eksiye düşmez; enflasyon zammın altında kalırsa {sonrakiAy} döneminde yalnızca {yuzde(e.sonraki_zam.zam)} zam uygulanır.</p>
    <p>Bedelli askerlik ücreti, muhtar aylığı ve seyyanen zam, sabit göstergenin memur aylık katsayısıyla çarpımıdır; katsayı arttığında onlar da aynı oranda artar. Sonuçlar bilgilendirme amaçlıdır.</p>
   </div>
  </section>
 </div>
 <script type="application/json" id="enflasyon-veri" set:html={JSON.stringify(istemci)}/>
</Layout>
<script>import '../../scripts/enflasyon';</script>

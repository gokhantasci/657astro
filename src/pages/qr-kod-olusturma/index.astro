---
import Layout from '../../layouts/Layout.astro';
import { ayarlar } from '../../lib/settings';

const site = ayarlar.site.url;
const path = '/qr-kod-olusturma/';
const title = 'QR Kod Oluşturucu (URL, Wi-Fi, vCard · PNG & SVG) | 657.com.tr';
const description = 'ISO/IEC 18004 standardında ücretsiz, tarayıcıda çalışan QR kod oluşturucu. URL, metin, Wi-Fi, vCard kişi kartı, e-posta ve telefon için yüksek çözünürlüklü PNG ve vektörel SVG indirin.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '657.com.tr QR Kod Oluşturucu',
    description,
    url: new URL(path, site).href,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Tarayıcı',
    inLanguage: 'tr-TR',
    isAccessibleForFree: true,
  },
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <header class="portal-sayfa-basligi">
    <div class="container">
      <nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span>/</span><a href="/araclar/">Araçlar</a><span>/</span><span>QR Kod Oluşturucu</span></nav>
      <div class="dir__head">
        <h1>QR Kod Oluşturucu</h1>
        <p>URL, metin, Wi-Fi, vCard kişi kartı, e-posta veya telefon için ISO/IEC 18004 standardında QR kod üretin. Tüm işlem tarayıcınızda yapılır; verileriniz sunucuya gönderilmez.</p>
      </div>
    </div>
  </header>

  <div class="container page qr-grid" data-qr-app>
    <section class="panel qr-form" data-solid>
      <div class="panel__head"><h2>QR Kod İçeriği ve Ayarlar</h2></div>
      <div class="qr-ic">
        <div class="qr-alan">
          <label for="qr-tur">İçerik Türü</label>
          <select id="qr-tur" data-qr-tur>
            <option value="url">Web Adresi (URL)</option>
            <option value="metin">Serbest Metin</option>
            <option value="wifi">Wi-Fi Ağı</option>
            <option value="vcard">Kişi Kartı (vCard)</option>
            <option value="eposta">E-posta</option>
            <option value="tel">Telefon Numarası</option>
          </select>
        </div>

        <div class="qr-alan" data-qr-alan="url">
          <label for="qr-url">Web Adresi (URL)</label>
          <input id="qr-url" type="url" data-qr-in="url" value="https://657.com.tr/" placeholder="https://..." />
        </div>

        <div class="qr-alan" data-qr-alan="metin" hidden>
          <label for="qr-metin">Metin</label>
          <textarea id="qr-metin" rows="4" data-qr-in="metin" placeholder="QR koda dönüştürülecek metni yazın..."></textarea>
        </div>

        <div class="qr-grup" data-qr-alan="wifi" hidden>
          <div class="qr-alan"><label for="qr-ssid">Ağ Adı (SSID)</label><input id="qr-ssid" type="text" data-qr-in="wifi-ssid" placeholder="Wi-Fi adı" /></div>
          <div class="qr-alan"><label for="qr-pass">Şifre</label><input id="qr-pass" type="text" data-qr-in="wifi-pass" placeholder="Ağ şifresi" /></div>
          <div class="qr-alan"><label for="qr-enc">Şifreleme</label><select id="qr-enc" data-qr-in="wifi-enc"><option value="WPA">WPA / WPA2 / WPA3</option><option value="WEP">WEP</option><option value="nopass">Şifresiz</option></select></div>
        </div>

        <div class="qr-grup" data-qr-alan="vcard" hidden>
          <div class="qr-alan"><label for="qr-vc-ad">Ad Soyad</label><input id="qr-vc-ad" type="text" data-qr-in="vc-ad" placeholder="Ad Soyad" /></div>
          <div class="qr-alan"><label for="qr-vc-org">Kurum / Unvan</label><input id="qr-vc-org" type="text" data-qr-in="vc-org" placeholder="Kurum adı" /></div>
          <div class="qr-alan"><label for="qr-vc-tel">Telefon</label><input id="qr-vc-tel" type="tel" data-qr-in="vc-tel" placeholder="+90 5xx xxx xx xx" /></div>
          <div class="qr-alan"><label for="qr-vc-mail">E-posta</label><input id="qr-vc-mail" type="email" data-qr-in="vc-mail" placeholder="ornek@657.com.tr" /></div>
        </div>

        <div class="qr-grup" data-qr-alan="eposta" hidden>
          <div class="qr-alan"><label for="qr-mto">Alıcı E-posta</label><input id="qr-mto" type="email" data-qr-in="mail-to" placeholder="ornek@657.com.tr" /></div>
          <div class="qr-alan"><label for="qr-msub">Konu</label><input id="qr-msub" type="text" data-qr-in="mail-sub" placeholder="E-posta konusu" /></div>
        </div>

        <div class="qr-alan" data-qr-alan="tel" hidden>
          <label for="qr-tel">Telefon Numarası</label>
          <input id="qr-tel" type="tel" data-qr-in="tel-no" placeholder="+90 5xx xxx xx xx" />
        </div>

        <div class="qr-ayar-grid">
          <div class="qr-alan">
            <label for="qr-ec">Hata Düzeltme (ECC)</label>
            <select id="qr-ec" data-qr-ec>
              <option value="L">L (%7 – En kompakt)</option>
              <option value="M" selected>M (%15 – Standart)</option>
              <option value="Q">Q (%25 – Yüksek)</option>
              <option value="H">H (%30 – En dayanıklı)</option>
            </select>
          </div>
          <div class="qr-alan">
            <label for="qr-scale">Boyut (Ölçek)</label>
            <input id="qr-scale" type="range" min="3" max="10" value="6" data-qr-scale />
          </div>
          <div class="qr-alan">
            <label for="qr-renk">Ön Plan Rengi</label>
            <input id="qr-renk" type="color" value="#132036" data-qr-renk />
          </div>
          <div class="qr-alan">
            <label for="qr-bg">Arka Plan Rengi</label>
            <input id="qr-bg" type="color" value="#ffffff" data-qr-bg />
          </div>
        </div>
      </div>
    </section>

    <aside class="panel qr-onizleme" data-solid>
      <div class="panel__head"><h2>Önizleme ve İndirme</h2></div>
      <div class="qr-onizleme__ic">
        <canvas data-qr-canvas aria-label="Oluşturulan QR kod"></canvas>
        <p class="qr-durum" data-qr-durum role="status"></p>
        <div class="qr-butonlar">
          <button type="button" class="btn" data-qr-png>PNG İndir</button>
          <button type="button" class="btn btn--quiet" data-qr-svg>SVG (Vektörel) İndir</button>
        </div>
      </div>
    </aside>
  </div>

  <script>import '../../scripts/qr-kod';</script>
</Layout>

<style>
.qr-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,0.85fr);gap:var(--space-lg);align-items:start;}
.qr-ic,.qr-onizleme__ic{padding:var(--space-lg);display:grid;gap:var(--space-md);}
.qr-alan,.qr-grup{display:grid;gap:var(--space-2xs);}
.qr-grup{gap:var(--space-sm);}
.qr-alan label{font-size:var(--text-xs);font-weight:600;color:var(--color-muted);}
.qr-alan input[type="color"]{width:100%;height:44px;padding:4px;border:1px solid var(--color-rule);border-radius:var(--radius-pill);background:var(--color-paper-2);}
.qr-ayar-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-md);padding-top:var(--space-sm);border-top:1px solid var(--color-rule);}
@media(max-width:420px){.qr-ayar-grid{grid-template-columns:minmax(0,1fr);}}
.qr-onizleme__ic{justify-items:center;text-align:center;}
.qr-onizleme canvas{max-width:100%;height:auto;border:1px solid var(--color-rule);border-radius:var(--radius-pill);background:#fff;}
.qr-durum{margin:0;font-size:var(--text-xs);color:var(--color-muted);}
.qr-butonlar{display:flex;gap:var(--space-sm);flex-wrap:wrap;justify-content:center;width:100%;}
@media(max-width:900px){.qr-grid{grid-template-columns:minmax(0,1fr);}}
</style>

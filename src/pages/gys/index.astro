---
import Layout from '../../layouts/Layout.astro';
import mufredat from '../../data/gys-mufredat.json';
import agac from '../../data/gys-agac.json';
import sorularTemel from '../../data/gys-sorular.json';
import sorularIcra from '../../data/gys-sorular-icra.json';
import sorularGenelge from '../../data/gys-sorular-genelgeler.json';
import { ayarlar } from '../../lib/settings';

const tumSorular = [...sorularTemel, ...sorularIcra, ...sorularGenelge];
const site = ayarlar.site.url;
const path = '/gys/';
const title = 'Adalet Bakanlığı, CTE & İcra MY Görevde Yükselme Sınavı (GYS 2026) | gys.657.com.tr';
const description = 'Adalet Bakanlığı (PGM), CTE Görevde Yükselme, Ünvan Değişikliği ve ÖSYM İcra Müdür Yardımcılığı ücretsiz sınav platformu. Sınırsız kategori ağacı, sonsuz rastgele test, soru bazlı genel/kişisel başarı oranı ve 2 sütunlu renkli kitapçık.';

const gysHaberler = [
  { baslik: 'Adalet Bakanlığı Görevde Yükselme Sınav Süreçleri (2015–2026 Takvim)', url: '/adalet-bakanligi-gorevde-yukselme-sinav-surecleri-2015-2026-yillara-gore-takvim/', etiket: 'PGM Takvim' },
  { baslik: 'Yazı İşleri Müdürü Görevde Yükselme Sınav Şartları Nelerdir?', url: '/adalet-bakanligi-yazi-isleri-muduru-gorevde-yukselme-sinav-sartlari-nelerdir/', etiket: 'Yazı İşleri' },
  { baslik: 'İdari İşler Müdürü Görevde Yükselme Sınav Şartları Nelerdir?', url: '/adalet-bakanligi-idari-isler-muduru-gorevde-yukselme-sinav-sartlari-nelerdir/', etiket: 'İdari İşler' },
  { baslik: 'Adalet Bakanlığı Şef Görevde Yükselme Sınav Şartları Nelerdir?', url: '/adalet-bakanligi-sef-gorevde-yukselme-sinav-sartlari-nelerdir/', etiket: 'Şef' },
  { baslik: 'CTE Kurum İkinci Müdürü, İdare Memuru ve İKBM GYS Şartları', url: '/cte-kurum-ikinci-muduru-idare-memuru-infaz-koruma-basmemuru-gys-sartlari-nelerdir/', etiket: 'CTE GYS' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '657.com.tr GYS & İcra MY Sınav Platformu',
    url: new URL(path, site).href,
    description,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Tarayıcı',
    inLanguage: 'tr-TR',
    isAccessibleForFree: true,
  },
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <header class="portal-sayfa-basligi">
    <div class="container">
      <nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span>/</span><a href="/araclar/">Araçlar</a><span>/</span><span>GYS Sınav Platformu</span></nav>
      <div class="dir__head">
        <h1>Adalet Bakanlığı, CTE &amp; İcra MY Görevde Yükselme Sınavı (GYS 2026)</h1>
        <p>Sınırsız hiyerarşik kategori ağacı, <strong>Sonsuz Rastgele Test</strong>, <strong>Karışık Çöz</strong>, soru bazlı genel &amp; kişisel doğru bilme oranı, <strong>5 şıklı / 2 şıklı</strong> kombinatoryal sınav motoru ve <strong>2 sütunlu renkli kitap baskısı test kitapçığı</strong> — tamamen ücretsiz.</p>
      </div>
    </div>
  </header>

  <div class="container page gys-sayfa" data-gys-app>
    <script id="gys-mufredat-veri" type="application/json" set:html={JSON.stringify(mufredat)}></script>
    <script id="gys-agac-veri" type="application/json" set:html={JSON.stringify(agac)}></script>
    <script id="gys-sorular-veri" type="application/json" set:html={JSON.stringify(tumSorular)}></script>

    <!-- Ünvan ve Kişisel İstatistik Çubuğu -->
    <section class="panel gys-ust" data-solid aria-label="Ünvan seçimi ve kişisel özet">
      <div class="gys-ust__satir">
        <label class="gys-unvan-sec">
          <span>Hedef Ünvanınız (Otomatik Hatırlanır)</span>
          <select data-gys-unvan>
            {mufredat.unvanlar.map((u) => (
              <option value={u.id}>{u.ad} ({u.toplamSoru} soru · {u.sureDk} dk)</option>
            ))}
          </select>
        </label>
        <div class="gys-ozet-kartlar">
          <div><span>Aktif Havuz</span><strong class="num" data-gys-havuz-sayi>{tumSorular.length}</strong></div>
          <div><span>Çözülen</span><strong class="num" data-gys-st-toplam>0</strong></div>
          <div><span>Başarı</span><strong class="num" data-gys-st-oran>%0</strong></div>
          <div><span>Bekleyen Hata</span><strong class="num" data-gys-st-hata>0</strong></div>
        </div>
      </div>
      <p class="gys-son-ders" data-gys-son-ders></p>
    </section>

    <!-- 5 Ana Sekme -->
    <div class="gys-tabs" role="tablist" aria-label="GYS modülleri">
      <button type="button" class="btn btn--kucuk" role="tab" data-gys-tab="sinav" aria-selected="true">Sınav &amp; Sonsuz Test</button>
      <button type="button" class="btn btn--quiet btn--kucuk" role="tab" data-gys-tab="hatalar" aria-selected="false">Hatalı Sorular &amp; Tekrar</button>
      <button type="button" class="btn btn--quiet btn--kucuk" role="tab" data-gys-tab="kitapcik" aria-selected="false">Konu Kitapçıkları</button>
      <button type="button" class="btn btn--quiet btn--kucuk" role="tab" data-gys-tab="pdf" aria-selected="false">Kitap Baskısı Test Kitapçığı</button>
      <button type="button" class="btn btn--quiet btn--kucuk" role="tab" data-gys-tab="takvim" aria-selected="false">GYS Takvim &amp; Haberler</button>
    </div>

    <!-- 1. SINAV UYGULAMASI: SOL KATEGORİ AĞACI + SAĞ SINAV SAHNESİ -->
    <div class="gys-calisma" data-gys-panel="sinav">
      <aside class="panel gys-agac-panel" data-solid aria-label="Sınav ve mevzuat kategori ağacı">
        <div class="panel__head">
          <h2>Soru Havuzu Ağacı</h2>
          <span class="num gys-toplam-rozet" data-gys-toplam-havuz>{tumSorular.length} soru</span>
        </div>
        <div class="gys-agac-ic" data-gys-agac></div>
      </aside>

      <section class="panel gys-ana-panel" data-solid>
        <div class="panel__head">
          <div>
            <h2 data-gys-dugum-baslik>İnteraktif GYS Sınav Ekranı</h2>
            <p class="gys-yol" data-gys-dugum-yol>Adalet Bakanlığı</p>
          </div>
          <div class="gys-ust-etiketler">
            <span class="gys-mod-etiket" data-gys-aktif-mod>Klasik Mod (5 Şık)</span>
            <span class="gys-kronometre num" data-gys-sure hidden>00:00</span>
            <span class="gys-seri num" data-gys-seri hidden>Seri: 0</span>
          </div>
        </div>
        <div class="gys-ic">
          <div class="gys-filtreler">
            <label>
              <span>Ders / Mevzuat</span>
              <select data-gys-kanun></select>
            </label>
            <label>
              <span>Zorluk Seviyesi</span>
              <select data-gys-seviye>
                <option value="">Tüm Seviyeler</option>
                <option value="kolay">Kolay (Temel Ezber)</option>
                <option value="orta">Orta (Sınav Standardı)</option>
                <option value="zor">Zor (Tuzak &amp; İstisna)</option>
                <option value="akademik">Akademik (Yüksek Detay)</option>
                <option value="dip">En Dip (Madde İncelikleri)</option>
              </select>
            </label>
            <label>
              <span>Şık Modu</span>
              <select data-gys-mod>
                <option value="klasik">Klasik (1 Doğru · 4 Yanlış)</option>
                <option value="ikili">Hızlı Tekrar (1 Doğru · 1 Yanlış)</option>
              </select>
            </label>
            <label>
              <span>Soru Sayısı</span>
              <select data-gys-adet>
                <option value="10">10 Soru</option>
                <option value="20" selected>20 Soru</option>
                <option value="40">40 Soru</option>
                <option value="100">Tüm Havuz</option>
              </select>
            </label>
          </div>

          <div class="gys-eylem-bar">
            <button type="button" class="btn" data-gys-baslat>Testi Başlat</button>
            <button type="button" class="btn btn--quiet" data-gys-karisik>Karışık Çöz</button>
            <button type="button" class="btn btn--quiet" data-gys-sonsuz>∞ Sonsuz Test (Rastgele)</button>
            <button type="button" class="btn btn--quiet" data-gys-deneme>Kronometreli Deneme</button>
          </div>

          <div class="gys-sahne" data-gys-sahne hidden>
            <div class="gys-soru-ust">
              <span class="num" data-gys-sira>Soru 1 / 20</span>
              <span class="gys-rozet" data-gys-rozet></span>
              <span class="gys-varyasyon" data-gys-varyasyon></span>
            </div>
            <div class="gys-soru-istatistik" data-gys-soru-istatistik></div>
            <p class="gys-soru-metin" data-gys-soru-metin></p>
            <div class="gys-siklar" data-gys-siklar></div>
            <div class="gys-aciklama" data-gys-aciklama hidden></div>
            <div class="gys-soru-alt">
              <button type="button" class="btn btn--kucuk" data-gys-sonraki hidden>Sonraki Soru →</button>
              <button type="button" class="btn btn--quiet btn--kucuk" data-gys-bitir>Testi Bitir</button>
            </div>
          </div>

          <div class="gys-sonuc" data-gys-sonuc hidden></div>
        </div>
      </section>
    </div>

    <!-- 2. HATALI SORULAR & DÖNEMSEL TEKRAR -->
    <section class="panel" data-gys-panel="hatalar" data-solid hidden>
      <div class="panel__head">
        <h2>Hatalı Sorular ve Zorunlu Öğrenme Tekrarı</h2>
        <button type="button" class="btn btn--quiet btn--kucuk" data-gys-istatistik-sifirla>İstatistikleri Sıfırla</button>
      </div>
      <div class="gys-ic">
        <div class="gys-hata-bar" role="group" aria-label="Hata dönemi">
          <button type="button" class="btn btn--kucuk" data-gys-hata-filtre="tumu" aria-pressed="true">Tüm Hatalılar</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-gys-hata-filtre="gunluk" aria-pressed="false">Bugün</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-gys-hata-filtre="haftalik" aria-pressed="false">Bu Hafta</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-gys-hata-filtre="aylik" aria-pressed="false">Bu Ay</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-gys-hata-filtre="encok" aria-pressed="false">En Çok Hatalı</button>
          <button type="button" class="btn btn--kucuk" data-gys-hata-coz style="margin-left:auto;">Seçili Hataları Tam Öğrenene Kadar Çöz →</button>
        </div>
        <div data-gys-hata-liste></div>
      </div>
    </section>

    <!-- 3. KONU ÇALIŞMA KİTAPÇIKLARI -->
    <section class="panel" data-gys-panel="kitapcik" data-solid hidden>
      <div class="panel__head"><h2>2026 GYS Konu Çalışma Kitapçıkları</h2></div>
      <div class="gys-ic">
        {mufredat.kitapciklar.map((k) => (
          <article class="gys-ders-kitap">
            <div class="gys-ders-kitap__ust">
              <div>
                <h3>{k.baslik}</h3>
                <p>{k.altBaslik}</p>
              </div>
              <button type="button" class="btn btn--kucuk" data-gys-kitap-coz={k.kanun}>Bu Konudan Soru Çöz →</button>
            </div>
            <div class="gys-ders-maddeler">
              {k.maddeler.map((m) => (
                <details open>
                  <summary>{m.baslik}</summary>
                  <p>{m.ozet}</p>
                </details>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 4. KİTAP BASKISI RENKLİ TEST KİTAPÇIĞI OLUŞTURUCU -->
    <section class="panel" data-gys-panel="pdf" data-solid hidden>
      <div class="panel__head"><h2>Kitap Baskısı Test Kitapçığı Oluştur &amp; İndir (gys.657.com.tr)</h2></div>
      <div class="gys-ic">
        <div class="gys-filtreler">
          <label>
            <span>Kitapçık Tipi</span>
            <select data-gys-pdf-tip>
              <option value="agirlikli">2026 Resmî Sınav Ağırlıklarına Göre Karma</option>
              <option value="ozel">Seçili Ders / Ağaç Düğümünden Özel</option>
            </select>
          </label>
          <label>
            <span>Ders / Mevzuat</span>
            <select data-gys-pdf-kanun></select>
          </label>
          <label>
            <span>Soru Adedi</span>
            <input type="number" min="5" max="100" value="20" data-gys-pdf-adet />
          </label>
          <label>
            <span>Şık Modu</span>
            <select data-gys-pdf-mod>
              <option value="klasik">Klasik (5 Şıklı — A–E)</option>
              <option value="ikili">Hızlı Tekrar (2 Şıklı — A–B)</option>
            </select>
          </label>
          <button type="button" class="btn" data-gys-pdf-uret>Renkli Kitapçık Oluştur</button>
        </div>
        <div class="gys-pdf-eylem" data-gys-pdf-eylem hidden>
          <button type="button" class="btn btn--kucuk" data-gys-pdf-yazdir>Kitap Baskısı Yazdır / PDF Kaydet</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-gys-pdf-indir>HTML Kitapçık İndir</button>
        </div>
        <div class="gys-pdf-onizleme" data-gys-pdf-onizleme></div>
      </div>
    </section>

    <!-- 5. GEÇMİŞ GYS HABERLERİ VE TAKVİMLER -->
    <section class="panel" data-gys-panel="takvim" data-solid hidden>
      <div class="panel__head"><h2>Geçmiş GYS Haberleri ve Yıllara Göre Sınav Takvimleri</h2></div>
      <div class="gys-ic">
        <div class="gys-haber-grid">
          {gysHaberler.map((h) => (
            <a class="gys-haber-kart" href={h.url}>
              <span class="gys-rozet">{h.etiket}</span>
              <strong>{h.baslik}</strong>
              <span>Haberi ve şartları incele →</span>
            </a>
          ))}
        </div>
        <h3 style="margin:var(--space-lg) 0 var(--space-sm);font-size:var(--text-base);">Adalet Bakanlığı PGM, CTE ve ÖSYM İcra MY Özet Takvimi (2015–2026)</h3>
        <div class="gys-tablo-sar">
          <table class="gys-takvim-tablo">
            <thead>
              <tr><th>Sınav</th><th>Dönem</th><th>Soru / Süre</th><th>Baraj</th><th>Kurum</th></tr>
            </thead>
            <tbody>
              <tr><td>PGM Görevde Yükselme (Yazı İşleri, İdari İşler, Şef)</td><td>2015 · 2018 · 2021 · 2023 · 2025–2026</td><td>80–100 Soru / 90–110 Dk</td><td>60 Puan</td><td>ANKÜSEM / MEB</td></tr>
              <tr><td>CTE Görevde Yükselme (Kurum 2. Md., İdare Memuru, İKBM)</td><td>2016 · 2019 · 2022 · 2025–2026</td><td>80–100 Soru / 90–110 Dk</td><td>60 Puan</td><td>ANKÜSEM / MEB</td></tr>
              <tr><td>İcra Müdür ve İcra Müdür Yardımcılığı</td><td>2020 · 2022 · 2024 (7 Ara) · 2026 (5 Ara)</td><td>80 Soru (35 GY-GK + 45 Alan) / 105 Dk</td><td>70 Puan</td><td>ÖSYM</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</Layout>
<script>import '../../scripts/gys';</script>
<style>
  .gys-sayfa{display:grid;gap:var(--space-md);}
  .gys-ust{padding:var(--space-md) var(--space-lg);}
  .gys-ust__satir{display:flex;flex-wrap:wrap;gap:var(--space-md);align-items:flex-end;justify-content:space-between;}
  .gys-unvan-sec{display:grid;gap:4px;min-width:260px;flex:1 1 300px;}
  .gys-unvan-sec span{font-size:var(--text-xs);font-weight:700;color:var(--color-muted);text-transform:uppercase;letter-spacing:.03em;}
  .gys-unvan-sec select,.gys-filtreler select,.gys-filtreler input{min-height:40px;padding:6px 10px;border:1px solid var(--color-rule-2);border-radius:var(--radius-sm);background:var(--color-paper-2);color:var(--color-ink);font:inherit;font-size:var(--text-sm);}
  .gys-ozet-kartlar{display:flex;flex-wrap:wrap;gap:var(--space-sm);}
  .gys-ozet-kartlar>div{padding:6px 12px;border:1px solid var(--color-rule);border-radius:var(--radius-sm);background:var(--color-paper);min-width:86px;text-align:center;}
  .gys-ozet-kartlar span{display:block;font-size:11px;color:var(--color-muted);}
  .gys-ozet-kartlar strong{font-size:var(--text-base);color:var(--color-ink);}
  .gys-son-ders{margin:var(--space-sm) 0 0;font-size:var(--text-xs);color:var(--color-muted);}
  .gys-tabs{display:flex;flex-wrap:wrap;gap:var(--space-2xs);}
  .gys-tabs [aria-selected="true"]{background:var(--color-ink);border-color:var(--color-ink);color:var(--color-paper-2);}

  .gys-calisma{display:grid;grid-template-columns:320px minmax(0,1fr);gap:var(--space-md);align-items:start;}
  .gys-agac-panel{position:sticky;top:16px;max-height:calc(100vh - 32px);overflow:auto;}
  .gys-toplam-rozet{font-size:12px;font-weight:700;color:var(--color-accent-text);background:var(--color-accent-soft);padding:2px 8px;border-radius:999px;}
  .gys-agac-ic{padding:var(--space-sm);}
  .gys-agac-ic :global(details){margin:2px 0;}
  .gys-agac-ic :global(summary){list-style:none;cursor:pointer;display:flex;align-items:center;gap:6px;padding:6px 8px;border-radius:var(--radius-sm);font-size:13px;line-height:1.35;}
  .gys-agac-ic :global(summary::-webkit-details-marker){display:none;}
  .gys-agac-ic :global(.gys-dugum-btn){display:flex;align-items:center;justify-content:space-between;gap:6px;width:100%;text-align:left;background:transparent;border:1px solid transparent;border-radius:var(--radius-sm);padding:6px 8px;font:inherit;font-size:13px;color:var(--color-ink);cursor:pointer;}
  .gys-agac-ic :global(.gys-dugum-btn:hover){background:var(--color-paper);}
  .gys-agac-ic :global(.gys-dugum-btn[aria-current="true"]){background:var(--color-accent-soft);border-color:var(--color-accent);color:var(--color-accent-text);font-weight:700;}
  .gys-agac-ic :global(.gys-dugum-sayi){font-size:11px;font-weight:700;color:var(--color-muted);white-space:nowrap;font-variant-numeric:tabular-nums;}
  .gys-agac-ic :global(.gys-agac-cocuk){padding-left:14px;border-left:1px dashed var(--color-rule);margin-left:8px;}

  .gys-yol{margin:2px 0 0;font-size:12px;color:var(--color-muted);}
  .gys-ust-etiketler{display:flex;flex-wrap:wrap;gap:6px;align-items:center;}
  .gys-ic{padding:var(--space-lg);}
  .gys-filtreler{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:var(--space-sm);align-items:end;margin-bottom:var(--space-sm);}
  .gys-filtreler label{display:grid;gap:4px;}
  .gys-filtreler label span{font-size:var(--text-xs);font-weight:600;color:var(--color-muted);}
  .gys-eylem-bar{display:flex;flex-wrap:wrap;gap:var(--space-xs);margin-bottom:var(--space-md);}
  .gys-mod-etiket,.gys-kronometre,.gys-seri{font-size:var(--text-xs);font-weight:700;padding:3px 9px;border-radius:999px;background:var(--color-accent-soft);color:var(--color-accent-text);}
  .gys-kronometre{background:#fef3c7;color:#92400e;}
  .gys-seri{background:#dcfce7;color:#166534;}

  .gys-sahne{border:1px solid var(--color-rule);border-radius:var(--radius-md);padding:var(--space-lg);background:var(--color-paper);}
  .gys-soru-ust{display:flex;flex-wrap:wrap;gap:var(--space-sm);align-items:center;justify-content:space-between;margin-bottom:var(--space-xs);font-size:var(--text-xs);color:var(--color-muted);}
  .gys-soru-istatistik{display:flex;flex-wrap:wrap;gap:var(--space-sm);margin-bottom:var(--space-sm);font-size:12px;color:var(--color-muted);}
  .gys-soru-istatistik :global(.gys-ist-pill){padding:3px 8px;border-radius:999px;border:1px solid var(--color-rule);background:var(--color-paper-2);font-variant-numeric:tabular-nums;}
  .gys-rozet{display:inline-block;padding:2px 8px;border-radius:999px;background:var(--color-paper-2);border:1px solid var(--color-rule);font-weight:700;font-size:11px;color:var(--color-ink-2);}
  .gys-varyasyon{font-size:11px;color:var(--color-muted);}
  .gys-soru-metin{font-size:var(--text-base);font-weight:600;line-height:1.65;color:var(--color-ink);margin:0 0 var(--space-md);}
  .gys-siklar{display:grid;gap:var(--space-xs);}
  .gys-siklar :global(.gys-sik){display:flex;gap:10px;align-items:flex-start;text-align:left;width:100%;padding:12px 14px;border:1px solid var(--color-rule-2);border-radius:var(--radius-sm);background:var(--color-paper-2);color:var(--color-ink);font:inherit;font-size:var(--text-sm);line-height:1.5;cursor:pointer;}

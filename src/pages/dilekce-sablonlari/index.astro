---
import Layout from '../../layouts/Layout.astro';
import { dilekceSablonlari, dilekceAlanlari, udfEditordeAc, sablonDetayYolu } from '../../lib/dilekce-sablonlari';

const path = '/dilekce-sablonlari/';
const title = `Dilekçe Şablonları Kütüphanesi (${dilekceSablonlari.length} Hazır UDF Şablon) | 657.com.tr`;
const description =
  'En çok aranan hukuk, ceza, aile, miras, icra ve kira dilekçe örnekleri. Tek tıkla udf.657.com.tr editörde düzenleyin, UDF/Word/PDF olarak indirin.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Dilekçe Şablonları Kütüphanesi',
    url: new URL(path, Astro.site).href,
    description,
    inLanguage: 'tr-TR',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: dilekceSablonlari.length,
      itemListElement: dilekceSablonlari.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: s.baslik,
        url: new URL(sablonDetayYolu(s), Astro.site).href,
      })),
    },
  },
];
---
<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <header class="portal-sayfa-basligi">
    <div class="container">
      <nav class="crumbs" aria-label="Konum">
        <a href="/">Anasayfa</a><span aria-hidden="true">/</span>
        <a href="/araclar/#hukuk">Hukuk mahkemeleri</a><span aria-hidden="true">/</span>
        <span aria-current="page">Dilekçe şablonları</span>
      </nav>
      <div class="portal-sayfa-basligi__satir">
        <div class="dir__head">
          <h1>Dilekçe Şablonları Kütüphanesi</h1>
          <p>En çok aranan <strong>{dilekceSablonlari.length}</strong> kapsamlı hukuk, ceza, aile, miras, icra ve kira dilekçesi. Tek tıkla <strong>udf.657.com.tr</strong> üzerinde açıp düzenleyin.</p>
        </div>
        <div class="portal-sayfa-basligi__eylem">
          <a class="btn btn--kucuk" href="https://udf.657.com.tr/" target="_blank" rel="noopener">UDF Web Editörü Aç ↗</a>
        </div>
      </div>
    </div>
  </header>

  <div class="container page" data-ds-root>
    <div class="panel ds-filtre" data-solid>
      <input id="ds-ara" type="search" class="ds-ara" placeholder="Dilekçe ara (Örn: boşanma protokolü, veraset, icra itiraz, kira tespit, suç duyurusu...)" autocomplete="off" />
      <div class="ds-alanlar" role="group" aria-label="Hukuk alanı">
        <button type="button" class="btn btn--kucuk is-aktif" data-ds-alan="">Tümü ({dilekceSablonlari.length})</button>
        {dilekceAlanlari.map((alan) => (
          <button type="button" class="btn btn--quiet btn--kucuk" data-ds-alan={alan}>
            {alan} ({dilekceSablonlari.filter((s) => s.alan === alan).length})
          </button>
        ))}
      </div>
    </div>

    <div class="ds-grid" data-ds-liste>
      {dilekceSablonlari.map((s) => (
        <article
          class="panel ds-kart"
          data-solid
          data-ds-kart
          data-alan={s.alan}
          data-arama={`${s.baslik} ${s.kisaAd} ${s.alan} ${s.mahkeme} ${s.dayanak.join(' ')} ${s.ozet ?? ''}`.toLocaleLowerCase('tr-TR')}
        >
          <div class="ds-kart__ust">
            <span class="chip">{s.alan}</span>
            <span class="ds-mahkeme">{s.mahkeme}</span>
          </div>
          <h2><a href={sablonDetayYolu(s)}>{s.baslik}</a></h2>
          {s.ozet && <p class="ds-ozet">{s.ozet}</p>}
          <div class="ds-dayanak">
            {s.dayanak.map((d) => <span class="chip">{d}</span>)}
          </div>
          <div class="ds-eylemler">
            <a class="btn btn--kucuk" href={udfEditordeAc(s.id)} target="_blank" rel="noopener">UDF’de doldur ↗</a>
            <a class="btn btn--quiet btn--kucuk" href={sablonDetayYolu(s)}>Rehber & Önizle</a>
            <a class="btn btn--quiet btn--kucuk" href={`/veri/sablonlar/${s.id}.docx`} download>Word indir</a>
            <a class="btn btn--quiet btn--kucuk" href={`/veri/sablonlar/${s.id}.udf`} download>UDF indir</a>
          </div>
        </article>
      ))}
    </div>

    <p class="ds-uyari">
      <strong>Hukuki Uyarı:</strong> Şablonlar genel bilgilendirme ve taslak hazırlama amaçlıdır. Her somut olayın görevli/yetkili mahkemesi, hak düşürücü süreleri ve ispat koşulları farklılık gösterebileceğinden dilekçelerinizi avukatınıza danışarak uyarlamanız önerilir.
    </p>
  </div>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('[data-ds-root]');
  if (root) {
    const ara = root.querySelector<HTMLInputElement>('#ds-ara')!;
    const butonlar = [...root.querySelectorAll<HTMLButtonElement>('[data-ds-alan]')];
    const kartlar = [...root.querySelectorAll<HTMLElement>('[data-ds-kart]')];
    let aktifAlan = '';

    const uygula = () => {
      const q = ara.value.trim().toLocaleLowerCase('tr-TR');
      for (const k of kartlar) {
        const alanOk = !aktifAlan || k.dataset.alan === aktifAlan;
        const araOk = !q || (k.dataset.arama ?? '').includes(q);
        k.hidden = !(alanOk && araOk);
      }
    };

    ara.addEventListener('input', uygula);
    butonlar.forEach((b) => {
      b.addEventListener('click', () => {
        aktifAlan = b.dataset.dsAlan ?? '';
        butonlar.forEach((x) => {
          const aktif = x === b;
          x.classList.toggle('is-aktif', aktif);
          x.classList.toggle('btn--quiet', !aktif);
        });
        uygula();
      });
    });
  }
</script>

<style>
  .ds-filtre { padding: var(--space-md) var(--space-lg); display: grid; gap: var(--space-sm); margin-bottom: var(--space-lg); }
  .ds-ara { width: 100%; min-height: 44px; padding: 8px 14px; border: 1px solid var(--color-rule); border-radius: var(--radius-sm); background: var(--color-paper-2); color: var(--color-ink); font: inherit; }
  .ds-alanlar { display: flex; flex-wrap: wrap; gap: 6px; }
  .ds-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); }
  .ds-kart { padding: var(--space-md) var(--space-lg); display: grid; gap: 10px; align-content: space-between; }
  .ds-kart[hidden] { display: none; }
  .ds-kart__ust { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .ds-mahkeme { font-size: var(--text-xs); color: var(--color-muted); font-weight: 600; }
  .ds-kart h2 { margin: 0; font-size: var(--text-lead); line-height: 1.35; }
  .ds-kart h2 a { text-decoration: none; color: var(--color-ink); }
  .ds-kart h2 a:hover { color: var(--color-accent-text); }
  .ds-ozet { margin: 0; font-size: var(--text-sm); color: var(--color-muted); line-height: 1.55; }
  .ds-dayanak { display: flex; flex-wrap: wrap; gap: 6px; }
  .ds-eylemler { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 6px; border-top: 1px solid var(--color-rule); }
  .ds-uyari { margin-top: var(--space-lg); padding: var(--space-md); border-radius: var(--radius-sm); background: var(--color-paper-3); font-size: var(--text-xs); color: var(--color-muted); line-height: 1.6; }
  @media (max-width: 820px) { .ds-grid { grid-template-columns: minmax(0, 1fr); } }
</style>

---
import Layout from '../../layouts/Layout.astro';
import { ayarlar } from '../../lib/settings';
import { ucretler, yururlukte, tebligat } from '../../lib/tebligat-veri';
import { TABLOLAR, GIDER_KALEMLERI, type Tablo, type UcretSatiri } from '../../lib/yargilama-gideri';
import { tl, gun } from '../../lib/bicim';

const site = ayarlar.site.url;
const SEKME: Record<Tablo, { ad: string; birim: string }> = {
  posta: { ad: 'Tebligat', birim: 'tebligat' },
  etebligat: { ad: 'E-Tebligat', birim: 'e-tebligat' },
  eyazisma: { ad: 'E-Yazışma', birim: 'e-yazışma' },
  kep: { ad: 'KEP', birim: 'KEP iletisi' },
  kesifharci: { ad: 'Keşif harcı', birim: 'keşif' },
};
const aralik = (s: UcretSatiri) => `${gun(s.baslangic)} - ${s.bitis ? gun(s.bitis) : 'bugün'}`;
const fiyat = (s: UcretSatiri) => (s.para && s.para !== 'TRY' ? `${s.tutar.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ${s.para}` : tl(s.tutar));
const posta = yururlukte('posta');
const eteb = yururlukte('etebligat');
const title = 'Yargılama gideri hesaplama: tebligat, e-tebligat ve keşif harcı | 657.com.tr';
const description = `UYAP tebligat Excel'ini yükleyin, tebligat ve e-tebligat giderleri tarihlerine göre hesaplansın. Güncel tebligat ücreti ${tl(posta.tutar)}, e-tebligat ${tl(eteb.tutar)}. Döküm kopyalanmaya hazır.`;
const istemci = { ucretler };
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Yargılama gideri hesaplama', item: `${site}/yargilamagideri/` },
  ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Yargılama gideri hesaplama', url: `${site}/yargilamagideri/`,
    applicationCategory: 'BusinessApplication', operatingSystem: 'Tarayıcı', inLanguage: 'tr-TR', isAccessibleForFree: true, description },
];
---
<Layout title={title} description={description} path="/yargilamagideri/" jsonLd={jsonLd}>
 <header class="portal-sayfa-basligi"><div class="container page--genis"><nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span aria-hidden="true">/</span><a href="/araclar/#yargi">Harç ve yargılama gideri</a></nav><div class="portal-sayfa-basligi__satir"><div class="dir__head">
   <h1>Yargılama gideri hesaplama</h1>
   <a class="btn btn--quiet btn--kucuk" href="/dosyalar/yargilama-gideri-tum-tarifeler.pdf" download>Tüm tarifeleri PDF indir · Tek A4</a>
   <p>UYAP tebligat Excel'ini bırakın ya da adetleri tarih aralığına göre girin. Güncel tebligat ücreti <span class="num">{tl(posta.tutar)}</span>, e-tebligat <span class="num">{tl(eteb.tutar)}</span>.</p>
  </div></div></div></header>
 <div class="container page page--genis" data-yg>
  

  <div class="arac">
   <div class="arac__sol">
    <section class="panel" aria-labelledby="teb-title" data-solid>
     <div class="panel__head">
      <h2 id="teb-title">Tebliğ ücretleri</h2>
      <div class="seg seg--small sekmeler" aria-label="Ücret türüne git">
       {TABLOLAR.map(t => <button type="button" id={`sekme-${t}`} aria-controls={`tablo-${t}`} data-yg-sekme={t}>{SEKME[t].ad} <span class="num" data-yg-sekme-adet={t}></span></button>)}
      </div>
     </div>
     <div class="yg-gruplar">{TABLOLAR.map(t => (
      <div class="ucretler" role="region" id={`tablo-${t}`} aria-labelledby={`baslik-${t}`} data-yg-panel={t}>
       <h3 id={`baslik-${t}`}>{SEKME[t].ad}</h3>
       <div class="ucretler__ara">
        <label for={`ara-${t}`} class="visually-hidden">{SEKME[t].ad} ücretinde tarihle bul</label>
        <input id={`ara-${t}`} type="search" placeholder="Tarihle bul: 15.03.2024 ya da 2024" autocomplete="off" data-yg-ara={t}/>
        <span class="panel__not"><span class="num">{ucretler[t].length}</span> dönem</span>
       </div>
       <ol class="ucretler__liste">
        {ucretler[t].map((s, j) => (
         <li data-yg-satir data-bas={s.baslangic} data-bit={s.bitis ?? ''}>
          <span class="ucretler__donem"><span>{aralik(s)}</span>{!s.bitis && <span class="chip chip--cte">Yürürlükte</span>}</span>
          <span class="ucretler__fiyat num">{fiyat(s)}</span>
          <span class="adim">
           <button type="button" class="pin" aria-label={`${aralik(s)} ${SEKME[t].birim} adedini azalt`} data-yg-azalt>−</button>
           <input type="text" inputmode="numeric" value="0" aria-label={`${aralik(s)} ${SEKME[t].birim} adedi`} data-yg-adet={`${t}:${j}`}/>
           <button type="button" class="pin" aria-label={`${aralik(s)} ${SEKME[t].birim} adedini artır`} data-yg-artir>+</button>
          </span>
         </li>
        ))}
       </ol>
       <p class="ucretler__bos" data-yg-bos hidden>Bu tarihe uyan ücret dönemi yok.</p>
       <nav class="yg-pager" aria-label={`${SEKME[t].ad} dönem sayfaları`}><button type="button" class="pin" data-yg-onceki aria-label="Önceki dönemler">‹</button><span data-yg-sayfa>1</span><button type="button" class="pin" data-yg-sonraki aria-label="Sonraki dönemler">›</button></nav>
      </div>
     ))}</div>
    </section>

    <section class="panel" aria-labelledby="gider-title" data-solid>
     <div class="panel__head"><h2 id="gider-title">Diğer giderler</h2><span class="panel__not">Her kaleme birden çok tutar ekleyebilirsiniz</span></div>
     <div class="kalemler">
      {GIDER_KALEMLERI.map(k => (
       <div class="kalem" data-yg-kalem={k.id}>
        <label for={`kalem-${k.id}`}>{k.baslik}</label>
        <div class="kalem__giris">
         <input id={`kalem-${k.id}`} type="text" inputmode="decimal" placeholder="0,00" autocomplete="off" data-yg-tutar/>
         <button type="button" class="btn btn--quiet btn--kucuk" data-yg-ekle>Ekle</button>
        </div>
        <ul class="kalem__liste" data-yg-liste></ul>
       </div>
      ))}
     </div>
    </section>
   </div>

   <aside class="yg-yan"><section class="panel sonuc" aria-labelledby="dokum-title" data-solid>
    <div class="panel__head"><h2 id="dokum-title">Döküm</h2><button type="button" class="btn btn--quiet btn--kucuk" data-yg-temizle>Temizle</button></div>
    <div class="yg-hesapla"><button class="btn" type="button" data-yg-hesapla>Hesapla</button><small>Adetleri değiştirdikçe sonuç güncellenir.</small></div>
    <dl class="sonuc__satirlar">
     <div><dt>Tebligat</dt><dd class="num" data-yg-k="posta">{tl(0)}</dd></div>
     <div><dt>E-tebligat</dt><dd class="num" data-yg-k="etebligat">{tl(0)}</dd></div>
     <div><dt>Genel toplam</dt><dd class="num sonuc__toplam" data-yg-k="toplam">{tl(0)}</dd></div>
    </dl>
    <pre class="dokum" data-yg-dokum aria-label="Döküm metni">--------------------------
TOPLAM : ₺0.00</pre>
    <div class="dokum__eylem">
     <button type="button" class="btn" data-yg-kopyala>Dökümü kopyala</button>
     <span class="panel__not" role="status" data-yg-kopyalandi></span>
    </div>
   </section><section class="panel" aria-labelledby="excel-title" data-solid>
     <div class="panel__head"><h2 id="excel-title">Tebligat dosyası yükle</h2></div>
     <label class="birak" data-yg-birak>
      <input type="file" accept=".xls,.xlsx" class="visually-hidden" data-yg-dosya/>
      <strong>UYAP Excel'ini bırakın veya seçin</strong>
      <span>XLS / XLSX. Dosya bilgisayarınızdan çıkmaz; tebligatlar tür ve tarihe göre sayılır.</span>
     </label>
     <p class="birak__durum" role="status" data-yg-durum hidden></p>
   </section></aside>
  </div>

  <section class="panel" aria-labelledby="bilgi-title" data-solid>
   <div class="panel__head"><h2 id="bilgi-title">Nasıl hesaplanır?</h2><a href="/yargilama-gideri-paylasim-hesabi/">Taraflar arasında paylaştır</a></div>
   <div class="prose prose--kisa">
    <p>Her tebligat, düzenlendiği tarihte yürürlükte olan ücretle çarpılır. Excel yüklendiğinde APS (hızlı gönderi) iki adet, elektronik tebligat, e-yazışma ve KEP iletileri kendi tablolarında sayılır. Diğer giderler girdiğiniz tutarlarla dökümün sonuna eklenir.</p>
    <p>Ücret tablosu sürümü {/^\d{4}-\d{2}-\d{2}$/.test(tebligat.surum) ? gun(tebligat.surum) : tebligat.surum}. Sonuçlar bilgilendirme amaçlıdır.</p>
   </div>
  </section>
 </div>
 <script type="application/json" id="yg-veri" set:html={JSON.stringify(istemci)}/>
</Layout>
<script>import '../../scripts/yargilama-gideri';</script>
<style>
 /* Hallmark · genre: editorial · macrostructure: Workbench · existing 657 tokens · utilitarian */
 [data-yg] .arac{grid-template-columns:minmax(0,1fr) 280px;align-items:start;}
 .yg-yan{display:grid;gap:var(--space-md);position:sticky;top:100px;}.yg-yan .sonuc{position:static;}.yg-yan .birak{padding:var(--space-lg);min-height:160px;}
 .yg-gruplar{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:var(--space-xs);padding:var(--space-sm);}
 .ucretler{min-width:0;border:1px solid var(--color-rule);border-radius:var(--radius-sm);overflow:hidden;scroll-margin-top:100px;}
 .ucretler h3{font-size:var(--text-xs);text-transform:uppercase;text-align:center;background:var(--color-ink);color:var(--color-paper);margin:0;padding:var(--space-sm) var(--space-xs);}
 .ucretler__ara{display:block;padding:var(--space-xs);}.ucretler__ara input{width:100%;font-size:var(--text-xs);padding:var(--space-xs);border-radius:var(--radius-sm);}.ucretler__ara .panel__not{display:none;}
 .ucretler__liste{max-height:none;overflow:visible;}.ucretler__liste li{display:grid;grid-template-columns:1fr;gap:var(--space-xs);padding:var(--space-sm) var(--space-xs);text-align:center;}.ucretler__liste li[hidden]{display:none;}
 .ucretler__donem{display:block;font-size:11px;font-weight:600;color:var(--color-accent-text);}.ucretler__donem .chip{display:none;}.ucretler__fiyat{text-align:center;font-size:var(--text-xs);font-weight:400;color:var(--color-muted);}.ucretler__liste .adim{justify-self:center;grid-column:auto;gap:4px;}.adim input{width:48px;min-width:0;}.adim .pin{width:26px;min-width:26px;height:28px;}
 .yg-pager{display:flex;justify-content:space-between;align-items:center;gap:4px;padding:var(--space-xs);border-top:1px solid var(--color-rule);font-size:var(--text-xs);}
 .kalemler{grid-template-columns:repeat(4,minmax(0,1fr));padding:var(--space-sm);gap:var(--space-xs);}.kalem{border:1px solid var(--color-rule);padding:var(--space-sm);min-width:0;}.kalem label{font-size:var(--text-xs);font-weight:600;}.kalem__giris{display:flex;gap:4px;}.kalem__giris input{width:100%;min-width:0;}.kalem__giris button{padding-inline:var(--space-xs);}
 .yg-hesapla{display:grid;gap:var(--space-xs);padding:var(--space-md);}.yg-hesapla small{color:var(--color-muted);}.sekmeler{display:none;}
 @media(max-width:1100px){[data-yg] .arac{grid-template-columns:1fr;}.yg-gruplar{grid-template-columns:repeat(5,minmax(0,1fr));}.sonuc,.yg-yan{position:static;}}
 @media(max-width:700px){.yg-gruplar{grid-template-columns:repeat(2,minmax(0,1fr));}.kalemler{grid-template-columns:repeat(2,minmax(0,1fr));}.sekmeler{display:flex;flex-wrap:wrap;}.ucretler__donem{font-size:var(--text-xs);}}
 @media(max-width:340px){.yg-gruplar,.kalemler{grid-template-columns:1fr;}}
</style>

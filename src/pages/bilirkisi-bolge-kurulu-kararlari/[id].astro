---
import Layout from '../../layouts/Layout.astro';
import { arsivKararlari, arsivYolu, kararYolu } from '../../lib/bilirkisi-kararlari';
export function getStaticPaths() {
  return arsivKararlari.map(karar => ({ params: { id: karar.id }, props: { karar } }));
}
const { karar } = Astro.props;
const { arsivGrubu: grup, hukum, inceleme, sonuc } = karar;
const description = inceleme?.ozet ?? `${karar.title}. ${karar.ozet ?? grup.ad} arşivi ve Daire Başkanlığından resmî PDF.`;
const kararMetni = hukum?.hukumSayfasi ? `${karar.url}#page=${hukum.hukumSayfasi}` : karar.url;
---
<Layout title={karar.title} description={description} path={kararYolu(karar.id)}>
  <article class="container page">
    <nav class="crumbs" aria-label="Konum"><a href={arsivYolu}>Bölge kurulu kararları</a> / <a href={arsivYolu + '#' + grup.id}>{grup.ad}</a></nav>
    <h1>{karar.title}</h1>
    {inceleme && <>
      <p><strong>{inceleme.ozet}</strong></p>
      <h2>Olay ve kararın gerekçesi</h2>
      <p>{inceleme.gerekce}</p>
    </>}
    <h2>Karar belgesi</h2>
    <dl>
      <dt>Resmî arşiv kategorisi</dt><dd>{grup.ad}</dd>
      {!inceleme && sonuc && <><dt>Belgedeki son hükmün sonucu</dt><dd>{sonuc}</dd></>}
      {hukum?.sure && <><dt>Geçici çıkarma süresi</dt><dd>{hukum.sure}</dd></>}
      {hukum?.yasakSuresi && <><dt>Bilirkişilikten yasaklanma süresi</dt><dd>{hukum.yasakSuresi}</dd></>}
      {hukum && <><dt>PDF sayfa sayısı</dt><dd>{hukum.sayfaSayisi}</dd></>}
      {hukum?.hukumSayfasi && <><dt>Hükmün başladığı PDF sayfası</dt><dd><a href={kararMetni}>{hukum.hukumSayfasi}. sayfayı aç</a></dd></>}
    </dl>
    <a class="btn" href={karar.url}>Daire Başkanlığından kararın tam metnini indir (PDF)</a>
    <details class="karar-belgesi">
      <summary>Resmî PDF’yi sayfada görüntüle</summary>
      <iframe src={karar.url} title={`${karar.title} – resmî PDF önizlemesi`} loading="lazy"></iframe>
    </details>
    <h2>Karar hakkında sorular</h2>
    {inceleme ? <>
      <h3>Kurul hangi sonuca vardı?</h3>
      <p>{inceleme.ozet}</p>
      <h3>{inceleme.soru}</h3>
      <p>{inceleme.cevap}</p>
    </> : <>
      <h3>Kurul hangi sonuca vardı?</h3>
      {sonuc ? <p>Hükümde şu sonuç yer alır: {sonuc}{hukum?.sure ? ` (${hukum.sure})` : ''}.</p>
        : <p>Bu kayıt Daire Başkanlığında {grup.ad.toLocaleLowerCase('tr-TR')} arşivinde yer alır. Somut sonuç için <a href={kararMetni}>karar metnini</a> açın.</p>}
    </>}
    {karar.dayanaklar.length > 0 && <>
      <h3>Hükümde hangi kanun bentleri geçiyor?</h3>
      <dl>{karar.dayanaklar.map(({ madde, aciklama }) => <><dt>{madde}</dt><dd>{aciklama}.</dd></>)}</dl>
    </>}
    {hukum?.kanunYolu && <>
      <h3>Kararda başvuru için hangi süre gösterilmiş?</h3>
      <p>Yayımlanan kararda {hukum.kanunYolu.tur === 'dava' ? 'dava açmak' : 'itiraz etmek'} için {hukum.kanunYolu.gun} gün belirtiliyor. Sürenin başlangıcı ve başvuru mercii için <a href={kararMetni}>kararın kanun yolu bölümünü</a> okuyun.</p>
    </>}
    <p><a href={grup.kaynak}>Kararın yayımlandığı resmî arşiv</a></p>
  </article>
</Layout>
<style>
  .karar-belgesi { margin-block: 1rem; }
  .karar-belgesi summary { cursor: pointer; }
  .karar-belgesi iframe { inline-size: 100%; block-size: min(72vh, 50rem); margin-block-start: .5rem; border: 1px solid var(--line); }
</style>

---
import Layout from '../../layouts/Layout.astro';
import metinler from '../../data/bilirkisi-karar-metinleri.json';
import { arsivKararlari, arsivYolu, kararYolu } from '../../lib/bilirkisi-kararlari';

export function getStaticPaths() {
  return arsivKararlari.map(karar => ({ params: { id: karar.id }, props: { karar } }));
}

const { karar } = Astro.props;
const { arsivGrubu: grup, hukum, inceleme, sonuc } = karar;
const metin = (metinler as Record<string, { sayfalar: string[][]; olay?: { konu: string; sayfa: number; alinti: string } }>)[karar.id];
const olay = metin.olay;
const kisaBaslik = karar.title.match(/^(.*?)\s*-\s*(\d{1,2}\.\d{1,2}\.\d{4})\s+Tarih ve\s+(\d+\/\d+)\s+Sayılı Karar/i);
const description = inceleme?.ozet ?? `${karar.title}. ${sonuc ?? grup.ad}. Kararın metni ve soru-cevap.`;
const hukumSayfasi = hukum?.hukumSayfasi && `#karar-sayfa-${hukum.hukumSayfasi}`;
const sorular = [
  ...(inceleme ? [{ soru: inceleme.soru, cevap: inceleme.cevap }] : []),
  ...(karar.id === 'gecici-cikarma-11-10-2019-2019-336' ? [
    { soru: 'Ek süre talebi yapıldı mı?', cevap: 'Kurul, bilirkişiye rapor için 20 gün verildiğini ve ek süre talebinde bulunulmadığını tespit etti.' },
    { soru: 'Kurul önceki disiplin kararını hesaba kattı mı?', cevap: 'Evet. Kurul, benzer bir gecikme nedeniyle daha önce verilen uyarmayı yaptırımın belirlenmesinde dikkate aldı.' },
  ] : []),
  ...(sonuc ? [{ soru: 'Kurul hangi kararı verdi?', cevap: inceleme?.ozet ?? `${sonuc}${hukum?.sure ? ` · Geçici çıkarma süresi ${hukum.sure}` : ''}${hukum?.yasakSuresi ? ` · Yasaklanma süresi ${hukum.yasakSuresi}` : ''}.` }] : []),
  ...(hukum?.kanunYolu ? [{ soru: 'Kararda hangi başvuru süresi yazıyor?', cevap: `Kararda ${hukum.kanunYolu.tur === 'dava' ? 'dava açmak' : 'itiraz etmek'} için ${hukum.kanunYolu.gun} gün belirtiliyor.` }] : []),
];
---
<Layout title={karar.title} description={description} path={kararYolu(karar.id)}>
  <header class="portal-sayfa-basligi">
    <div class="container">
      <nav class="crumbs" aria-label="Konum"><a href={arsivYolu}>Bölge kurulu kararları</a><span aria-hidden="true">/</span><a href={`${arsivYolu}#${grup.id}`}>{grup.ad}</a></nav>
      <div class="dir__head">
        <h1>{kisaBaslik ? `${kisaBaslik[1].replace(/\bBBK$/, 'Bölge Kurulu')} ${kisaBaslik[3]} sayılı karar` : karar.title}</h1>
        {kisaBaslik && <p class="karar-tarih">{kisaBaslik[2]}</p>}
        <p>{inceleme?.ozet ?? sonuc ?? grup.ad}</p>
      </div>
    </div>
  </header>

  <div class="container page karar-icerik">
    <section class="panel karar-ozet" data-solid aria-labelledby="karar-ozet-baslik">
      <div class="panel__head"><h2 id="karar-ozet-baslik">Kararın özeti</h2></div>
      <div class="karar-govde">
        <dl class="karar-bilgiler">
          <div><dt>Hüküm</dt><dd>{sonuc ?? 'Karar metnine bakın'}</dd></div>
          {hukum?.sure && <div><dt>Geçici çıkarma</dt><dd>{hukum.sure}</dd></div>}
          {hukum?.yasakSuresi && <div><dt>Yasaklanma</dt><dd>{hukum.yasakSuresi}</dd></div>}
          <div><dt>Arşiv kategorisi</dt><dd>{grup.ad}</dd></div>
        </dl>
        {inceleme ? <p>{inceleme.gerekce}</p> : olay && <p><strong>Metinde ele alınan konu</strong><br/>{olay.konu} · <a href={`#karar-sayfa-${olay.sayfa}`}>{olay.sayfa}. sayfa</a></p>}
        <div class="karar-eylemler">
          <a class="btn" href="#karar-tam-metin">Karar metnini oku</a>
          <a class="btn btn--quiet" href={karar.url}>Resmî PDF’yi indir ↗</a>
          {hukumSayfasi && <a class="btn btn--quiet" href={hukumSayfasi}>Hüküm sayfasına git</a>}
        </div>
      </div>
    </section>

    <section class="panel" data-solid aria-labelledby="karar-sorular-baslik">
      <div class="panel__head"><h2 id="karar-sorular-baslik">Karar hakkında sorular</h2></div>
      <div class="karar-govde karar-sorular">
        {!inceleme && olay && <div><h3>Dosyada hangi olay ele alındı?</h3><p>{olay.konu}</p><blockquote>{olay.alinti}</blockquote><a href={`#karar-sayfa-${olay.sayfa}`}>Metindeki yeri · {olay.sayfa}. sayfa</a></div>}
        {sorular.map(({ soru, cevap }) => <div><h3>{soru}</h3><p>{cevap}</p></div>)}
        {karar.dayanaklar.length > 0 && <div><h3>Hükümde hangi kanun bentleri geçiyor?</h3><ul>{karar.dayanaklar.map(({ madde, aciklama }) => <li><strong>{madde}</strong> · {aciklama}</li>)}</ul></div>}
      </div>
    </section>

    <article class="panel" data-solid aria-labelledby="karar-tam-metin">
      <div class="panel__head"><h2 id="karar-tam-metin">Kararın tam metni</h2></div>
      <div class="karar-govde">
        <p class="karar-transkript-notu">Metin, Daire Başkanlığının yayımladığı PDF’den sayfa sırasıyla aktarılmıştır.</p>
        <nav class="karar-sayfa-dizini" aria-label="PDF sayfaları">{metin.sayfalar.map((_, i) => <a href={`#karar-sayfa-${i + 1}`} aria-label={`${i + 1}. sayfa`}>{i + 1}</a>)}</nav>
        {metin.sayfalar.map((bloklar, i) => <section class="karar-tam-sayfa" id={`karar-sayfa-${i + 1}`}>
          <h3>{i + 1}. sayfa</h3>
          {bloklar.map(paragraf => <p>{paragraf.replace(/[ \t]{2,}/g, ' ').replace(/\n(?=\p{Ll})/gu, ' ')}</p>)}
        </section>)}
        <a href={grup.kaynak}>Daire Başkanlığındaki karar listesi ↗</a>
      </div>
    </article>
  </div>
</Layout>

<style>
  /* Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 */
  .karar-icerik { max-inline-size: 68rem; }
  .karar-tarih { font-size: var(--text-sm); }
  .karar-govde { padding: clamp(1rem, 3vw, 1.65rem); overflow-wrap: anywhere; }
  .karar-govde p { max-inline-size: 78ch; }
  .karar-bilgiler { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(12rem,100%),1fr)); gap: var(--space-md); margin: 0 0 var(--space-md); }
  .karar-bilgiler div { border-inline-start: 2px solid var(--color-rule); padding-inline-start: var(--space-sm); }
  .karar-bilgiler dt { color: var(--color-muted); font-size: var(--text-sm); }
  .karar-bilgiler dd { margin: .2rem 0 0; font-weight: 700; }
  .karar-eylemler, .karar-sayfa-dizini { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .karar-eylemler { margin-block-start: var(--space-md); }
  .karar-sorular > div + div, .karar-tam-sayfa { border-block-start: 1px solid var(--color-rule); margin-block-start: var(--space-md); padding-block-start: var(--space-md); }
  .karar-sorular h3, .karar-tam-sayfa h3 { font-size: var(--text-lead); max-inline-size: none; }
  .karar-sorular blockquote { margin-inline: 0; padding-inline-start: var(--space-md); border-inline-start: 2px solid var(--color-rule); }
  .karar-tam-sayfa { scroll-margin-block-start: 7rem; }
  .karar-tam-sayfa p { white-space: pre-line; line-height: 1.65; }
  .karar-transkript-notu { color: var(--color-muted); }
  .karar-sayfa-dizini a { min-inline-size: 44px; min-block-size: 44px; display: grid; place-items: center; border: 1px solid var(--color-rule); border-radius: var(--radius-sm); }
</style>

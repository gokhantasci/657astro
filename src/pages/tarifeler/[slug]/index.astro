---
import Layout from '../../../layouts/Layout.astro';
import {tarifeler,tarifeYol,tarifeYillari} from '../../../lib/tarife-arsivi';
import {gun} from '../../../lib/bicim';
export function getStaticPaths(){return tarifeler.map(t=>({params:{slug:t.slug},props:{t}}));}
const {t}=Astro.props;
const path=tarifeYol(t.slug),son=t.kayitlar.at(-1)!;
const jsonLd=[{'@context':'https://schema.org','@type':'Dataset',name:t.ad,description:t.aciklama,url:new URL(path,Astro.site).href,isAccessibleForFree:true,license:'https://657.com.tr/hizmet-sartlari-ve-kullanim-kosullari-2/',creator:{'@type':'Organization',name:'657.com.tr'},citation:t.kayitlar.map(r=>r.kaynak),temporalCoverage:`2024-01-01/${son.bitis??'..'}`}];
---
<Layout title={`${t.ad}: güncel ve geçmiş dönemler | 657.com.tr`} description={t.aciklama} path={path} jsonLd={jsonLd}>
 <header class="portal-sayfa-basligi"><div class="container"><nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span>/</span><a href="/bolum/tarifeler/">Tarifeler</a></nav><div class="dir__head"><h1>{t.ad}</h1><p>{t.aciklama}</p></div></div></header>
 <div class="container page tarife-sayfasi" data-tarife>
  <section class="panel" data-solid><div class="panel__head"><h2>Dönem seçimi</h2>{t.arac&&<a class="btn btn--quiet" href={t.arac}>Hesaplama aracı</a>}</div><div class="prose tarife-filtre"><label>Takvim yılı<select data-tarife-yil><option value="hepsi">Bütün dönemler</option>{tarifeYillari.map(y=><option value={y}>{y}</option>)}</select></label><p>{t.periyot}. Takvim yılı filtresi, yıl içinde yürürlükte kalan bütün tarifeleri gösterir. Tablolar brüt / tarife tutarlarını içerir.</p></div></section>
  <section class="panel" data-solid><div class="panel__head"><h2>Dönemler arasındaki değişim</h2></div><div class="prose"><label>Karşılaştırılan kalem<select data-tarife-kalem>{[...new Set(t.kayitlar.flatMap(r=>r.kalemler.map(k=>k.ad)))].map(ad=><option>{ad}</option>)}</select></label><p>Grafik seçilen kalemin nominal tutarını gösterir. Yüzde değişim bir önceki kayıtla karşılaştırılır; enflasyondan arındırılmamıştır. Eksik kayıtlar sıfır sayılmaz.</p><div data-tarife-grafik role="img" aria-label="Seçilen kalemin dönemlere göre değişimi"></div><div class="tarife-tablo"><table><thead><tr><th scope="col">Yürürlük</th><th scope="col">Tutar / oran</th><th scope="col">Önceki döneme göre</th></tr></thead><tbody data-tarife-karsilastirma></tbody></table></div><noscript>Karşılaştırmalı grafik için JavaScript'i etkinleştirin. Bütün tarife tutarları aşağıdaki dönem tablolarında bulunur.</noscript></div></section>
  <p data-tarife-yok hidden role="status">Bu yıl için kayıt bulunamadı. Resmî belge kontrol edilerek yeni dönem eklenmelidir.</p>
  {[...t.kayitlar].reverse().map(r=><section class="panel" data-solid data-tarife-kayit data-baslangic={r.baslangic} data-bitis={r.bitis??''} id={`donem-${r.baslangic}`}><div class="panel__head"><h2>{gun(r.baslangic)} – {r.bitis?gun(r.bitis):'Sonraki değişikliğe kadar'}</h2><a href={r.kaynak} target="_blank" rel="noopener noreferrer">Resmî tarife belgesi ↗</a></div><div class="prose"><p>{r.notu}</p><div class="tarife-tablo"><table data-tablo><thead><tr><th scope="col">Ücret / gider kalemi</th><th scope="col">Tutar / oran</th></tr></thead><tbody>{r.kalemler.map(k=><tr><th scope="row">{k.ad}</th><td class="num">{k.tutar.toLocaleString('tr-TR',{maximumFractionDigits:2})} {k.birim}</td></tr>)}</tbody></table></div><p>Tarifenin özel koşulları, ek cetvelleri ve uygulama hükümleri için yukarıdaki resmî belgeyi inceleyin.</p></div></section>)}
  <p><a href="/bolum/tarifeler/">Bütün tarifeler</a> · <a href="/veri-guncelleme/">Kaynak ve güncelleme kontrolü</a></p>
 </div>
 <script type="application/json" id="tarife-veri" set:html={JSON.stringify(t).replace(/</g,'\\u003c')} />
</Layout>
<script>import '../../../scripts/tarife-arsivi';</script>
<style>
/* Hallmark · pre-emit critique: P4 H4 E4 S5 R5 V4 · mevcut hizmet portalı */
.tarife-sayfasi{display:grid;gap:var(--space-lg);min-width:0}.tarife-filtre{display:flex;gap:var(--space-lg);align-items:center}.tarife-filtre label{min-width:160px}.tarife-tablo{overflow:auto}select{display:block;max-width:100%;min-height:44px;background:var(--color-paper-2);color:var(--color-ink);border:1px solid var(--color-rule);border-radius:var(--radius-pill);padding:var(--space-xs);font:inherit}label{display:block;font-weight:600}h1{overflow-wrap:anywhere} [data-tarife-grafik]{margin-block:var(--space-lg)}:global(.tarife-cubuk){display:grid;grid-template-columns:90px minmax(0,1fr) 110px;gap:var(--space-xs);align-items:center;margin:var(--space-sm) 0;font-size:var(--text-sm)}:global(.tarife-cubuk__iz){background:var(--color-paper-3);height:24px}:global(.tarife-cubuk__dolgu){display:block;background:var(--color-banner-rule);height:100%}@media(max-width:600px){.tarife-filtre{display:block}:global(.tarife-cubuk){grid-template-columns:78px minmax(0,1fr) 90px;font-size:var(--text-xs)}}
</style>

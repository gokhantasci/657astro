---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import {gun} from '../lib/bicim';
import YaziSlider from '../components/YaziSlider.astro';
import anasayfa from '../data/anasayfa.json';
import Gundem from '../components/Gundem.astro';
import Icon from '../components/Icon.astro';
import YaziKarti from '../components/YaziKarti.astro';
import {yayinDisi} from '../lib/yayin-filtresi';
import haberler from '../data/haberler.json';
import { ayarlar } from '../lib/settings';
import { araclar } from '../lib/tools';

const site = ayarlar.site.url;
const title = '657.com.tr: Memur maaşı, harç, kesinleşme ve teftiş araçları';
const description = `Kamu personeli ve adliye çalışanları için ${araclar.length} hesaplama ve kontrol aracı, Adalet Bakanlığı, HSK ve bağlı birimlerin haberleri, duyurular.`;
const tarih = (v: string | Date) => gun(new Date(v).toISOString());
// Kaynaklar aynı haberi iki kez yayımlayabiliyor; başlığa göre tekilleştirilir.
const siraliHaberler = [...new Map(haberler.filter(h=>!yayinDisi(h.title)).map(h => [h.title, h])).values()].sort((a, b) => b.date.localeCompare(a.date));
const ILK = 5;
const kaynaklar = [...new Set(siraliHaberler.map(h => h.source))];
const kaynakSinifi = (k: string) => k.toLocaleLowerCase('tr-TR').replace(/ı/g, 'i').replace(/ş/g, 's').replace(/[^a-z0-9]/g, '');
const yazilar = (await getCollection('yazilar', y => !y.data.taslak)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 10);

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site}/#site`, name: ayarlar.site.name, url: `${site}/`, inLanguage: 'tr-TR',
    publisher: { '@id': `${site}/#kurulus` },
    potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${site}/araclar/?q={search_term_string}` }, 'query-input': 'required name=search_term_string' },
  },
];
---
<Layout title={title} description={description} path="/" jsonLd={jsonLd}>
 <section class="portal-baslangic" aria-labelledby="portal-baslik"><div class="container portal-baslangic__ic"><div>
 <h1 id="portal-baslik">Hangi hesabı yapacaksınız?</h1><p class="portal-baslangic__aciklama">{araclar.length} hesaplama ve kontrol aracı: maaş, harç, kesinleşme, teftiş.</p>
 <form class="portal-arama" action="/araclar/" role="search"><label class="visually-hidden" for="portal-ara">Araçlarda ve yazılarda ara</label><Icon name="search" size={22}/><input id="portal-ara" type="search" name="q" placeholder="Örnek: enflasyon farkı, istinaf harcı, tensip süresi"/><kbd aria-hidden="true">/</kbd><button class="btn" type="submit">Ara</button></form>
 <nav class="home-kisayollar" aria-label="Araç ve program bağlantıları">{anasayfa.baglantilar.map(b=><a class="btn btn--quiet" href={b.yol}>{b.ad}</a>)}</nav>
 <nav class="portal-alanlar" aria-label="Sık kullanılan araçlar">{anasayfa.hizliAraclar.map(b=>{const dis=/^https?:/.test(b.yol);return <a href={b.yol} {...(dis?{target:'_blank',rel:'noopener'}:{})}><span>{b.ad}</span><span class="portal-alanlar__ok" aria-hidden="true">{dis?'↗':'→'}</span>{dis&&<span class="visually-hidden"> (yeni sekmede açılır)</span>}</a>;})}</nav>
 </div><section class="home-duyurular" id="duyurular" aria-label="Uygulama duyuruları">{anasayfa.duyurular.map((d,i)=><a class="panel home-duyuru" href={d.yol}><span class="home-duyuru__ikon" aria-hidden="true"><Icon name={(['search','calculator','check','table'] as const)[i%4]} size={20}/></span><h2>{d.baslik}</h2><p>{d.metin}</p></a>)}</section></div></section>
 <div class="container page home-yeni">
 <div class="home-haberler"><YaziSlider yazilar={yazilar}/>
  <section class="panel home__right" aria-labelledby="hab-title" data-solid data-news data-news-boyu={ILK}>
   <div class="panel__head">
    <h2 id="hab-title">Bakanlık haberleri</h2>
    <fieldset class="seg seg--small" data-news-filter>
     <legend class="visually-hidden">Kaynak</legend>
     <input type="radio" name="kaynak" id="kaynak-hepsi" value="" checked/><label for="kaynak-hepsi">Tümü</label>
     {kaynaklar.map(k => <><input type="radio" name="kaynak" id={`kaynak-${kaynakSinifi(k)}`} value={k}/><label for={`kaynak-${kaynakSinifi(k)}`}>{k}</label></>)}
    </fieldset>
   </div>
   <ul class="news">
    {siraliHaberler.map((h, i) => (
     <li data-kaynak={h.source} data-fazla={i >= ILK ? '' : undefined}>
      <a href={h.url} target="_blank" rel="noopener noreferrer">
       <span class="news__meta"><span class={`chip chip--${kaynakSinifi(h.source)}`}>{h.source}</span><time datetime={h.date}>{tarih(h.date)}</time></span>
       <span class="news__title">{h.title}</span>
       <span class="visually-hidden"> (resmî kaynak, yeni sekmede açılır)</span>
      </a>
     </li>
    ))}
   </ul>
   <nav class="pager" aria-label="Haber sayfaları" data-news-pager hidden>
    <button class="btn btn--quiet btn--kucuk" type="button" data-news-prev>Önceki</button>
    <span class="num" role="status" data-news-status></span>
    <button class="btn btn--quiet btn--kucuk" type="button" data-news-next>Sonraki</button>
   </nav>
  </section>
 </div>
 <section class="portal-yazilar" aria-labelledby="son-yazilar"><div class="portal-bolum-basligi"><h2 id="son-yazilar">Yazılar</h2><a href="/yazilar/">Tüm yazılar</a></div><ul>{yazilar.slice(0,4).map(y=><YaziKarti yazi={y}/>)}</ul></section>
 <Gundem/>
 </div>

</Layout>

<style>
/* Hallmark · pre-emit critique: P4 H4 E4 S5 R5 V4 */
.portal-baslangic{background:var(--color-paper-2);border-bottom:1px solid var(--color-rule);}.portal-baslangic__ic{display:grid;grid-template-columns:minmax(0,7fr) minmax(340px,3fr);gap:var(--space-xl);padding-block:var(--space-xl);}.portal-baslangic h1{max-width:none;font-size:clamp(1.875rem,3vw,2.5rem);}.portal-baslangic__aciklama{color:var(--color-muted);margin-block:var(--space-xs) var(--space-lg);font-size:1.0625rem;}.portal-arama{position:relative;display:flex;align-items:center;gap:var(--space-sm);height:60px;border:2px solid var(--color-ink);border-radius:var(--radius-card);padding:6px;}.portal-arama>svg{margin-left:var(--space-sm);color:var(--color-muted);flex:none;}.portal-arama input{width:100%;min-width:0;flex:1;border:0;background:transparent;color:var(--color-ink);font-size:1.0625rem;height:44px;outline-offset:0;}.portal-arama input::placeholder{color:var(--color-muted);}.portal-arama .btn{flex:none;}.portal-arama kbd{flex:none;}.home-kisayollar{display:flex;flex-wrap:wrap;gap:var(--space-xs);margin-top:var(--space-md);}.home-kisayollar .btn{min-height:36px;border-radius:var(--radius-filter);padding-inline:14px;font-size:var(--text-sm);}.portal-alanlar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid var(--color-rule);border-radius:var(--radius-card);overflow:hidden;margin-top:28px;}.portal-alanlar a{display:flex;justify-content:space-between;align-items:center;gap:var(--space-xs);padding:14px var(--space-md);border-right:1px solid var(--color-rule);border-bottom:1px solid var(--color-rule);margin:0 -1px -1px 0;font-size:.9375rem;text-decoration:none;}.portal-alanlar a:hover{background:var(--color-paper-3);}.portal-alanlar .num{background:var(--color-paper-3);border-radius:var(--radius-filter);padding:0 var(--space-xs);font-size:var(--text-xs);color:var(--color-muted);}.home-duyurular{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-sm);}.home-duyuru{display:flex;flex-direction:column;gap:var(--space-xs);padding:18px;text-decoration:none;}.home-duyuru__ikon{display:grid;place-items:center;width:36px;height:36px;border-radius:var(--radius-pill);background:var(--color-accent-soft);color:var(--color-accent-text);}.home-duyuru h2{font-size:1.0625rem;line-height:1.3;}.home-duyuru p{font-size:var(--text-sm);color:var(--color-muted);}.home-duyuru:hover{border-color:var(--color-muted);}.home-haberler{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-lg);align-items:stretch;}.home__right{min-width:0;}.home__right .panel__head{display:grid;gap:var(--space-sm);}.home__right .seg{flex-wrap:wrap;}.home__right .news{max-height:35rem;overflow:auto;}.portal-bolum-basligi{display:flex;align-items:baseline;justify-content:space-between;gap:var(--space-md);margin-bottom:var(--space-md);}.portal-bolum-basligi h2{font-size:var(--text-xl);}.portal-bolum-basligi a{font-size:var(--text-sm);color:var(--color-accent-text);white-space:nowrap;}.portal-yazilar ul{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-md);list-style:none;padding:0;margin:0;}.portal-yazilar li{padding:18px;}.portal-yazilar :global(.yazi-karti){height:100%;}.home-yeni{gap:var(--space-lg);}
@media(max-width:1100px){.portal-baslangic__ic{grid-template-columns:minmax(0,1fr);gap:var(--space-lg);}.home-duyurular{grid-template-columns:repeat(4,minmax(0,1fr));}}
@media(max-width:768px){.home-haberler{grid-template-columns:minmax(0,1fr);}.home-duyurular,.portal-yazilar ul{grid-template-columns:repeat(2,minmax(0,1fr));}.portal-baslangic__ic{padding-block:var(--space-lg);}.portal-arama kbd{display:none;}.portal-alanlar{grid-template-columns:repeat(2,minmax(0,1fr));}}
@media(max-width:420px){.portal-alanlar{grid-template-columns:minmax(0,1fr);}.home-duyurular,.portal-yazilar ul{grid-template-columns:minmax(0,1fr);}.portal-arama input{font-size:var(--text-sm);}.portal-alanlar a{padding:var(--space-sm);font-size:var(--text-sm);}.portal-alanlar__ok{color:var(--color-muted);}.portal-arama>svg{margin-left:var(--space-2xs);}}
</style>

---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import {gun,tarihSaat} from '../lib/bicim';
import YaziSlider from '../components/YaziSlider.astro';
import anasayfa from '../data/anasayfa.json';
import EnCokOkunanlar from '../components/EnCokOkunanlar.astro';
import Icon from '../components/Icon.astro';
import YaziKarti from '../components/YaziKarti.astro';
import {kurumHaberleri,haberArsivYolu} from '../lib/kurum-haberleri';
import haberAkisi from '../data/haber-akisi.json';
import { HESAPLAMA_SAYACLARI, HESAPLAMA_SAYACLARI_AKTIF } from '../lib/hesaplama-sayaclari';
import { ayarlar, guncelKatsayilar } from '../lib/settings';
import { araclar, kategoriler, kategoriAraclari } from '../lib/tools';
import { donemAraligi, katsayi } from '../lib/bicim';

const site = ayarlar.site.url;
const title = '657.com.tr: Memur maaşı, harç, kesinleşme ve teftiş araçları';
const description = `Kamu personeli ve adliye çalışanları için ${araclar.length} hesaplama ve kontrol aracı, Adalet Bakanlığı, HSK ve bağlı birimlerin haberleri, duyurular.`;
const tarih = (v: string | Date) => gun(new Date(v).toISOString());
// Kaynaklar aynı haberi iki kez yayımlayabiliyor; başlığa göre tekilleştirilir.
const siraliHaberler=kurumHaberleri;
const sayilar=new Map<string,number>();
const ilkHaberler=siraliHaberler.filter(h=>{const n=(sayilar.get(h.source)??0)+1;sayilar.set(h.source,n);return n<=5;});
const hizliYollar=new Set(anasayfa.hizliAraclar.map(a=>a.yol));
const digerBaglantilar=anasayfa.baglantilar.filter(a=>!hizliYollar.has(a.yol));
const ILK = 5;
const kaynaklar = [...new Set([...siraliHaberler.map(h => h.source),'Personel'])];
const personelDurumlari=haberAkisi.kaynaklar.filter(k=>k.kaynak==='Personel');
const kaynakSinifi = (k: string) => k.toLocaleLowerCase('tr-TR').replace(/ı/g, 'i').replace(/ş/g, 's').replace(/[^a-z0-9]/g, '');
const yazilar = (await getCollection('yazilar', y => !y.data.taslak)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 10);

const kat = guncelKatsayilar();
const sss = [
  { soru: '657.com.tr nedir?', cevap: `657.com.tr, kamu personeli ve adliye çalışanları için memur maaşı, enflasyon farkı, harç, yargılama gideri, kesinleşme ve teftiş hesaplarını tek yerde toplayan ücretsiz bir portaldır. Şu anda ${araclar.length} araç, hukuk sözlüğü, çıkmış mülakat soruları ve Adalet Bakanlığı haberleri sunar.` },
  { soru: 'Hesaplamalar resmî sonuç yerine geçer mi?', cevap: 'Hayır. Sonuçlar bilgilendirme amaçlıdır; resmî işlemde ilgili mevzuat ve kurum kayıtları esas alınır. Her araç dayandığı kuralı ve kaynağı sayfasında gösterir.' },
  { soru: 'Güncel memur aylık katsayısı kaç?', cevap: `${donemAraligi(kat)} döneminde memur aylık katsayısı ${katsayi(kat.memur_maas_aylik_katsayi)}, taban aylık katsayısı ${katsayi(kat.taban_aylik_katsayi)}, yan ödeme katsayısı ${katsayi(kat.yan_odeme_katsayi)} olarak uygulanır.` },
  { soru: 'Girdiğim bilgiler kaydediliyor mu?', cevap: 'Hesaplar tarayıcınızda yapılır; maaş, harç ve süre bilgileriniz sunucuya gönderilmez. Yalnızca anonim kullanım sayıları tutulur.' },
];
const portalSorulari=[
 {soru:'Hesaplama sonuçları resmî belge midir?',cevap:'Sonuçlar bilgilendirme ve kontrol amaçlıdır. Resmî işlemde ilgili mevzuat, kurum kaydı ve kişisel bordro esas alınır. Kullanılan tarih ve varsayımları ilgili araçta kontrol edin.',yol:'/icerik-kaynaklari/',baglanti:'Kaynak ve düzeltme ilkeleri'},
 {soru:'Hangi tarihin tarifesiyle hesap yapılır?',cevap:'Maaş ve tarife araçlarında seçilen döneme ait ortak veriler kullanılır. Geçmiş dönem hesabı güncel dönemle aynı kabul edilmez; yürürlük tarihini ve aracın gösterdiği dayanağı birlikte inceleyin.',yol:'/bolum/tarifeler/',baglanti:'Tarifeleri inceleyin'},
 {soru:'DPB görüşleri güncel mevzuatın yerine geçer mi?',cevap:'Hayır. DPB görüşleri tarihsel belgelerdir. Özgün metin, kaynağı ve belge tarihi birlikte okunmalıdır. Görüşün altındaki soru-cevap bölümü özgün belgenin parçası değildir.',yol:'/devlet-personel-baskanligi-mutalaalari/',baglanti:'Görüş arşivini açın'},
];
const jsonLd = [
 {'@context':'https://schema.org','@type':'FAQPage',mainEntity:portalSorulari.map(q=>({'@type':'Question',name:q.soru,acceptedAnswer:{'@type':'Answer',text:q.cevap}}))},
  {
    '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site}/#site`, name: ayarlar.site.name, url: `${site}/`, inLanguage: 'tr-TR',
    publisher: { '@id': `${site}/#kurulus` },
    potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${site}/araclar/?q={search_term_string}` }, 'query-input': 'required name=search_term_string' },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'tr-TR', mainEntity: sss.map(x => ({ '@type': 'Question', name: x.soru, acceptedAnswer: { '@type': 'Answer', text: x.cevap } })) },
];
---
<Layout title={title} description={description} path="/" jsonLd={jsonLd}>
 <section class="portal-baslangic" aria-labelledby="portal-baslik"><div class="container portal-baslangic__ic"><div>
 <div class="home-guven-bandi">
  <span class="home-guven-nokta" aria-hidden="true"></span>
  <span>{araclar.length} Güncel Hesaplama Aracı</span>
  <span class="home-guven-ayrac">·</span>
  <span>Resmî Katsayılar</span>
  <span class="home-guven-ayrac">·</span>
  <span>Gizlilik Odaklı & Güvenli</span>
 </div>
 <h1 id="portal-baslik">Maaş, harç ve adliye araçları</h1><p class="portal-baslangic__aciklama">Kamu personeli ve adliye çalışanları için {araclar.length} hesaplama ve kontrol aracı: maaş, harç, kesinleşme, teftiş.</p>
 <form class="portal-arama" action="/araclar/" role="search"><label class="visually-hidden" for="portal-ara">Araçlarda ve yazılarda ara</label><Icon name="search" size={22}/><input id="portal-ara" type="search" name="q" placeholder="Araç veya konu arayın (Örn: Maaş, enflasyon farkı, istinaf harcı)"/><kbd aria-hidden="true">/</kbd><button class="btn" type="submit">Ara</button></form>
 <div class="home-hizli-aramalar" aria-label="Popüler aramalar">
  <span class="home-hizli-etiket">Hızlı erişim:</span>
  <a href="/memur-maas-hesaplama/">Maaş Hesaplama</a>
  <a href="/enflasyon-farki-hesaplama-robotu/">Enflasyon Farkı</a>
  <a href="/kesinlesme/">Kesinleşme</a>
  <a href="/yargi-haritasi/">Yargı Haritası</a>
  <a href="/devlet-personel-baskanligi-mutalaalari/">DPB Görüşleri</a>
 </div>
 <nav class="home-kisayollar" aria-label="Araç ve program bağlantıları">{digerBaglantilar.map(b=><a class="btn btn--quiet" href={b.yol}><span>{b.ad==='Programlar ve dosyalar'?'Programlar':b.ad}</span>{b.yeni&&<span class="home-badge-yeni">YENİ</span>}</a>)}</nav>
 <nav class="portal-alanlar" aria-label="Sık kullanılan araçlar">{anasayfa.hizliAraclar.map(b=>{const dis=/^https?:/.test(b.yol);return <a href={b.yol} aria-label={b.ad} {...(dis?{target:'_blank',rel:'noopener'}:{})}><span>{b.ad.replace(/ hesapla$/,'')}</span><span class="portal-alanlar__ok" aria-hidden="true">{dis?'↗':'→'}</span>{dis&&<span class="visually-hidden"> (yeni sekmede açılır)</span>}</a>;})}</nav>
 </div><section class="home-duyurular" id="duyurular" tabindex="-1" aria-label="Uygulama duyuruları">{anasayfa.duyurular.map((d,i)=><a class="panel home-duyuru" href={d.yol}><span class="home-duyuru__ikon" aria-hidden="true"><Icon name={(['search','calculator','check','table'] as const)[i%4]} size={20}/></span><h2>{d.baslik}</h2><p>{d.metin}</p></a>)}</section></div></section>
 <div class="container page home-yeni">
  {HESAPLAMA_SAYACLARI_AKTIF && <section class="home-sayac-kutusu" aria-labelledby="home-sayac-baslik">
   <div class="home-sayac-kutusu__ust">
    <div>
     <h2 id="home-sayac-baslik" class="home-sayac-kutusu__baslik">

      İşlem sayaçları
     </h2>
     <p class="home-sayac-kutusu__aciklama">
      Araçlarımızda ölçüm başlangıcından bu yana toplam <strong data-home-toplam-hesaplama>—</strong> işlem yapıldı.
     </p>
     <p class="home-sayac-kutusu__aciklama" data-sayac-durum role="status">Sayaç bilgileri yükleniyor…</p>
    </div>
   </div>
   <div class="home-sayac-grid">
    {Object.values(HESAPLAMA_SAYACLARI).map(s => (
     <a href={s.yol} class="home-sayac-kart">
      <div class="home-sayac-kart__ust">
       <span class="home-sayac-kart__ikon" aria-hidden="true"><Icon name={({enflasyon:'table',maas:'calculator',kesinlesme:'check',yargilama:'pin'} as Record<string,string>)[s.anahtar]??'calculator'} size={18}/></span>
       <span class="home-sayac-kart__etiket">{s.kisa}</span>
       <span class="home-sayac-kart__ok" aria-hidden="true">→</span>
      </div>
      <div class="home-sayac-kart__sayi num" data-hesap-sayi={s.anahtar}>—</div>
      <div class="home-sayac-kart__alt">toplam {s.baslik.toLowerCase()}</div>
     </a>
    ))}
   </div>
  </section>}
  <section class="home-alanlar" aria-labelledby="alanlar-baslik"><div class="portal-bolum-basligi"><h2 id="alanlar-baslik">Alanlara göre araçlar</h2><a href="/araclar/">Bütün araçlar ({araclar.length})</a></div>
   <ul>{kategoriler.map(k=><li><a class="panel" href={`/araclar/#${k.id}`}><strong>{k.title}</strong><span>{k.description}</span><span class="home-alanlar__say num">{kategoriAraclari(k.id).length} araç</span></a></li>)}</ul></section>
 <div class="home-haberler"><YaziSlider yazilar={yazilar}/>
  <section class="panel home__right" aria-labelledby="hab-title" data-solid data-news data-news-boyu={ILK} data-news-kontrol={haberAkisi.kontrolTarihi}>
   <div class="panel__head">
    <h2 id="hab-title">Bakanlık haberleri</h2>
    <fieldset class="seg seg--small" data-news-filter>
     <legend class="visually-hidden">Kaynak</legend>
     <input type="radio" name="kaynak" id="kaynak-hepsi" value="" data-news-arsiv={haberArsivYolu()} checked/><label for="kaynak-hepsi">Tümü</label>
     {kaynaklar.map(k => <><input type="radio" name="kaynak" id={`kaynak-${kaynakSinifi(k)}`} value={k} data-news-arsiv={haberArsivYolu(k)}/><label for={`kaynak-${kaynakSinifi(k)}`}>{k}</label></>)}
    </fieldset>
   </div>
   <p class="home-haber-kontrol"><span data-news-kontrol role="status">Son kaynak kontrolü: {tarihSaat(haberAkisi.kontrolTarihi)}</span> <button type="button" class="btn btn--quiet btn--kucuk" data-news-yenile>Yenile</button></p>
   <p class="home-haber-kontrol" data-news-personel-bilgi hidden>{personelDurumlari.length} kurum izleniyor · {personelDurumlari.filter(k=>k.basarili).length} kaynağa ulaşıldı{personelDurumlari.some(k=>!k.basarili)&&` · ${personelDurumlari.filter(k=>!k.basarili).length} kaynak yeniden denenecek`}. Sınav, mülakat, sözlü, sonuç ve aday duyuruları.</p>
   <ul class="news">
    {ilkHaberler.map((h, i) => (
     <li data-kaynak={h.source} data-fazla={i >= ILK ? '' : undefined}>
      <a href={h.url} target="_blank" rel="noopener noreferrer">
       <span class="news__meta"><span class={`chip chip--${kaynakSinifi(h.source)}`}>{h.source}</span>{'institution' in h&&<span data-news-kurum>{h.institution}</span>}<time datetime={h.date}>{tarih(h.date)}</time></span>
       <span class="news__title">{h.title}</span>
       <span class="visually-hidden"> (resmî kaynak, yeni sekmede açılır)</span>
      </a>
     </li>
    ))}
   </ul>
   <nav class="pager" aria-label="Haber sayfaları" data-news-pager hidden>
    <button class="btn btn--quiet btn--kucuk" type="button" data-news-prev>Önceki</button>
    <span class="num" role="status" data-news-status></span>
    <button class="btn btn--quiet btn--kucuk" type="button" data-news-next>Sonraki</button>
   </nav>
   <p class="home-haber-arsiv"><a href="/kurum-haberleri/" data-news-arsiv>Tüm kayıtları aç →</a></p>
  </section>
 </div>
 <section class="portal-yazilar" aria-labelledby="son-yazilar"><div class="portal-bolum-basligi"><h2 id="son-yazilar">Yazılar</h2><a href="/yazilar/">Tüm yazılar</a></div><ul>{yazilar.slice(0,4).map(y=><YaziKarti yazi={y}/>)}</ul></section>
 <EnCokOkunanlar/>
 <section class="panel home-sss" aria-labelledby="home-sss-baslik" data-solid><div class="panel__head"><h2 id="home-sss-baslik">Sık sorulan sorular</h2></div><div class="sss__liste">{sss.map(x=><details class="sss__madde"><summary>{x.soru}</summary><p>{x.cevap}</p></details>)}</div></section>

 <section class="panel home-bilgi" aria-labelledby="home-bilgi-baslik"><div class="panel__head"><h2 id="home-bilgi-baslik">Kaynaklar ve hesaplama sınırları</h2><a href="/icerik-kaynaklari/">Yayın ilkeleri</a></div><div class="home-bilgi__sorular">{portalSorulari.map(q=><details><summary>{q.soru}</summary><p>{q.cevap} <a href={q.yol}>{q.baglanti}</a></p></details>)}</div></section>
 </div>

</Layout>

<style>
/* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 · existing design.md system */
.home-guven-bandi{display:inline-flex;align-items:center;gap:var(--space-xs);font-size:var(--text-xs);font-weight:500;color:var(--color-muted);background:var(--color-paper-3);padding:4px 12px;border-radius:var(--radius-filter);border:1px solid var(--color-rule);margin-bottom:var(--space-sm);}
.home-guven-nokta{width:7px;height:7px;border-radius:50%;background:#10b981;box-shadow:0 0 0 3px rgba(16,185,129,0.2);animation:live-pulse 2s infinite;flex:none;}
.home-guven-ayrac{color:var(--color-muted);opacity:.5;}
@keyframes live-pulse{0%,100%{box-shadow:0 0 0 3px rgba(16,185,129,0.2);}50%{box-shadow:0 0 0 5px rgba(16,185,129,0.4);}}
.home-hizli-aramalar{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:var(--space-sm);font-size:var(--text-xs);}
.home-hizli-etiket{color:var(--color-muted);font-weight:600;}
.home-hizli-aramalar a{color:var(--color-ink-2);background:var(--color-paper-3);padding:4px 10px;border-radius:var(--radius-filter);text-decoration:none;border:1px solid var(--color-rule);transition:background var(--dur-micro) var(--ease-out),border-color var(--dur-micro) var(--ease-out),color var(--dur-micro) var(--ease-out);min-height:28px;display:inline-flex;align-items:center;}
.home-hizli-aramalar a:hover{background:var(--color-accent-soft);color:var(--color-accent-text);border-color:var(--color-accent-text);}
.home-haber-kontrol[hidden]{display:none;}#duyurular{scroll-margin-top:var(--space-3xl);}#duyurular:target{outline:2px solid var(--color-focus);outline-offset:var(--space-2xs);}
.portal-baslangic{background:var(--color-paper-2);border-bottom:1px solid var(--color-rule);}.portal-baslangic__ic{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,4fr);gap:var(--space-xl);padding-block:var(--space-xl);}.portal-baslangic h1{max-width:24ch;font-size:var(--text-display);line-height:1.18;}.portal-baslangic__aciklama{color:var(--color-muted);margin-block:var(--space-2xs) var(--space-lg);font-size:var(--text-lead);}
.portal-arama{position:relative;display:flex;align-items:center;gap:var(--space-sm);min-height:60px;border:2px solid var(--color-ink);border-radius:var(--radius-pill);padding:var(--space-xs);background:var(--color-paper-2);box-shadow:0 2px 8px color-mix(in srgb,var(--color-ink) 4%,transparent);transition:border-color var(--dur-short) var(--ease-out),box-shadow var(--dur-short) var(--ease-out);}.portal-arama:focus-within{border-color:var(--color-focus);box-shadow:0 0 0 3px color-mix(in srgb,var(--color-focus) 16%,transparent);}.portal-arama>svg{margin-left:var(--space-xs);color:var(--color-muted);flex:none;}.portal-arama input{width:100%;min-width:0;flex:1;border:0;background:transparent;color:var(--color-ink);height:44px;font-size:1rem;}.portal-arama input::placeholder{color:var(--color-muted);}.portal-arama .btn{flex:none;}
.home-kisayollar{display:flex;flex-wrap:wrap;gap:var(--space-xs);margin-top:var(--space-md);}.home-kisayollar .btn{font-size:var(--text-sm);padding-inline:var(--space-sm);border-radius:var(--radius-filter);}.home-badge-yeni{background:var(--color-accent-soft);color:var(--color-accent-text);font-size:var(--text-xs);font-weight:700;padding:var(--space-2xs) var(--space-xs);border-radius:var(--radius-filter);}
.portal-alanlar{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-xs);margin-top:var(--space-lg);}.portal-alanlar a{display:flex;justify-content:space-between;align-items:center;gap:var(--space-xs);min-height:48px;padding:var(--space-sm) var(--space-md);background:var(--color-paper-3);border:1px solid var(--color-rule);border-radius:var(--radius-pill);font-size:var(--text-sm);font-weight:500;text-decoration:none;transition:background var(--dur-micro) var(--ease-out),transform var(--dur-micro) var(--ease-out),border-color var(--dur-micro) var(--ease-out);}.portal-alanlar a:hover{background:var(--color-paper-2);border-color:var(--color-ink);transform:translateY(-1px);}.portal-alanlar__ok{color:var(--color-muted);flex:none;}
.home-duyurular{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-sm);align-content:start;}.home-duyuru{display:flex;flex-direction:column;gap:var(--space-xs);padding:var(--space-md);text-decoration:none;transition:transform var(--dur-short) var(--ease-out),border-color var(--dur-short) var(--ease-out),box-shadow var(--dur-short) var(--ease-out);}.home-duyuru:hover{transform:translateY(-2px);border-color:var(--color-accent);box-shadow:var(--shadow-lift);}.home-duyuru__ikon{color:var(--color-accent-text);}.home-duyuru h2{font-size:var(--text-md);line-height:1.4;}.home-duyuru p{font-size:var(--text-sm);color:var(--color-muted);}
.home-yeni{gap:var(--space-xl);}.home-haberler{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--space-lg);align-items:start;}.home__right{min-width:0;}.home__right .panel__head{display:grid;gap:var(--space-sm);}.home__right .seg{flex-wrap:wrap;}.home__right .news{max-height:36rem;overflow:auto;}.home-haber-kontrol{display:flex;align-items:center;justify-content:space-between;gap:var(--space-sm);padding:var(--space-sm) var(--space-md);font-size:var(--text-xs);color:var(--color-muted);border-bottom:1px solid var(--color-rule);margin:0;}.home-haber-arsiv{padding:var(--space-sm) var(--space-md);font-size:var(--text-sm);}.home-haber-arsiv a{min-height:44px;display:inline-flex;align-items:center;}

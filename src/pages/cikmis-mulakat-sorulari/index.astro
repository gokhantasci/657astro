---
import Layout from '../../layouts/Layout.astro';
import SoruListesi from '../../components/SoruListesi.astro';
import { ayarlar } from '../../lib/settings';
import { sorular } from '../../lib/mulakat';

const site = ayarlar.site.url;
const sayi = (n: number) => new Intl.NumberFormat('tr-TR').format(n);
const mulakatSayisi = sorular.filter(s => s.mulakat).length;
const title = `Çıkmış mülakat soruları ve hatırlatma kartları (${sayi(sorular.length)} soru) | 657.com.tr`;
const description = `Adalet Bakanlığı ve kamu mülakatlarında sorulmuş ${sayi(mulakatSayisi)} soru ile genel kültür kartları: cevaplarıyla birlikte, kart çevirerek tekrar edin.`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Çıkmış mülakat soruları', item: `${site}/cikmis-mulakat-sorulari/` },
  ] },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Çıkmış mülakat soruları', url: `${site}/cikmis-mulakat-sorulari/`, inLanguage: 'tr-TR', description },
];
---
<Layout title={title} description={description} path="/cikmis-mulakat-sorulari/" jsonLd={jsonLd}>
 <div class="container page">
  <nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span aria-hidden="true">/</span><span aria-current="page">Çıkmış mülakat soruları</span></nav>
  <div class="dir__head"><h1>Çıkmış mülakat soruları</h1><p><span class="num">{sayi(sorular.length)}</span> kart, bunların <span class="num">{sayi(mulakatSayisi)}</span> tanesi mülakatlarda sorulmuş. Kartı çevirin, cevabı görün.</p></div>

  <section class="panel kartlar" aria-labelledby="kart-title" data-solid data-kartlar>
   <div class="panel__head">
    <h2 id="kart-title">Hatırlatma kartları</h2>
    <fieldset class="seg seg--small" data-kart-filtre>
     <legend class="visually-hidden">Hangi kartlar</legend>
     <input type="radio" name="kart-filtre" id="kf-tum" value="tum" checked/><label for="kf-tum">Tümü <span class="num">{sayi(sorular.length)}</span></label>
     <input type="radio" name="kart-filtre" id="kf-mulakat" value="mulakat"/><label for="kf-mulakat">Mülakat soruları <span class="num">{sayi(mulakatSayisi)}</span></label>
    </fieldset>
   </div>

   <div class="kartlar__govde">
    <div class="kart" data-kart>
     <div class="kart__ic">
      <div class="kart__yuz kart__on" data-kart-on><span class="kart__etiket">Soru</span><p class="kart__metin" data-kart-soru>Kartlar yükleniyor…</p></div>
      <div class="kart__yuz kart__arka" data-kart-arka aria-hidden="true"><span class="kart__etiket">Cevap</span><p class="kart__metin" data-kart-cevap></p></div>
     </div>
    </div>
    <p class="visually-hidden" aria-live="polite" data-kart-duyuru></p>

    <div class="kartlar__eylem">
     <button class="btn btn--quiet" type="button" data-kart-geri disabled>Önceki <kbd aria-hidden="true">←</kbd></button>
     <button class="btn" type="button" data-kart-cevir aria-pressed="false" disabled>Çevir <kbd aria-hidden="true">boşluk</kbd></button>
     <button class="btn btn--quiet" type="button" data-kart-ileri disabled>Sonraki <kbd aria-hidden="true">→</kbd></button>
    </div>

    <div class="kartlar__ayar">
     <label class="tik"><input type="checkbox" data-kart-otocevir/> 3 saniyede çevir</label>
     <label class="tik"><input type="checkbox" data-kart-oynat/> Otomatik oynat</label>
     <label class="tik">Aralık
      <select data-kart-aralik>
       <option value="5">5 sn</option><option value="8" selected>8 sn</option><option value="12">12 sn</option><option value="20">20 sn</option>
      </select>
     </label>
     <label class="tik"><input type="checkbox" data-kart-ses/> Ses</label>
     <span class="kartlar__yazi" role="group" aria-label="Yazı boyutu">
      <button class="pin" type="button" data-kart-kucult aria-label="Yazıyı küçült">A−</button>
      <output class="num" data-kart-boyut>100%</output>
      <button class="pin" type="button" data-kart-buyut aria-label="Yazıyı büyüt">A+</button>
     </span>
     <button class="btn btn--quiet btn--kucuk" type="button" data-kart-tamekran>Tam ekran</button>
    </div>

    <p class="kartlar__alt">
     <span>Bu cihazda okunan: <span class="num" data-kart-okunan>0</span> kart</span>
     <a href="/cikmis-mulakat-sorulari/" data-kart-sayfa>Bu sorunun sayfası</a>
     <span class="okunma num" data-kart-okunma></span>
     <a href="/oneri/?tur=mulakat">Soru önerin</a>
    </p>
   </div>
  </section>

  <SoruListesi n={1}/>
 </div>
</Layout>
<script>import '../../scripts/kartlar';</script>

---
import Layout from '../layouts/Layout.astro';
import SubdomainLayout from '../layouts/SubdomainLayout.astro';
import klavyeOzet from '../data/klavye-ozet.json';
import { ayarlar } from '../lib/settings';

interface Props { standalone?: boolean; odak?: 'sinav' | 'canli' | 'arsiv' | 'kriterler'; activeHref?: string; }
const { standalone = false, odak = 'sinav', activeHref = '/' } = Astro.props;

const site = ayarlar.site.url;
const path = '/on-parmak/';
const title = 'On Parmak Klavye Sınavı ve Çalışma (F ve Q Klavye) | onparmak.657.com.tr';
const description = `Adalet Bakanlığı zabıt kâtipliği ve CTE uygulamalı klavye sınavı simülatörü. 2019–2026 tüm PGM ve CTE resmî metinleri (${klavyeOzet.toplamMetin} metin), Daktilografi Kitabı dersleri, F/Q sanal klavye ve resmî değerlendirme tutanağı.`;

const opNav = [
  { href: '/', label: '3 Dk Sınav' },
  { href: '/canli-sinav/', label: 'Canlı Sınav & Sıralama' },
  { href: '/dersler/', label: 'F/Q Dersler' },
  { href: '/arsiv/', label: '521 Metin Arşivi' },
  { href: '/kriterler/', label: 'Kriterler' },
];
const Kabuk: any = standalone ? SubdomainLayout : Layout;
const kabukProps = standalone
  ? { title, description, canonical: `https://onparmak.657.com.tr${activeHref}`, brand: 'On Parmak Klavye', brandTag: 'KLAVYE · 657', themeVariant: 'onparmak' as const, manifest: '/onparmak-manifest.webmanifest', nav: opNav }
  : { title, description, path };

const yilArsivleri = [
  { yil: '2026', ad: '2026 PGM & CTE Sınav Metinleri (60 Metin)', yol: '/2026-yili-zabit-katibi-ve-cte-uygulamali-sinav-metinleri/' },
  { yil: '2025', ad: '2025 PGM Görevde Yükselme Metinleri', yol: '/2025-yili-zabit-katibi-uygulamali-sinav-metinleri/' },
  { yil: '2023', ad: '2023 PGM & CTE Sınav Metinleri (60 Metin)', yol: '/2023-yili-zabit-katibi-ve-cte-uygulamali-sinav-metinleri/' },
  { yil: '2022', ad: '2022 PGM, CTE & HSK Sınav Metinleri (70 Metin)', yol: '/2022-yili-zabit-katibi-ve-cte-uygulamali-sinav-metinleri/' },
  { yil: '2021', ad: '2021 PGM & CTE Sınav Metinleri (190 Metin)', yol: '/2021-yili-zabit-katibi-ve-cte-uygulamali-sinav-metinleri/' },
  { yil: '2020', ad: '2020 HSK VHKİ Sınav Metinleri (10 Metin)', yol: '/2020-yili-hsk-uygulamali-sinav-metinleri/' },
  { yil: '2019', ad: '2019 CTE Sınav Metinleri (30 Metin)', yol: '/2019-yili-cte-uygulamali-sinav-metinleri/' },
];

const sss = [
  {
    soru: 'Zabıt kâtipliği uygulamalı klavye sınavında süre ve baraj kaçtır?',
    cevap: 'Adalet Bakanlığı Personel Genel Müdürlüğü (PGM) ve CTE değerlendirme kriterlerine göre uygulamalı sınav süresi 3 dakika (180 saniye) olup, adayların yanlışsız ve tekrarsız en az 90 net kelime yazması gerekmektedir.',
  },
  {
    soru: 'Anlam bütünlüğü ve atlanan kelime kuralları nasıl uygulanır?',
    cevap: '2025–2026 resmî değerlendirme kriterlerine göre yanlış yazılan kelime sayısının toplam yazılan kelime sayısına oranı %25’i aşarsa anlam bütünlüğü şartı sağlanmamış sayılır. Ayrıca ayrı ayrı veya peş peşe toplamda 22 ve üzeri kelime atlanması halinde aday başarısız sayılır.',
  },
  {
    soru: 'Sınavda F klavye mi Q klavye mi kullanılmalıdır?',
    cevap: 'Adaylar başvuru sırasında tercih ettikleri F veya Q klavye ile sınava girebilirler. 657.com.tr On Parmak çalışma ekranı her iki klavye düzeni için canlı parmak rehberi ve Daktilografi Kitabı dersleri sunar.',
  },
  {
    soru: 'Sınav metinlerinde büyük harf veya noktalama işareti var mıdır?',
    cevap: 'Güncel PGM ve CTE uygulamalı sınav metinlerinin tamamı küçük harfle hazırlanır, noktalama işareti ve paragraf içermez. Adaylar çalışırken İmlasız (Resmî), İmlasız (Özel) veya İmlalı modlardan dilediklerini seçebilir.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '657.com.tr On Parmak Klavye Sınavı ve Çalışma',
    description,
    url: new URL(path, site).href,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Tarayıcı',
    inLanguage: 'tr-TR',
    isAccessibleForFree: true,
    author: { '@id': `${site}/#kurucu` },
    publisher: { '@id': `${site}/#kurulus` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'tr-TR',
    mainEntity: sss.map((x) => ({
      '@type': 'Question',
      name: x.soru,
      acceptedAnswer: { '@type': 'Answer', text: x.cevap },
    })),
  },
];
---
<Kabuk {...kabukProps} jsonLd={jsonLd}>
  <header class="portal-sayfa-basligi">
    <div class="container">
      {!standalone && <nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span>/</span><a href="/araclar/">Araçlar</a><span>/</span><span>On Parmak</span></nav>}
      <div class="dir__head">
        <h1>On Parmak Klavye Sınavı ve Çalışma</h1>
        <p>Adalet Bakanlığı PGM ve CTE’nin 2019–2026 yılları arasında yayımladığı <strong>{klavyeOzet.toplamMetin} resmî metin</strong> ve Daktilografi Kitabı dersleriyle birebir sınav ekranında F ve Q klavye çalışın.</p>
        <p style="margin-top:.75rem">
          <a href={standalone ? 'https://657.com.tr/on-parmak/dersler/' : '/on-parmak/dersler/'} class="btn btn--quiet">F ve Q Klavye Dersleri (Sıfırdan Öğren) →</a>
        </p>
      </div>
    </div>
  </header>

  <div class="container page op-sayfa" id="op-sinav" data-onparmak data-op-odak={odak} data-gorunum="klasik" data-boyut="orta">
    <!-- Üst Kontrol Paneli (M5 Bilişim tarzı eksiksiz ayar çubuğu) -->
    <section class="panel op-ayarlar" aria-label="Sınav ve çalışma ayarları" data-solid>
      <div class="op-ayarlar__satir">
        <div class="op-alan">
          <label for="op-grup">Metin Arşivi / Ders</label>
          <select id="op-grup" data-op-grup aria-label="Metin grubu">
            {klavyeOzet.gruplar.map((g) => (
              <option value={g.id}>{g.baslik} ({g.adet} metin)</option>
            ))}
          </select>
        </div>
        <div class="op-alan">
          <label for="op-metin">Sınav Metni</label>
          <select id="op-metin" data-op-metin aria-label="Sınav metni">
            <option value="0">Metin 1</option>
          </select>
        </div>
        <div class="op-alan op-alan--butonlar">
          <button type="button" class="btn btn--quiet" data-op-rastgele>Rastgele metin</button>
          <button type="button" class="btn btn--quiet" data-op-ozel-ac>Özel metin</button>
        </div>
      </div>

      <div class="op-ozel-kutu" data-op-ozel-kutu hidden>
        <label for="op-ozel-metin">Kendi çalışma metninizi aşağıya yapıştırın:</label>
        <textarea id="op-ozel-metin" rows="4" data-op-ozel-metin placeholder="Çalışmak istediğiniz metni buraya yapıştırın (en az 5 kelime)..."></textarea>
        <div class="op-ozel-kutu__alt">
          <button type="button" class="btn btn--kucuk" data-op-ozel-uygula>Bu metni yükle</button>
        </div>
      </div>

      <div class="op-ayarlar__serit">
        <div class="op-grup-btn" role="group" aria-label="Sınav süresi">
          <span class="op-etiket">Süre:</span>
          {[
            { sn: 60, ad: '1:00' },
            { sn: 120, ad: '2:00' },
            { sn: 180, ad: '3:00' },
            { sn: 240, ad: '4:00' },
            { sn: 300, ad: '5:00' },
            { sn: 600, ad: '10:00' },
          ].map((s) => (
            <button type="button" class="op-pill" data-op-sure={s.sn} aria-pressed={s.sn === 180 ? 'true' : 'false'}>{s.ad}</button>
          ))}
        </div>

        <div class="op-grup-btn" role="group" aria-label="Yazım modu">
          <span class="op-etiket">Mod:</span>
          <button type="button" class="op-pill" data-op-mod="imlasiz" aria-pressed="true">İmlasız (Resmî)</button>
          <button type="button" class="op-pill" data-op-mod="imlasiz-ozel" aria-pressed="false">İmlasız (Özel)</button>
          <button type="button" class="op-pill" data-op-mod="imlali" aria-pressed="false">İmlalı</button>
        </div>

        <div class="op-grup-btn" role="group" aria-label="Görünüm modu">
          <span class="op-etiket">Ekran:</span>
          <button type="button" class="op-pill" data-op-gorunum="klasik" aria-pressed="true">Sınav Ekranı</button>
          <button type="button" class="op-pill" data-op-gorunum="akis" aria-pressed="false">Canlı Harf Takibi</button>
        </div>

        <div class="op-grup-btn" role="group" aria-label="Klavye düzeni">
          <span class="op-etiket">Klavye:</span>
          <button type="button" class="op-pill" data-op-klavye-duzen="f" aria-pressed="true">Türkçe F</button>
          <button type="button" class="op-pill" data-op-klavye-duzen="q" aria-pressed="false">Türkçe Q</button>
        </div>

        <div class="op-grup-btn" role="group" aria-label="Yazı boyutu">
          <span class="op-etiket">Yazı:</span>
          <button type="button" class="op-pill" data-op-boyut="kucuk" aria-pressed="false">A-</button>
          <button type="button" class="op-pill" data-op-boyut="orta" aria-pressed="true">A</button>
          <button type="button" class="op-pill" data-op-boyut="buyuk" aria-pressed="false">A+</button>
        </div>
      </div>

      <div class="op-ayarlar__secenekler">
        <label class="op-chk"><input type="checkbox" data-op-gerisayim-chk checked /> <span>5 sn sınav geri sayımı</span></label>
        <label class="op-chk"><input type="checkbox" data-op-hatagoster-chk checked /> <span>Yazarken hata vurgula</span></label>
        <label class="op-chk"><input type="checkbox" data-op-sanalklavye-chk checked /> <span>Sanal klavye ve parmak rehberi</span></label>
        <label class="op-chk"><input type="checkbox" data-op-ses-chk /> <span>Klavye sesi</span></label>
        <button type="button" class="btn btn--quiet btn--kucuk op-tamekran-btn" data-op-tamekran aria-pressed="false">Tam ekran</button>
      </div>
    </section>

    <!-- Ana Sınav Sahnesi -->
    <section class="panel op-sahne" data-op-sahne data-solid aria-label="Klavye sınav alanı">
      <!-- Canlı HUD -->
      <div class="op-hud">
        <div class="op-hud__sure">
          <span class="op-hud__etiket">Kalan Süre</span>
          <strong class="op-hud__deger num" data-op-kalan>03:00</strong>
        </div>
        <div class="op-hud__metrikler">
          <div><span>Doğru</span><strong class="num" data-op-c-dogru>0</strong></div>
          <div><span>Hata</span><strong class="num" data-op-c-yanlis>0</strong></div>
          <div class="op-hud__net"><span>Net</span><strong class="num" data-op-c-net>0</strong></div>
          <div><span>DKS</span><strong class="num" data-op-c-dks>0</strong></div>
          <div><span>Vuruş</span><strong class="num" data-op-c-vurus>0</strong></div>
          <div><span>Doğruluk</span><strong class="num" data-op-c-dogruluk>%100</strong></div>
        </div>
        <div class="op-hud__eylem">
          <button type="button" class="btn btn--kucuk" data-op-baslat>Başlat</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-op-duraklat disabled>Duraklat</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-op-bitir disabled>Bitir</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-op-sifirla>Sıfırla</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-op-ses-btn aria-pressed="false" title="Klavye tuş sesini aç/kapat">Ses: Kapalı</button>
          <button type="button" class="btn btn--kucuk op-tamekran-cik" data-op-tamekran-cik hidden title="Tam ekrandan çık (Esc)">✕ Tam Ekrandan Çık (Esc)</button>
        </div>
      </div>

      <div class="op-ilerleme-cubugu" aria-hidden="true"><div class="op-ilerleme-cubugu__ic" data-op-ilerleme></div></div>
      <div class="op-baraj" data-op-baraj aria-live="polite">
        <div class="op-baraj__ust">
          <span data-op-baraj-metin>Resmî 90 Kelime Barajı: 0 / 90 net</span>
          <span class="op-baraj__hedef">Baraj: 90 · Hedef: 120+</span>
        </div>
        <div class="op-baraj__ray" aria-hidden="true"><div class="op-baraj__dolgu" data-op-baraj-dolgu></div></div>
      </div>

      <div class="op-sahne__meta">
        <span data-op-kaynak-bilgi>Metin yükleniyor...</span>
        <span class="op-sahne__sayac" data-op-metin-sayac>Bu metin · Bugün: 0 · Hafta: 0 · Ay: 0 · Yıl: 0</span>
        <span class="op-sahne__ipucu">İlk harfe bastığınızda süre otomatik başlar · Kopyala-yapıştır kapalıdır</span>
      </div>

      <p class="op-yukleniyor" data-op-yukleniyor role="status">Resmî sınav metinleri arşivi yükleniyor…</p>

      <!-- 5 Saniye Geri Sayım Perdesi -->
      <div class="op-perde" data-op-perde hidden role="alert">
        <div class="op-perde__kutu">
          <p>Sınav başlıyor, ellerinizi temel sıraya yerleştirin</p>
          <strong class="num" data-op-perde-rakam>5</strong>
        </div>
      </div>

      <!-- Hedef Metin Penceresi (Adalet Bakanlığı Sınav Görünümü) -->
      <div class="op-hedef" data-op-hedef aria-live="off" tabindex="0"></div>

      <!-- Yazma Alanı -->
      <div class="op-giris-kap">
        <label class="visually-hidden" for="op-giris">Sınav yazma alanı</label>
        <textarea
          id="op-giris"
          class="op-giris"
          data-op-giris
          rows="5"
          spellcheck="false"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          placeholder="Yazmaya başladığınızda sınav otomatik başlar (veya üstten 'Başlat' düğmesine tıklayın)..."
        ></textarea>
      </div>

      <!-- Canlı Sanal Klavye ve On Parmak Rehberi -->
      <div class="op-parmak-ipucu" data-op-parmak-ipucu>Sıradaki tuş ve parmak rehberi yazmaya başladığınızda güncellenir.</div>
      <div class="op-kb" data-op-klavye aria-label="Sanal klavye ve on parmak rehberi"></div>
    </section>

    <!-- Detaylı Resmî Sonuç Tutanağı -->
    <section class="panel op-sonuc" data-op-sonuc hidden data-solid aria-live="polite"></section>

    <!-- Kişisel Çalışma Geçmişi -->
    <section class="panel op-gecmis-panel" data-solid aria-labelledby="op-gecmis-baslik">
      <div class="panel__head">
        <h2 id="op-gecmis-baslik">Çalışma Geçmişiniz (Yalnız Bilgisayarınızda Saklanır)</h2>
        <div class="op-gecmis-eylem">
          <button type="button" class="btn btn--quiet btn--kucuk" data-op-gecmis-indir hidden>CSV İndir</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-op-gecmis-temizle hidden>Geçmişi temizle</button>
        </div>
      </div>
      <div class="op-gecmis" data-op-gecmis></div>
    </section>

    <!-- En Zor Metinler ve Yazım İstatistikleri -->
    <section class="panel op-zor-panel" data-solid aria-labelledby="op-zor-baslik">
      <div class="panel__head">
        <h2 id="op-zor-baslik">En Zor Sınav Metinleri ve Yazım Sayıları</h2>
        <span class="op-zor-alt">Hata oranına ve metin zorluğuna göre sıralanır</span>
      </div>
      <div class="op-zor" data-op-zor></div>
    </section>

    <!-- Zamanlı Canlı Klavye Sınavı ve Sıralama (Leaderboard) -->
    <section class="panel op-canli-panel" id="op-canli-sinav" data-op-canli-root data-solid aria-labelledby="op-canli-baslik">
      <div class="panel__head">
        <h2 id="op-canli-baslik">Zamanlı Canlı Klavye Sınavı ve Sıralama (Leaderboard)</h2>
        <span class="op-zor-alt" data-cs-durum>Yükleniyor…</span>
      </div>
      <div class="op-arsiv__govde">
        <div class="cs-liste" data-cs-liste></div>
        <details class="cs-admin-kutu">
          <summary>Yönetici: Yeni Zamanlı Canlı Klavye Sınavı Planla</summary>
          <form class="op-admin-form" data-cs-admin-form>
            <div class="op-ayarlar__satir">
              <div class="op-alan"><label>Yönetici Anahtarı<input type="password" name="adminKey" required placeholder="Admin anahtarı" /></label></div>
              <div class="op-alan"><label>Sınav Başlığı<input type="text" name="baslik" required minlength="5" placeholder="Örn: 2026 Zabıt Kâtipliği Haftalık 3 Dk Canlı Sınav" /></label></div>
              <div class="op-alan"><label>Başlangıç (TR)<input type="datetime-local" name="baslangic" required /></label></div>
              <div class="op-alan"><label>Bitiş (TR)<input type="datetime-local" name="bitis" required /></label></div>
            </div>
            <div class="op-alan"><label>Açıklama / Sınav Kıstası<input type="text" name="aciklama" placeholder="Örn: 2026 PGM metinleri · 3 dk · 90 net kelime barajı" /></label></div>
            <input type="hidden" name="kriter" value="3 dk 90 kelime barajlı canlı sınav" />
            <div style="display:flex;gap:10px;align-items:center;margin-top:8px;">
              <button type="submit" class="btn btn--kucuk">Canlı Sınavı Yayınla</button>
              <span data-cs-admin-mesaj style="font-size:13px;font-weight:600;"></span>
            </div>
          </form>
        </details>
      </div>
    </section>

    <!-- Yıllara Göre Resmî Sınav Metinleri Arşivi -->
    <section class="panel op-arsiv" id="op-arsiv" data-solid aria-labelledby="op-arsiv-baslik">
      <div class="panel__head">
        <h2 id="op-arsiv-baslik">Yıllara Göre Resmî PGM ve CTE Sınav Metinleri Arşivi</h2>
        <button type="button" class="btn btn--kucuk" data-op-paket-indir>Seçili Sınav Metinlerini İndir (.txt)</button>
      </div>
      <div class="op-arsiv__govde">
        <p>Adalet Bakanlığı Personel Genel Müdürlüğü (PGM) ve Ceza ve Tevkifevleri Genel Müdürlüğü (CTE) tarafından yayımlanan tüm uygulamalı sınav metinlerini yıllara göre tek sayfada okuyabilir, seçili sınav grubunu çevrimdışı çalışma paketi olarak indirebilir veya doğrudan klavye ekranında çalışabilirsiniz:</p>
        <ul class="op-arsiv__liste">
          {yilArsivleri.map((y) => (
            <li>
              <a href={standalone ? `https://657.com.tr${y.yol}` : y.yol}>
                <span class="op-arsiv__yil num">{y.yil}</span>
                <strong>{y.ad}</strong>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Resmî Değerlendirme Kriterleri Özeti -->
    <section class="panel op-kriterler" id="op-kriterler" data-solid aria-labelledby="op-kriter-baslik">
      <div class="panel__head">
        <h2 id="op-kriter-baslik">Adalet Bakanlığı Uygulamalı Sınav Değerlendirme Kriterleri</h2>
      </div>
      <div class="prose op-kriterler__ic">
        <p>Uygulamalı sınav sonuç tutanağında hem kelime bazlı hem vuruş bazlı sonuç yer alır; değerlendirmede <strong>kelime bazlı sonuç</strong> esas alınır:</p>
        <ul>
          <li><strong>Süre ve Baraj:</strong> 3 dakika (180 saniye) içinde yanlışsız ve tekrarsız en az <strong>90 net kelime</strong>.</li>
          <li><strong>Anlam Bütünlüğü:</strong> Yanlış yazılan kelime sayısının toplam yazılan kelime sayısına oranı <strong>%25’ten fazla</strong> ise anlam bütünlüğü şartı sağlanmamış sayılır.</li>
          <li><strong>Atlanan Kelime Sınırı:</strong> Ayrı ayrı veya peş peşe toplamda <strong>22 ve üzeri kelime</strong> atlanması halinde yazılan kelime sayısına bakılmaksızın sınav başarısız sayılır.</li>
          <li><strong>Hata Türleri:</strong> Fazla vuruş, eksik vuruş, harf yer değiştirme, karakter hatası, kelime bölme, kelime birleştirme, fazla boşluk ve karışık hata ayrı ayrı tespit edilir.</li>
        </ul>
      </div>
    </section>

    <!-- SSS -->
    <section class="panel" data-solid aria-labelledby="op-sss-baslik">
      <div class="panel__head"><h2 id="op-sss-baslik">Sık sorulan sorular</h2></div>
      <div class="sss__liste">
        {sss.map((x) => (
          <details class="sss__madde"><summary>{x.soru}</summary><p>{x.cevap}</p></details>
        ))}
      </div>
    </section>
  </div>

  <script>import '../scripts/on-parmak';</script>
</Kabuk>

<style>
.op-sayfa{display:grid;gap:var(--space-lg);}
.op-ayarlar{padding:var(--space-md) var(--space-lg);display:grid;gap:var(--space-md);}

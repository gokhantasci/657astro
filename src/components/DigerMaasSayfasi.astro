---
import {donemAylari} from '../lib/maas-donemi';
import Layout from '../layouts/Layout.astro';
import Alan from './MaasAlan.astro';
import Bolum from './MaasBolum.astro';
import { sozlesmeliMaas, sozlesmeliOncekiMatrah, emekliMaas } from '../lib/diger-maas';
import { donem, dereceler, parametreler, maasKatsayilari, secenekler, buAy } from '../lib/maas-veri';
import { ayarlar } from '../lib/settings';
import { sozlesmeliTarife } from '../lib/sozlesmeli-tarife';
import { z } from 'zod';
import raw from '../data/sozlesmeli-unvanlar.json';
import { tl, katsayi, donemAraligi, gun } from '../lib/bicim';
import MaasTahmini from './MaasTahmini.astro';
import {varsayilanMaasTahmini as tahmin} from '../lib/maas-tahmini-veri';
import {tahminKatsayilari,tahminVergiGirdisi} from '../lib/maas-tahmini';
interface Props { tur:'sozlesmeli'|'emekli' }
const {tur}=Astro.props;
const soz=tur==='sozlesmeli';
const ucretSemasi=z.object({ucret:z.number().nonnegative(),ekOdemeOran:z.number().nonnegative()});
const unvanlar=z.array(z.object({id:z.string(),ad:z.string().min(1),adalet:z.boolean().optional(),varsayilanVaryant:z.string().optional(),varyantlar:z.array(z.object({id:z.string(),ad:z.string(),yillar:z.array(ucretSemasi.nullable()).length(26)})).min(1)})).parse(raw.unvanlar);
const title=soz?'Sözleşmeli memur maaş hesaplama':'Emekli memur maaş hesaplama';
const path=soz?'/sozlesmeli-memur-maas-hesaplama/':'/emekli-memur-maas-hesaplama/';
const description=soz?'Sözleşme ücreti, ek ödeme, aile yardımları ve kesintilere göre sözleşmeli personel maaşı hesabı.':'Unvan, kadro ve emekliliğe esas derece, hizmet yılı ve ayına göre 5434 sayılı Kanuna tabi memurun emekli aylığı, emekli ikramiyesi ve emeklilik tazminatı.';
const k=maasKatsayilari(donem,'maas');
const donemler=ayarlar.donemler.filter(d=>d.baslangic.slice(0,4)===donem.baslangic.slice(0,4)).map(d=>({id:d.baslangic,ad:donemAraligi(d),aylar:donemAylari(d),k:maasKatsayilari(d,'maas')}));
const ilkUnvan=unvanlar.find(u=>u.id==='58')!;
const ilkVaryant=ilkUnvan.varyantlar.find(v=>v.id===ilkUnvan.varsayilanVaryant)??ilkUnvan.varyantlar[0];
const ayKatsayilari=Array.from({length:12},(_,i)=>{const ay=i+1,tarih=`${donem.baslangic.slice(0,4)}-${String(ay).padStart(2,'0')}-15`;const d=ayarlar.donemler.find(d=>d.baslangic<=tarih&&d.bitis>=tarih);return d?{ay,k:maasKatsayilari(d,'maas')}:null;}).filter(a=>a!==null);
const sg={ay:buAy(donem),...sozlesmeliTarife(ilkUnvan,ilkVaryant.id,0,k.aylik,raw.aylikKatsayi),...(ilkUnvan.adalet?{ekTabanGosterge:parametreler.sozlesmeli_ek_taban_gosterge,ekOdemeArtis:parametreler.gorev_yeri_buyuksehir_oran}:{}),esCalismiyor:false,sendika:false,kucuk:0,buyuk:0,engelliKucuk:0,engelliBuyuk:0,oncekiMatrah:0};
sg.oncekiMatrah=sozlesmeliOncekiMatrah(sg,1,k,ayKatsayilari,parametreler);
// EMIHEP'in açılış örneği: öğretmen, kadro ve emekliliğe esas derece 1/4, 25 yıl.
const eg={unvan:50,kadroDerece:'1/4',derece:'1/4',mezuniyet:1 as const,hizmetYili:25,hizmetAyi:0,kidemYili:25,ikramiyeYili:25};
const emekliUnvanlar=[...secenekler.unvanlar].sort((a,b)=>a.ad.localeCompare(b.ad,'tr')).map(u=>({value:u.kod,label:u.ad}));
const aylar=Array.from({length:12},(_,value)=>({value,label:String(value)}));
const r=soz?sozlesmeliMaas(sg,k,parametreler):emekliMaas(eg,k,parametreler,dereceler);
const er=emekliMaas(eg,k,parametreler,dereceler);
const kt=tahminKatsayilari(k,tahmin);
const gelecek=soz?sozlesmeliMaas({...tahminVergiGirdisi(sg,tahmin,Number(donem.baslangic.slice(0,4))),ucret:Math.round(sg.ucret*kt.aylik/k.aylik*100)/100},kt,parametreler):emekliMaas(eg,kt,parametreler,dereceler);
const sayilar=Array.from({length:11},(_,value)=>({value,label:String(value)}));
const evetHayir=[{value:0,label:'Hayır'},{value:1,label:'Evet'}];
const veri={tur,k,parametreler,dereceler,unvanlar,kaynakAylik:raw.aylikKatsayi,ayKatsayilari,donemler};
---
<Layout title={`${title} | 657.com.tr`} description={description} path={path} jsonLd={[{'@context':'https://schema.org','@type':'WebApplication',name:title,description,url:new URL(path,Astro.site).href,applicationCategory:'FinanceApplication',operatingSystem:'Tarayıcı',inLanguage:'tr-TR',isAccessibleForFree:true}]}>
 <header class="portal-sayfa-basligi"><div class="container"><nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span aria-hidden="true">/</span><a href="/araclar/?alan=maas">Maaş ve yolluk</a></nav><div class="portal-sayfa-basligi__satir"><div class="dir__head"><h1>{title}</h1><p>{description}</p></div></div></div></header>
 <div class="container page">
  
  <div class="arac">
   <section class="panel" data-solid><div class="panel__head"><h2>Hesap bilgileri</h2><button type="button" class="btn btn--quiet btn--kucuk" data-d-sifirla>Sıfırla</button></div>
    <form id="diger-maas-form" class="maas-form maas-form--bolumlu">
     {soz ? <>
      <Bolum no={0} baslik="Hesaplama seçenekleri" aciklama="Katsayı dönemi ve ücret yöntemi" alanlar={['butceDonemi','ucretYontemi']}>
       <div class="maas-form__grid">
        <Alan id="butceDonemi" label="Bütçe / katsayı dönemi" value={donem.baslangic} options={donemler.map(d=>({value:d.id,label:d.ad}))}/>
        <Alan id="ucretYontemi" label="Ücret ve ek ödeme" value="otomatik" options={[{value:'otomatik',label:'Unvan ve hizmet yılına göre otomatik'},{value:'elle',label:'Sözleşmedeki ücret ve oranı elle gir'}]}/>
       </div>
      </Bolum>
      <Bolum no={1} baslik="Unvan, sözleşme ve aile" aciklama="Unvan, öğrenim, hizmet yılı, ücret, aile ve sendika" alanlar={['unvan','varyant','gorevYeri','hizmetYili','ucret','ekOdemeOran','esCalismiyor','kucuk','buyuk','sendika']} acik>
       <div class="maas-form__grid">
        <div class="maas-tam"><Alan id="unvan" label="Unvan" value={ilkUnvan.id} options={unvanlar.map(u=>({value:u.id,label:u.ad}))}/></div>
        <div class="maas-tam"><Alan id="varyant" label="Öğrenim / kurum / görev koşulu" value={ilkVaryant.id} options={ilkUnvan.varyantlar.map(v=>({value:v.id,label:v.ad}))}/></div>
        <div class="maas-tam" data-d-adalet hidden={!ilkUnvan.adalet}><Alan id="gorevYeri" label="Adliyenin bulunduğu il (ek ödeme artışı)" value="buyuksehir" options={[{value:'istanbul',label:`İstanbul / Ankara / İzmir (+${parametreler.gorev_yeri_istanbul_oran} puan)`},{value:'buyuksehir',label:`Diğer büyükşehirler (+${parametreler.gorev_yeri_buyuksehir_oran} puan)`},{value:'diger',label:`Diğer iller (+${parametreler.gorev_yeri_diger_oran} puan)`}]}/></div>
        <div class="maas-bes-satir"><Alan id="hizmetYili" label="Hizmet yılı" value={0} min={0} max={50}/><Alan id="sendika" label="Sendika üyeliği" value={0} options={evetHayir}/></div>
        <div class="maas-bes-satir"><Alan id="ucret" label="Brüt sözleşme ücreti (TL)" type="text" value={String(sg.ucret).replace('.',',')}/><Alan id="ekOdemeOran" label="Ek ödeme oranı (%)" type="text" value={sg.ekOdemeOran}/></div>
        <Alan id="esCalismiyor" label="Eş yardımı alıyor musunuz?" value={0} options={evetHayir}/>
        <div class="maas-bes-satir"><Alan id="kucuk" label="72 aydan küçük çocuk" value={0} options={sayilar}/><Alan id="buyuk" label="72 ay ve üzeri çocuk" value={0} options={sayilar}/></div>
        <div class="maas-bes-satir"><Alan id="engelliKucuk" label="72 aydan küçük engelli çocuk" value={0} options={sayilar}/><Alan id="engelliBuyuk" label="72 ay ve üzeri engelli çocuk" value={0} options={sayilar}/></div>
       </div><p class="maas-not">Engelli çocukları yalnızca engelli çocuk alanında sayın.</p>
      </Bolum>
      <Bolum no={2} baslik="Ek ödemeler ve kesintiler" aciklama="BES, İLKSAN ve diğer kesintiler" alanlar={['besOran','ilksan','digerKesinti']}>
       <div class="maas-form__grid">
        <Alan id="besOran" label="BES kesintisi" value={0} options={[{value:0,label:'Yok'},...Array.from({length:98},(_,i)=>({value:i+3,label:`%${i+3}`}))]}/>
        <Alan id="ilksan" label="İLKSAN aidatı" value={0} options={[{value:0,label:'Yok'},{value:1,label:'Tek aidat'},{value:2,label:'Terfi ayı çift aidat'}]}/>
        <Alan id="digerKesinti" label="İcra / nafaka / diğer net kesinti (TL)" type="text" value={0}/>
       </div>
      </Bolum>
      <Bolum no={3} baslik="Vergi ve gelişmiş seçenekler" aciklama="Ödeme ayı, kümülatif matrah, istisnalar ve engellilik" alanlar={['ay','sozlesmeAyi','oncekiMatrah','engellilikDerecesi']}>
       <div class="maas-form__grid">
        <Alan id="ay" label="Ödeme ayı" value={sg.ay} options={donemAylari(donem)}/>
        <Alan id="sozlesmeAyi" label="Bu yıl işe başlama / matrah başlangıç ayı" value={1} options={Array.from({length:12},(_,i)=>({value:i+1,label:new Intl.DateTimeFormat('tr-TR',{month:'long'}).format(new Date(2026,i,1))}))}/>
        <Alan id="matrahYontemi" label="Önceki kümülatif matrah" value="otomatik" options={[{value:'otomatik',label:'Sözleşme ayından itibaren hesapla'},{value:'elle',label:'Bordrodaki matrahı elle gir'}]}/>
        <Alan id="oncekiMatrah" label="Önceki kümülatif GV matrahı (TL)" type="text" value={String(sg.oncekiMatrah).replace('.',',')}/>
        <Alan id="kullanilanGv" label="Bu ay kullanılan GV istisnası (TL)" type="text" value={0}/>
        <Alan id="kullanilanDv" label="Bu ay kullanılan DV istisnası (TL)" type="text" value={0}/>
        <Alan id="engellilikDerecesi" label="Engellilik vergi indirimi" value={0} options={[{value:0,label:'Yok'},{value:1,label:'1. derece'},{value:2,label:'2. derece'},{value:3,label:'3. derece'}]}/>
       </div>
      </Bolum>
     </> : <>
      <Bolum no={0} baslik="Hesaplama seçenekleri" aciklama="Katsayı dönemi, mezuniyet ve unvan koşulu" alanlar={['butceDonemi','unvanKosulu','mezuniyet']}>
       <div class="maas-form__grid">
        <Alan id="butceDonemi" label="Bütçe / katsayı dönemi" value={donem.baslangic} options={donemler.map(d=>({value:d.id,label:d.ad}))}/>
        <Alan id="unvanKosulu" label="Öğrenim / kurum / görev koşulu" value="" options={[{value:'',label:'Unvanın varsayılan koşulu'}]}/>
        <Alan id="mezuniyet" label="Mezuniyet" value={eg.mezuniyet} options={[{value:1,label:'Önlisans veya lisans'},{value:2,label:'Lise ve diğerleri'}]}/>
       </div>
      </Bolum>
      <Bolum no={1} baslik="Kadro ve derece" aciklama="Unvan, kadro derecesi ve emekliliğe esas derece" alanlar={['unvan','kadroDerece','derece']} acik>
       <div class="maas-form__grid">
        <div class="maas-tam"><Alan id="unvan" label="Kadro (görev) unvanı" value={eg.unvan} options={emekliUnvanlar}/></div>
        <Alan id="kadroDerece" label="Kadro derece / kademe (KHA)" value={eg.kadroDerece} options={dereceler.map(d=>({value:d.derece,label:d.derece}))}/>
        <Alan id="derece" label="Emekliliğe esas derece / kademe (EKEA)" value={eg.derece} options={dereceler.map(d=>({value:d.derece,label:d.derece}))}/>
       </div>
      </Bolum>
      <Bolum no={2} baslik="Hizmet süreleri" aciklama="Fiilî hizmet, kıdem ve ikramiyeye esas yıl" alanlar={['hizmetYili','hizmetAyi','kidemYili','ikramiyeYili']} acik>
       <div class="maas-form__grid">
        <div class="maas-bes-satir"><Alan id="hizmetYili" label="Fiilî hizmet yılı" value={eg.hizmetYili} min={0} max={50}/><Alan id="hizmetAyi" label="Fiilî hizmet ayı" value={eg.hizmetAyi} options={aylar}/></div>
        <div class="maas-bes-satir"><Alan id="kidemYili" label="Kıdeme esas hizmet yılı" value={eg.kidemYili} min={0} max={60}/><Alan id="ikramiyeYili" label="İkramiyeye esas yıl" value={eg.ikramiyeYili} min={0} max={60}/></div>
       </div>
      </Bolum>
     </>}
     <p class="arac__hata" data-d-hata role="alert" hidden></p><button class="btn" type="submit">Hesapla</button>
     <noscript><p>Bilgileri değiştirmek için JavaScript'i etkinleştirin. Görünen sonuç varsayılan örnektir.</p></noscript>
    </form>
   </section>
   <div class="maas-ozet-grubu"><section class="panel sonuc" data-solid><div class="panel__head"><h2>Sonuç</h2></div>
    <div class="sonuc__ana" role="status" aria-live="polite"><p class="sonuc__etiket">{soz?'Net aylık maaş':'Emekli aylığı'}</p><p class="sonuc__deger num" data-d-net>{tl(r.net)}</p></div>
    <dl class="sonuc__satirlar">
     <div><dt>{soz?'Gelirler toplamı':'Bağlama öncesi toplam'}</dt><dd class="num" data-d-gelir>{tl(r.gelir)}</dd></div>
     {soz ? <div><dt>Kesintiler toplamı</dt><dd class="num" data-d-kesinti>{tl('kesinti' in r?r.kesinti:0)}</dd></div> : <>
      <div><dt>Aylık bağlama oranı</dt><dd class="num" data-d-baglama>%{(er.baglama*100).toLocaleString('tr-TR',{maximumFractionDigits:2})}</dd></div>
      <div><dt>Ek gösterge · özel hizmet oranı</dt><dd class="num" data-d-ekGosterge>{er.ekGosterge} · %{er.ozelHizmetOrani}</dd></div>
      <div><dt>Emekli ikramiyesi</dt><dd class="num" data-d-ikramiye>{tl(er.ikramiye)}</dd></div>
      <div><dt>Emeklilik tazminatı (yolluk, net)</dt><dd class="num" data-d-yolluk>{tl(er.yolluk)}</dd></div>
     </>}
     {soz&&<div><dt>Önceki kümülatif GV matrahı</dt><dd class="num" data-d-matrah>{tl(sg.oncekiMatrah)}</dd></div>}
     <div><dt>Aylık katsayısı</dt><dd class="num" data-d-katsayi>{katsayi(k.aylik)}</dd></div>
    </dl>
   </section>
   <MaasTahmini net={gelecek.net} ikramiye={'ikramiye' in gelecek?gelecek.ikramiye:undefined} vergi={soz} not={soz?'Sözleşme ücreti katsayıyla aynı oranda artırılmıştır.':'Aylık ve ikramiye aynı hizmet bilgileriyle yeniden hesaplanır.'}/></div>
  </div>
  <section class="panel" data-solid><div class="panel__head"><h2>{soz?'Gelir ve kesinti dökümü':'Emekli aylığı dökümü (bağlama oranı uygulanmış)'}</h2></div><div class="maas-tablo"><table class="grid grid--sayi"><thead><tr><th scope="col">Kalem</th><th scope="col">Oran</th><th scope="col">Tutar</th></tr></thead><tbody data-d-satirlar>{r.satirlar.map(s=><tr><th scope="row">{s.ad}</th><td class="num">{s.oran||'—'}</td><td class="num">{tl(s.tutar)}</td></tr>)}</tbody></table></div></section>
  <section class="panel" data-solid><div class="panel__head"><h2>Hesap hakkında</h2></div><div class="prose prose--kisa">
   <p>Katsayı dönemi: {donemAraligi(donem)}. Kaynak: {donem.kaynak}.</p>
   {soz&&<p>Seyyanen ilave ve aylık sendika ikramiyesi damga vergisine tabidir; seçili yüzde aidatın matrahında da yer alır. 2026–2027 aylık sendika ikramiyesi 707 göstergedir.</p>}
   {soz&&<p>Adalet Bakanlığı zabıt katibi seçildiğinde sözleşme ücretine ek olarak {parametreler.sozlesmeli_ek_taban_gosterge} gösterge karşılığı ek taban aylık ödenir ve ek ödeme oranı adliyenin bulunduğu ile göre artar (İstanbul, Ankara, İzmir +{parametreler.gorev_yeri_istanbul_oran}; diğer büyükşehirler +{parametreler.gorev_yeri_buyuksehir_oran}; diğer iller +{parametreler.gorev_yeri_diger_oran} puan). Ek taban aylık emekli keseneği, GSS, gelir ve damga vergisi matrahına girer. Sözleşme ücretinin kendisi kurumun sözleşmesinde belirlenir ve yayımlanmış resmî bir tutar cetveli yoktur; cetveldeki rakam örnektir, bordronuzdaki tutarı "Sözleşmedeki ücret ve oranı elle gir" seçeneğiyle yazın. Ocak 2026 ve Temmuz 2026 genelgelerinin katsayıları ortak ayarlarla aynıdır.</p>}
   {soz?<><p>Ücret cetveli, <a href="https://www.memurlar.net/maas/sozlesmeli/" target="_blank" rel="noopener noreferrer">Memurlar.net sözleşmeli maaş hesabındaki</a> unvan, öğrenim, kurum ve hizmet yılı seçenekleriyle karşılaştırılmıştır ({gun(raw.tarih)}). {unvanlar.length} unvan seçilebilir. Ücretler ortak aylık katsayısındaki değişim oranıyla güncellenir; ek ödeme oranları cetvelden gelir.</p><p>Gelir vergisi; sözleşme ücretinden çalışan primleri, sendika aidatı ve engellilik indirimi düşülerek, önceki matrah ve ayın asgari ücret istisnasıyla hesaplanır. Otomatik matrah aynı sözleşme ve kişisel bilgilerin önceki aylarda da geçerli olduğunu varsayar; önceki ayların ortak katsayılarını kullanır. İşe giriş, ücret değişikliği veya farklı kesintiler varsa bordrodaki önceki matrahı elle girin. BES ve İLKSAN net kesintidir; prim tavanı dikkate alınır.</p><p>Kişisel sözleşmeniz farklıysa ücret ve oranı elle girebilirsiniz. Kaynakta bulunmayan hizmet yılı/koşul birleşimleri için otomatik tutar üretilmez. Eksik gün, rapor, nöbet, döner sermaye ve kuruma özel ilave ödemeler bu tam ay hesabında yer almaz. 25 yıl üzerindeki hizmette cetvelin son basamağı kullanılır.</p></>:<p>Mevcut sitenin 5434 esaslı hesabı kullanılır: bağlama oranı (50 + hizmet yılı) / 100, kıdem en fazla 25 yıldır. 5510 kapsamındaki kişisel prim ve hizmet dökümüne dayalı emekli aylığını hesaplamaz. İkramiyenin brüt ve ek ödeme hariç tutarları ayrı gösterilir.</p>}
   {!soz && <>
    <section class="emekli-ikramiye" aria-labelledby="ikramiye-title"><h3 id="ikramiye-title">Emekli ikramiyesi dökümü</h3>
     <table class="grid grid--sayi"><tbody>
      <tr><th scope="row">Aylık ikramiye (gösterge + ek gösterge + özel hizmet) × yıl</th><td class="num" data-d-ikramiyeAylik>{tl(er.ikramiyeAylik)}</td></tr>
      <tr><th scope="row">Taban ikramiye</th><td class="num" data-d-ikramiyeTaban>{tl(er.ikramiyeTaban)}</td></tr>
      <tr><th scope="row">Kıdem ikramiyesi</th><td class="num" data-d-ikramiyeKidem>{tl(er.ikramiyeKidem)}</td></tr>
      <tr><th scope="row">Emeklilik tazminatı: {parametreler.emekli_yolluk_tazminat_gosterge.toLocaleString('tr-TR')} gösterge, damga vergisi {tl(er.yollukDamga)}</th><td class="num">{tl(er.yollukBrut)}</td></tr>
     </tbody></table>
    </section>
    <p>Hesap, 01.10.2008 öncesi göreve başlayan (5434 sayılı Kanun'a tabi) memurlar içindir. Gösterge emekliliğe esas derece ve kademeden, ek gösterge kadro derecesinden ve unvandan alınır. Bağlama oranı %50 + fiilî hizmet yılı (ay/12 dahil) olup %100'ü geçemez. Özel hizmet aylığında 7417 sayılı Kanunla güncellenen ortak yedi basamaklı cetvel kullanılır: 2800 altı %55, 2800'den itibaren %85, 3600'den %145, 5400'den %165, 7000'den %195, 7800'den %215, 8400'den %255. İkramiyede yalnızca tam yıllar sayılır. Sonuçlar OzkanSoft EMIHEP ve Memurlar.net emekli maaşı hesabıyla sağlanmıştır. Makam, temsil ve görev tazminatı alan üst düzey kadrolar ile 5510'a tabi memurların aylık bağlama sistemi bu hesapta yer almaz. Subaylar için <a href="/asker-emekli-maasi-hesaplama/">asker emekli maaşı hesabını</a> kullanabilirsiniz.</p>
   </>}
   <p>Sonuç bilgilendirme amaçlıdır; resmî bordro ve SGK hesabı esas alınır.</p>
  </div></section>
 </div>
 <script type="application/json" id="diger-maas-veri" set:html={JSON.stringify(veri).replace(/</g,'\\u003c')}/>
</Layout>
<script>import '../scripts/diger-maas';import '../scripts/maas-bolum-ozet';</script>

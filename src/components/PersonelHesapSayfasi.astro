---
import Layout from '../layouts/Layout.astro';
import Alan from './MaasAlan.astro';
import raw from '../data/personel-kurallari.json';
import {z} from 'zod';
import {ikmBoyKilo,yillikIzin} from '../lib/personel-hesap';
import {gun} from '../lib/bicim';
interface Props{tur:'izin'|'ikm'}
const {tur}=Astro.props,izin=tur==='izin';
const n=z.number().nonnegative(),kurallar=z.object({izin:z.object({birYil:n,besYilUstu:n,onBesYil:n,gencYas:n,ileriYas:n,yasAsgari:n,yerAltiEk:n,kaynak:z.url()}),ikm:z.object({erkekMin:n,kadinMin:n,eksik:n,fazla:n,kaynak:z.url()})}).parse(raw);
const title=izin?'İşçi yıllık izin hesaplama':'İKM boy-kilo hesaplama',path=izin?'/yillik-izin-hesaplama/':'/infaz-ve-koruma-memuru-boy-kilo-hesaplama/';
const description=izin?'4857 kapsamındaki işçinin tamamlanan hizmet yılı, yaş ve yer altı işi durumuna göre dönemlik asgari izin ve kalan gün hesabı.':'İnfaz ve koruma memurluğunda ilan edilen boy ve kilo aralığını birlikte kontrol edin.';
const bugun=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Istanbul',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
const baslangic={giris:'2020-03-15',tarih:bugun,yas:35,yerAlti:false,kullanilan:5,devreden:0},ir=yillikIzin(baslangic,kurallar.izin),br=ikmBoyKilo({cinsiyet:'erkek',boy:175,kilo:70},kurallar.ikm);
const alanlar=izin?[{id:'yas',ad:'İzin hakkına esas yaş',deger:35},{id:'yerAlti',ad:'Yer altı işi mi?',deger:0,secenekler:[{value:0,label:'Hayır'},{value:1,label:'Evet'}]},{id:'kullanilan',ad:'Bu dönemde kullanılan gün',deger:5},{id:'devreden',ad:'Kayıtlı devreden izin (gün)',deger:0}]:[{id:'cinsiyet',ad:'İlanda belirtilen kategori',deger:'erkek',secenekler:[{value:'erkek',label:'Erkek'},{value:'kadin',label:'Kadın'}]},{id:'boy',ad:'Boy (cm, tam sayı)',deger:175},{id:'kilo',ad:'Kilo (kg)',deger:70}];
---
<Layout title={`${title} | 657.com.tr`} description={description} path={path}><div class="container page"><nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span>/</span><a href="/araclar/">Araçlar</a></nav><div class="dir__head"><h1>{title}</h1><p>{description}</p></div><div class="arac"><section class="panel" data-solid><div class="panel__head"><h2>Hesap bilgileri</h2><button type="button" class="btn btn--quiet btn--kucuk" data-ph-sifirla>Sıfırla</button></div><form class="maas-form" id="personel-hesap">
{izin&&<div class="maas-form__grid"><div class="maas-alan"><label for="giris">İşe giriş tarihi</label><input id="giris" name="giris" type="date" value={baslangic.giris} required/></div><div class="maas-alan"><label for="tarih">Hesap tarihi</label><input id="tarih" name="tarih" type="date" value={bugun} required/></div></div>}{alanlar.map(a=><Alan id={a.id} label={a.ad} value={a.deger} options={a.secenekler} type="text"/>)}<p class="arac__hata" data-ph-hata role="alert" hidden></p><button class="btn" type="submit">Hesapla</button></form></section><section class="panel sonuc" data-solid><div class="panel__head"><h2>Sonuç</h2></div><div class="sonuc__ana" role="status" aria-live="polite"><p class="sonuc__etiket">{izin?'Kalan izin':'Boy / kilo kontrolü'}</p><p class="sonuc__deger num" data-ph-ana>{izin?`${ir.kalan} gün`:br.uygun?'Aralık içinde':'Aralık dışında'}</p><p class="sonuc__aciklama" data-ph-not>{izin?`${ir.yil} tam yıl · Dönemlik asgari hak ${ir.hak} gün`:`Asgari boy ${br.asgari} cm · Kilo aralığı ${br.alt}–${br.ust} kg`}</p><p class="sonuc__aciklama" data-ph-ek>{izin?`Sonraki yıl dönümü: ${gun(ir.sonraki)}`:'İlanın yalnız boy/kilo koşulları değerlendirilir.'}</p></div></section></div>
<section class="panel" data-solid><div class="panel__head"><h2>Hesap hakkında</h2></div><div class="prose prose--kisa">{izin?<><p><a href={kurallar.izin.kaynak}>Yıllık Ücretli İzin Yönetmeliği</a> uyarınca tamamlanan 1–5 yıl için 14, 6–14 yıl için 20, 15 yıl ve üzeri için 26 gün asgari izin hesaplanır. 18 yaş ve altı ile 50 yaş ve üzeri için asgari 20 gün; yer altı işinde ayrıca 4 gün uygulanır. Bir tam yıl dolmadan bu dönem için yeni hak eklenmez.</p><p>İzne hak kazanma tarihine esas yaşı girin. Hesap kesintisiz hizmet varsayar; birleştirilecek hizmet, çalışılmış sayılmayan süre, mevsimlik iş ve sözleşme/TİS ile verilen ek günler otomatik belirlenmez. Önceki yıllar biriktirilmez; izin kayıt belgesindeki devreden gün girilebilir. Kullanılan gün hakkı aşarsa fark ayrıca gösterilir. Tatil takvimiyle izin dönüş tarihi veya izin ücreti hesaplanmaz. 657'ye tabi memurların yıllık izni farklı kurala tabidir.</p><p>29 Şubat başlangıcında artık olmayan yıldaki yıl dönümü ayın son günüyle alınır. Kaynak Saffet Çelik'teki dönemlik izin örneğiyle karşılaştırılmıştır.</p></>:<><p><a href={kurallar.ikm.kaynak}>05-06-2026 tarihli CTE ilanındaki</a> eşikler kullanılır: erkeklerde 170, kadınlarda 160 cm; boyun son iki rakamına göre −17/+13 kg aralığı, sınırlar dahil. Örneğin 175 cm için 58–88 kg. Bu ekran 100–199 cm tam sayı boy girişlerini kapsar; kilo virgüllü girilebilir.</p><p>Sonuç, girilen sayıların ilan aralığıyla matematik karşılaştırmasıdır. Sağlık kurulu, KPSS, yaş, öğrenim ve diğer başvuru koşullarını değerlendirmez. Resmî ölçüm sonucu esas alınır; kilo alma/verme önerisi üretmez. AdaletPortal'ın 175 cm / 70 kg ve 175 cm / 89 kg örnekleriyle karşılaştırılmıştır.</p></>}</div></section></div><script type="application/json" id="personel-hesap-veri" set:html={JSON.stringify({tur,kurallar}).replace(/</g,'\\u003c')}/></Layout><script>import '../scripts/personel-hesap';</script>

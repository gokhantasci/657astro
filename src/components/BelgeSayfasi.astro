---
import Layout from '../layouts/Layout.astro';
import {belgeSorulari,type BelgeSayfasi} from '../lib/belge-sorulari';
import {gun} from '../lib/bicim';
interface Props{baslik:string;kurum:string;path:string;arsivYol:string;arsivAd:string;kaynak:string;pdf:string;sha256:string;sayfalar:BelgeSayfasi[];tur:'dpb'|'genelge';tarih?:string;sayi?:string;noindex?:boolean;kaynakNotu?:string}
const {baslik,kurum,path,arsivYol,arsivAd,kaynak,pdf,sha256,sayfalar,tur,tarih,sayi,noindex,kaynakNotu}=Astro.props;
const dogrulanmis=sayfalar.filter(p=>!p.yontem||p.yontem==='pdf');
const sorular=belgeSorulari(baslik,dogrulanmis,tur);
const ocr=sayfalar.some(p=>p.yontem==='ocr'||p.yontem==='tarama');
const description=`${baslik}: özgün belge metni, kaynak PDF ve metindeki olaya ilişkin kısa soru-cevaplar.`;
const jsonLd:Record<string,unknown>[]=[{'@context':'https://schema.org','@type':'DigitalDocument',name:baslik,url:new URL(path,Astro.site).href,description,inLanguage:'tr-TR',creator:{'@type':'Organization',name:kurum},isBasedOn:kaynak,encoding:{'@type':'MediaObject',contentUrl:pdf,encodingFormat:'application/pdf'},...(tarih?{datePublished:tarih}:{}),identifier:sha256}];
if(sorular.length)jsonLd.push({'@context':'https://schema.org','@type':'FAQPage',mainEntity:sorular.map(s=>({'@type':'Question',name:s.soru,acceptedAnswer:{'@type':'Answer',text:s.cevap}}))});
---
<Layout title={`${baslik} | ${arsivAd} | 657.com.tr`} description={description} path={path} noindex={noindex} published={tarih} jsonLd={jsonLd}>
 <header class="portal-sayfa-basligi"><div class="container"><nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span>/</span><a href={arsivYol}>{arsivAd}</a></nav><div class="dir__head"><h1>{baslik}</h1><p>{kurum} · Özgün belge arşivi</p></div></div></header>
 <div class="container page belge">
  <section class="panel" aria-label="Belge künyesi"><dl class="belge__kunye"><div><dt>Kurum</dt><dd>{kurum}</dd></div>{tarih&&<div><dt>Belge tarihi</dt><dd><time datetime={tarih}>{gun(tarih)}</time></dd></div>}{sayi&&<div><dt>Sayı</dt><dd>{sayi}</dd></div>}<div><dt>Kaynak</dt><dd><a href={kaynak} target="_blank" rel="noopener">Resmî kaynak PDF</a></dd></div><div><dt>Belge</dt><dd><a href={pdf}>Özgün PDF’yi aç</a> · {sayfalar.length} sayfa</dd></div></dl><nav class="belge__nav" aria-label="Belge bölümleri"><a href="#ozgun-metin">Özgün metin</a><a href="#belge-sorulari">Sorular ve cevaplar</a></nav></section>
 <article class="panel" id="ozgun-metin" aria-labelledby="ozgun-baslik"><div class="panel__head"><h2 id="ozgun-baslik">Özgün metin</h2></div><div class="belge__not"><p>Kaynağın metni ile aşağıdaki soru-cevap bölümü birbirinden ayrıdır. Bu belge tarihsel bir kayıttır; güncel yürürlük durumu ayrıca kontrol edilmelidir.</p>{kaynakNotu&&<p>{kaynakNotu}</p>}{ocr&&<p>Taranmış sayfaların birebirliğini korumak için özgün PDF aşağıda gösterilir. Doğrulanmamış OCR metni yayınlanmaz.</p>}</div>
   {ocr&&<iframe class="belge__pdf" src={pdf} title={`${baslik} · özgün kaynak PDF`} loading="lazy"><a href={pdf}>Özgün PDF’yi aç</a></iframe>}
   {dogrulanmis.map(p=>sayfalar.length>8?<details class="belge__sayfa" id={`belge-sayfa-${p.no}`} open={p.no===1}><summary>Kaynak sayfa {p.no}</summary><div class="belge__metin" data-ozgun-metin data-metin-koru>{p.metin}</div></details>:<section class="belge__sayfa" id={`belge-sayfa-${p.no}`}><h3>Kaynak sayfa {p.no}</h3><div class="belge__metin" data-ozgun-metin data-metin-koru>{p.metin}</div></section>)}
   {ocr&&!dogrulanmis.some(p=>p.no===1)&&<p class="belge__not" id="belge-sayfa-1"><a href={pdf}>Kaynak sayfa 1’i özgün PDF’de aç</a></p>}
   <p class="belge__not">Kaynak dosyanın SHA-256 kimliği: <code>{sha256}</code></p>
  </article>
  <section class="panel" id="belge-sorulari" aria-labelledby="belge-sorulari-baslik"><div class="panel__head"><h2 id="belge-sorulari-baslik">Metne ilişkin kısa sorular ve cevaplar</h2></div><div class="belge__not"><p>Bu bölüm özgün belgenin parçası değildir. Cevaplar kaynak metne veya resmî dizindeki konu başlığına dayanır; güncel hukuk yorumu veya yeni bir görüş oluşturmaz.</p></div>{sorular.map(s=><section class="belge__soru"><h3>{s.soru}</h3><p data-metin-koru>{s.cevap}</p><a href={`#belge-sayfa-${s.sayfa}`}>Kaynak metinde oku · sayfa {s.sayfa}</a></section>)}</section>
 </div>
</Layout>
<style>/* Hallmark · pre-emit critique: P5 H4 E5 S5 R5 V4 */.belge{max-width:1100px;}.portal-sayfa-basligi h1{font-size:var(--text-xl);line-height:1.35;max-width:75ch;}.portal-sayfa-basligi .dir__head{margin:var(--space-sm) 0 0;}.belge__pdf{display:block;width:100%;height:75vh;min-height:500px;border:0;}.belge__kunye{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:0;}.belge__kunye>div{padding:var(--space-md) var(--space-lg);border-bottom:1px solid var(--color-rule);min-width:0;}.belge__kunye dt{font-size:var(--text-xs);color:var(--color-muted);}.belge__kunye dd{margin:var(--space-2xs) 0 0;overflow-wrap:anywhere;}.belge__nav{display:flex;flex-wrap:wrap;gap:var(--space-lg);padding:var(--space-md) var(--space-lg);}.belge__nav a,.belge__soru>a,.belge__kunye a{min-height:44px;display:inline-flex;align-items:center;}.belge__not{padding:var(--space-md) var(--space-lg);font-size:var(--text-sm);color:var(--color-muted);}.belge__not code{overflow-wrap:anywhere;}.belge__sayfa{padding:var(--space-lg);border-top:1px solid var(--color-rule);scroll-margin-top:100px;}.belge__sayfa h3,.belge__sayfa summary{font-size:var(--text-sm);color:var(--color-muted);margin-bottom:var(--space-md);}.belge__sayfa summary{cursor:pointer;min-height:44px;}.belge__metin{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.85;}.belge__soru{padding:var(--space-lg);border-top:1px solid var(--color-rule);}.belge__soru h3{font-size:var(--text-lg);margin-bottom:var(--space-sm);overflow-wrap:anywhere;}.belge__soru p{line-height:1.8;}.belge :is(#ozgun-metin,#belge-sorulari){scroll-margin-top:100px;}@media(max-width:540px){.belge__kunye{grid-template-columns:minmax(0,1fr);}}</style>

---
import Layout from '../layouts/Layout.astro';
import {belgeSorulari,bultenSorulari,type BelgeSayfasi} from '../lib/belge-sorulari';
import {gun} from '../lib/bicim';
import {getEntry} from 'astro:content';
import {belgeOkumaHtml} from '../lib/belge-gorunum';
import {markdownSayfalari} from '../lib/belge-markdown';
interface Props{belgeId:string;baslik:string;kurum:string;path:string;arsivYol:string;arsivAd:string;kaynak:string;pdf:string;sha256:string;sayfalar:BelgeSayfasi[];tur:'dpb'|'genelge';tarih?:string;sayi?:string;noindex?:boolean;kaynakNotu?:string}
const {belgeId,baslik,kurum,path,arsivYol,arsivAd,kaynak,pdf,sha256,sayfalar,tur,tarih,sayi,noindex}=Astro.props;
const belge=await getEntry('belgeler',`${tur}/${belgeId}`);
if(!belge)throw new Error(`Belgenin Markdown metni eksik: ${tur}/${belgeId}`);
if(belge.data.sha256!==sha256)throw new Error(`Markdown kaynak kimliği eşleşmiyor: ${belgeId}`);
const html=await belgeOkumaHtml(belge.body??'');
const metinSayfalari=markdownSayfalari(belge.body??'');
const bulten=belgeId==='dpb_mutalaa_ozel';
const sorular=bulten?bultenSorulari(metinSayfalari):belgeSorulari(baslik,metinSayfalari,tur);
const description=`${baslik}: özgün belge metni, kaynak PDF ve metindeki olaya ilişkin kısa soru-cevaplar.`;
const jsonLd:Record<string,unknown>[]=[{'@context':'https://schema.org','@type':'DigitalDocument',name:baslik,url:new URL(path,Astro.site).href,description,inLanguage:'tr-TR',creator:{'@type':'Organization',name:kurum},isBasedOn:kaynak,encoding:{'@type':'MediaObject',contentUrl:pdf,encodingFormat:'application/pdf'},...(tarih?{datePublished:tarih}:{}),identifier:sha256}];
if(sorular.length)jsonLd.push({'@context':'https://schema.org','@type':'FAQPage',mainEntity:sorular.map(s=>({'@type':'Question',name:s.soru,acceptedAnswer:{'@type':'Answer',text:s.cevap}}))});
---
<Layout title={`${baslik} | ${arsivAd} | 657.com.tr`} description={description} path={path} noindex={noindex} published={tarih} jsonLd={jsonLd}>
 <header class="portal-sayfa-basligi"><div class="container"><nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span>/</span><a href={arsivYol}>{arsivAd}</a></nav><div class="dir__head"><h1>{baslik}</h1><p>{kurum} · Belge arşivi</p></div></div></header>
 <div class="container page belge" data-belge-indir data-belge-id={belgeId} data-belge-baslik={baslik} data-belge-kurum={kurum} data-belge-kaynak={kaynak}>
  <section class="panel" aria-label="Belge künyesi"><dl class="belge__kunye"><div><dt>Kurum</dt><dd>{kurum}</dd></div>{tarih&&<div><dt>Belge tarihi</dt><dd><time datetime={tarih}>{gun(tarih)}</time></dd></div>}{sayi&&<div><dt>Sayı</dt><dd>{sayi}</dd></div>}<div><dt>Kaynak</dt><dd><a href={kaynak} target="_blank" rel="noopener">Resmî kaynak PDF</a></dd></div><div><dt>Belge</dt><dd><a href={pdf}>Özgün PDF’yi aç</a> · {sayfalar.length} sayfa</dd></div></dl><nav class="belge__nav" aria-label="Belge bölümleri"><a href="#ozgun-metin">Belge metni</a><a href="#belge-sorulari">Sorular ve cevaplar</a><button type="button" class="btn btn--quiet btn--kucuk" data-antet-pdf>657 antetli PDF indir</button></nav><p class="belge__indirme-durumu" role="status" data-antet-durum></p></section>
 <article class="panel" id="ozgun-metin" aria-label="Belge metni">
   <div class:list={['belge__metin',{'belge__metin--bulten':bulten}]} data-ozgun-metin data-metin-koru set:html={html}></div>

  </article>
  <section class="panel" id="belge-sorulari" aria-labelledby="belge-sorulari-baslik"><div class="panel__head"><h2 id="belge-sorulari-baslik">Metne ilişkin kısa sorular ve cevaplar</h2></div><div class="belge__not"><p>Bu bölüm özgün belgenin parçası değildir. Cevaplar kaynak metne veya resmî dizindeki konu başlığına dayanır; güncel hukuk yorumu veya yeni bir görüş oluşturmaz.</p></div>{sorular.map(s=><section class="belge__soru"><h3>{s.soru}</h3><p data-metin-koru>{s.cevap}</p><a href={`#belge-sayfa-${s.sayfa}`}>Kaynak metinde oku · sayfa {s.sayfa}</a></section>)}</section>
 </div>
</Layout>
<script>import '../scripts/belge-indir';</script>
<style>
/* Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 */
.belge{width:100%;max-width:none;padding-inline:clamp(16px,2.5vw,40px);--font-belge:"Times New Roman",Times,serif;}
.portal-sayfa-basligi .container{max-width:none;padding-inline:clamp(16px,2.5vw,40px);}
.portal-sayfa-basligi h1{font-size:var(--text-xl);line-height:1.35;max-width:75ch;overflow-wrap:anywhere;}
.portal-sayfa-basligi .dir__head{margin:var(--space-sm) 0 0;}
.belge__kunye{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:0;}
.belge__kunye>div{padding:var(--space-md) var(--space-lg);border-bottom:1px solid var(--color-rule);min-width:0;}
.belge__kunye dt{font-size:var(--text-xs);color:var(--color-muted);}
.belge__kunye dd{margin:var(--space-2xs) 0 0;overflow-wrap:anywhere;}
.belge__nav{display:flex;flex-wrap:wrap;gap:var(--space-lg);padding:var(--space-md) var(--space-lg);}
.belge__indirme-durumu{padding:0 var(--space-lg);font-size:var(--text-sm);color:var(--color-muted);}
.belge__indirme-durumu:empty{display:none;}
.belge__nav a,.belge__soru>a,.belge__kunye a{min-height:44px;display:inline-flex;align-items:center;}
.belge__not{padding:var(--space-md) var(--space-lg);font-size:var(--text-sm);color:var(--color-muted);}
.belge__not code{overflow-wrap:anywhere;}
.belge__metin{max-width:none;margin:0;padding:var(--space-lg) clamp(16px,2vw,32px);font-family:var(--font-belge);font-size:19px;line-height:1.65;overflow-wrap:anywhere;color:var(--color-ink);}
.belge__metin :global(.kaynak-sayfa){position:relative;scroll-margin-top:var(--space-lg);padding:var(--space-sm) 0;border-bottom:0;}
.belge__metin :global(.kaynak-sayfa:last-child){border-bottom:0;}
.belge__metin :global(p){max-width:none;margin:0 0 1em;text-align:justify;text-indent:2em;}
.belge__metin :global(h2){font-family:var(--font-belge);font-style:normal;font-size:1.2em;line-height:1.5;text-align:center;margin:1.5em 0 1em;max-width:none;}
.belge__metin :global(h3){font-family:var(--font-belge);font-style:normal;font-size:1em;line-height:1.65;margin:0 0 1.2em;font-weight:700;text-align:justify;max-width:none;}
.belge__metin :global(table){width:100%;border-collapse:collapse;font-size:.85em;margin:1.5em 0;table-layout:fixed;}
.belge__metin :global(th),.belge__metin :global(td){border:1px solid var(--color-rule);padding:.5em;vertical-align:top;overflow-wrap:anywhere;}
.belge__metin :global(ul),.belge__metin :global(ol){padding-left:1.5em;}
.belge__metin :global(.belge-kurum p){text-align:center;text-indent:0;}
.belge__metin :global(.belge-ust-bilgi p){text-align:left;text-indent:0;}
.belge__metin :global(.belge-imza p){text-align:right;text-indent:0;}
.belge__metin :global(img){max-width:100%;height:auto;}
.belge__metin :global(.belge-tablo){max-width:100%;overflow-x:auto;}
.belge__metin :global(.belge-tablo table){table-layout:fixed;min-width:650px;}
.belge__metin :global(.belge-dikey){writing-mode:vertical-rl;transform:rotate(180deg);height:310px;text-align:center;overflow-wrap:normal;font-size:12px;line-height:1.25;white-space:nowrap;padding:4px;}
.belge__metin :global(.kaynak-ozgun-numara p){text-align:center;text-indent:0;font-size:.8em;}
.belge__metin :global(.kaynak-sayfa-no){display:block;text-align:center;font-size:.8em;color:var(--color-muted);margin-top:2em;}
.belge__metin--bulten :global([data-kaynak-sayfa="1"]){text-align:center;min-height:450px;display:flex;flex-direction:column;justify-content:center;}
.belge__metin--bulten :global([data-kaynak-sayfa="1"] p){text-align:center;text-indent:0;}
.belge__metin--bulten :global([data-kaynak-sayfa="1"] h2){font-size:1.65em;margin:.25em 0;}
.belge__metin--bulten :global([data-kaynak-sayfa="1"] img){display:block;max-width:110px;height:auto;margin:0 auto 1em;}
.belge__metin--bulten :global([data-kaynak-sayfa="2"] p){text-align:center;text-indent:0;}
.belge__soru{padding:var(--space-lg);border-top:1px solid var(--color-rule);}
.belge__soru h3{font-size:var(--text-lg);margin-bottom:var(--space-sm);overflow-wrap:anywhere;}
.belge__soru p{line-height:1.8;}
.belge :is(#ozgun-metin,#belge-sorulari){scroll-margin-top:var(--space-lg);}
@media(max-width:540px){.belge__kunye{grid-template-columns:minmax(0,1fr);}.belge__metin{font-size:17px;}.belge__metin :global(p),.belge__metin :global(h3){text-align:left;}.belge__metin :global(p){text-indent:1.2em;}}

</style>

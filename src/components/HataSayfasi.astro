---
import tokens from '../styles/tokens.css?raw';
import {yerelYol} from '../lib/site-yolu';
import {hataBilgisi,type HataKodu} from '../lib/hata-durumlari';
import {paylasimYollari} from '../../scripts/paylasim-yollari.mjs';
import {araclar} from '../lib/tools';
interface Props {kod:HataKodu;onizleme?:boolean}
const {kod,onizleme=false}=Astro.props;
const hata=hataBilgisi(kod),{baslik,aciklama,arama,tekrar}=hata;
const istemci=kod==='4xx'||typeof kod==='number'&&kod<500;
// GitHub Pages yeniden yazma yapamaz: paylaşılan hesap adresi 404'e düşerse araç sayfası aynı adreste açılır.
// GitHub Pages proje yolunda da çalışsın diye kökler taban yoluyla verilir.
const paylasim=kod===404?paylasimYollari(araclar).map((y:string)=>yerelYol(y)):[];
const etiketHedefi=yerelYol('/yazilar/');
---
<!doctype html>
<html lang="tr">
 <head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="noindex, follow"/>
  <meta name="description" content={aciklama}/>
  <title>{kod} · {baslik} | 657.com.tr</title>
  <link rel="icon" href="data:,"/>
  {paylasim.length>0&&<script is:inline define:vars={{yollar:paylasim,etiketHedefi}}>(function(){try{var y=decodeURIComponent(location.pathname);if(/\.[a-z0-9]{1,8}$/i.test(y))return;var e=y.match(/\/tag\/([^/]+)\/?(?:page\/\d+\/?)?$/);if(e){location.replace(etiketHedefi+'?q='+encodeURIComponent(e[1].replace(/-/g,' ')));return;}var k=yollar.find(function(p){return y.indexOf(p)===0&&y.length>p.length;});if(!k)return;document.documentElement.style.visibility='hidden';fetch(k,{credentials:'same-origin'}).then(function(r){if(!r.ok)throw 0;return r.text();}).then(function(h){document.open();document.write(h);document.close();}).catch(function(){document.documentElement.style.visibility='';});}catch(e){}})();</script>}
  <script is:inline>try{const t=localStorage.getItem('657:tema');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t;}catch{}</script>
  <style is:inline set:html={tokens}/>
  <style is:inline>
   /* Hallmark · pre-emit critique: P4 H5 E4 S4 R5 V4 · existing site tokens */
   *{box-sizing:border-box;}html,body{margin:0;min-width:0;overflow-x:clip;}
   body{min-height:100svh;background:var(--color-paper);color:var(--color-ink);font:var(--text-md)/1.65 var(--font-body);}
   .hata{max-width:920px;margin:auto;padding:var(--space-xl) var(--space-lg);}
   a{color:var(--color-accent-text);text-underline-offset:4px;}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--color-focus);outline-offset:4px;}
   .marka{display:inline-flex;align-items:center;gap:var(--space-2xs);font:600 var(--text-xl)/1 var(--font-display);color:var(--color-ink);text-decoration:none;white-space:nowrap;}
   .marka span{background:var(--color-accent);color:var(--color-accent-ink);padding:var(--space-2xs) var(--space-xs);border-radius:var(--radius-pill);}
   main{margin-block:var(--space-2xl) var(--space-lg);border:1px solid var(--color-rule);border-radius:var(--radius-card);background:var(--color-paper-2);}
   .ust{display:flex;align-items:center;gap:var(--space-md);padding:var(--space-lg) var(--space-xl);border-bottom:2px solid var(--color-accent);}
   .kod{font:600 var(--text-3xl)/1 var(--font-outlier);color:var(--color-accent-text);}.durum{color:var(--color-muted);font-size:var(--text-sm);}
   .icerik{padding:var(--space-xl);}h1{margin:0 0 var(--space-md);font:600 var(--text-section)/1.15 var(--font-display);letter-spacing:var(--tracking-display);overflow-wrap:anywhere;min-width:0;}p{margin:0 0 var(--space-lg);max-width:62ch;color:var(--color-muted);}
   nav{display:flex;flex-wrap:wrap;gap:var(--space-sm);}.dugme{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:var(--space-xs) var(--space-md);border:1px solid var(--color-rule);border-radius:var(--radius-pill);background:var(--color-paper-2);color:var(--color-ink);font:500 var(--text-sm)/1.4 var(--font-body);text-decoration:none;white-space:nowrap;cursor:pointer;}
   .dugme:hover{background:var(--color-paper-3);}.dugme:active{transform:translateY(1px);}.dugme--ana{background:var(--color-accent);border-color:var(--color-accent);color:var(--color-accent-ink);}.dugme--ana:hover{background:var(--color-accent-strong);}
   form{margin-top:var(--space-xl);padding-top:var(--space-lg);border-top:1px solid var(--color-rule);}label{display:block;margin-bottom:var(--space-xs);font-weight:500;}.arama{display:flex;gap:var(--space-xs);}input{min-width:0;flex:1;width:100%;min-height:44px;border:1px solid var(--color-muted);border-radius:var(--radius-pill);background:var(--color-paper);color:var(--color-ink);padding:var(--space-xs) var(--space-sm);font:inherit;}
   footer{color:var(--color-muted);font-size:var(--text-xs);}footer a{color:inherit;}
   @media(max-width:600px){.hata{padding:var(--space-lg) var(--space-md);}.ust,.icerik{padding:var(--space-lg);}main{margin-top:var(--space-xl);}h1{font-size:var(--text-2xl);}.arama{flex-direction:column;}.arama button{align-self:flex-start;}}
  </style>
 </head>
 <body>
  <div class="hata">
   <header><a class="marka" href={yerelYol('/')} aria-label="657.com.tr anasayfa"><span>657</span>.com.tr</a></header>
   {onizleme&&<p style="margin-top:var(--space-lg);font-size:var(--text-sm)">Tasarım önizlemesi · <a href={yerelYol('/hatalar/')}>Bütün hata sayfaları</a></p>}
   <main id="icerik">
    <div class="ust"><span class="kod" aria-hidden="true">{kod}</span><span class="durum">{istemci?'İstek tamamlanamadı':'Hizmete erişilemiyor'}</span></div>
    <div class="icerik"><h1>{baslik}</h1><p>{aciklama}</p>
     <nav aria-label="Devam seçenekleri">
      {tekrar?<a class="dugme dugme--ana" href="">Yeniden dene</a>:<a class="dugme dugme--ana" href={yerelYol('/')}>Anasayfaya dön</a>}
      <a class="dugme" href={yerelYol('/araclar/')}>Bütün araçlar</a>
      {tekrar&&<a class="dugme" href={yerelYol('/')}>Anasayfa</a>}
     </nav>
     {arama&&<form action={yerelYol('/yazilar/')} method="get" role="search"><label for="hata-ara">Yazılarda ve araçlarda ara</label><div class="arama"><input type="search" name="q" id="hata-ara" placeholder="Örneğin: maaş, kesinleşme, sözlük" required maxlength="200"/><button class="dugme" type="submit">Ara</button></div></form>}
    </div>
   </main>
   <footer>657.com.tr · {tekrar?'Bu sayfayı daha sonra yeniden açabilirsiniz.':'Herkese açık araçlara anasayfadan ulaşabilirsiniz.'}</footer>
  </div>
 </body>
</html>

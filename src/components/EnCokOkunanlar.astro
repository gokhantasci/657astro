---
const gruplar=[['hukuk','Hukuk terimleri','/hukuk-sozlugu/'],['adli','Adli çevre','/adlicevre/'],['mulakat','Mülakat soruları','/cikmis-mulakat-sorulari/'],['yazi','Yazılar','/yazilar/']];
const donemler=[['bugun','Bugün'],['hafta','Bu hafta'],['ay','Bu ay'],['yil','Bu yıl']];
---
<section class="okunanlar panel" aria-labelledby="okunanlar-baslik" data-okunanlar>
 <div class="okunanlar__ust"><h2 id="okunanlar-baslik">En çok okunanlar</h2>
  <div class="okunanlar__donemler" role="group" aria-label="Okunma dönemi">{donemler.map(([id,ad],i)=><button type="button" data-donem={id} aria-pressed={i===0}>{ad}</button>)}</div>
 </div>
 <p class="okunanlar__durum" data-okunanlar-durum role="status">Okunma sıralamaları yükleniyor…</p>
 <button class="btn btn--quiet" type="button" data-okunanlar-tekrar hidden>Yeniden dene</button>
 <div class="okunanlar__grid" data-okunanlar-listeler aria-busy="true">{gruplar.map(([id,ad,yol])=><section aria-labelledby={`okunanlar-${id}`}><h3 id={`okunanlar-${id}`}><a href={yol}>{ad}</a></h3><ol data-okunanlar-grup={id}></ol></section>)}</div>
 <p class="okunanlar__not" data-okunanlar-olcum hidden></p>
 <noscript><p>Dönem sıralamalarını görmek için JavaScript’i etkinleştirin.</p></noscript>
</section>
<script>import '../scripts/en-cok-okunanlar';</script>
<style>
/* Mevcut hizmet portalı · sade · kırmızı vurgu · dört sıralama sütunu.
   Hallmark · pre-emit critique: P5 H4 E5 S5 R5 V4 */
.okunanlar{padding:var(--space-lg);}
.okunanlar__ust{display:flex;align-items:center;justify-content:space-between;gap:var(--space-md);flex-wrap:wrap;}
.okunanlar h2{font-size:var(--text-xl);}
.okunanlar__donemler{display:flex;border:1px solid var(--color-rule);border-radius:var(--radius-pill);}
.okunanlar__donemler button{min-height:44px;padding:var(--space-xs) var(--space-sm);border:0;border-radius:var(--radius-pill);background:transparent;color:var(--color-ink);font:inherit;font-size:var(--text-sm);cursor:pointer;white-space:nowrap;}
.okunanlar__donemler button[aria-pressed="true"]{background:var(--color-accent-soft);color:var(--color-accent-text);font-weight:600;}
.okunanlar button:focus-visible,.okunanlar :global(a:focus-visible){outline:2px solid var(--color-focus);outline-offset:2px;}
.okunanlar button:active{background:var(--color-paper-3);}
.okunanlar button:disabled{opacity:.55;cursor:not-allowed;}
.okunanlar__durum{font-size:var(--text-xs);color:var(--color-muted);margin-block:var(--space-xs) 0;min-height:1.5em;}
.okunanlar[data-durum="hata"] .okunanlar__durum{color:var(--color-error);}
.okunanlar__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:var(--space-xl);}
.okunanlar__grid[aria-busy="true"]{opacity:.6;}
.okunanlar__grid section{min-width:0;display:grid;grid-template-rows:subgrid;grid-row:span 6;}
.okunanlar h3{font-size:var(--text-lg);margin:0;padding-top:var(--space-lg);}
.okunanlar h3 a{display:flex;align-items:center;min-height:44px;color:var(--color-ink);text-decoration:none;}
.okunanlar ol{display:grid;grid-template-rows:subgrid;grid-row:span 5;margin:0;padding:0;list-style:none;counter-reset:okunma-sirasi;}
.okunanlar :global(li){display:grid;grid-template-columns:var(--space-lg) minmax(0,1fr) auto;align-items:start;column-gap:var(--space-sm);border-top:1px solid var(--color-rule);font-size:var(--text-sm);line-height:1.5;overflow-wrap:anywhere;counter-increment:okunma-sirasi;}
.okunanlar :global(li::before){content:counter(okunma-sirasi) '.';color:var(--color-muted);font-size:var(--text-xs);font-variant-numeric:tabular-nums;padding-top:calc(var(--space-sm) + var(--space-3xs));white-space:nowrap;}
.okunanlar :global(li a){display:block;box-sizing:border-box;min-height:44px;padding-block:var(--space-sm);color:var(--color-ink);text-decoration:none;}
.okunanlar :global(li span){min-width:3ch;padding-top:var(--space-sm);text-align:right;color:var(--color-muted);font-size:var(--text-sm);font-variant-numeric:tabular-nums;white-space:nowrap;}
.okunanlar__not{margin:var(--space-lg) 0 0;padding-top:var(--space-sm);border-top:1px solid var(--color-rule);color:var(--color-muted);font-size:var(--text-xs);}
.okunanlar>[data-okunanlar-tekrar]{margin-block:var(--space-md);}
@media(hover:hover){.okunanlar button:hover{background:var(--color-paper-3);}.okunanlar :global(a:hover){color:var(--color-accent-text);text-decoration:underline;}}
@media(max-width:650px){.okunanlar{padding:var(--space-md);}.okunanlar__grid{grid-template-columns:minmax(0,1fr);}.okunanlar__ust{align-items:flex-start;}.okunanlar__donemler{max-width:100%;}}
</style>

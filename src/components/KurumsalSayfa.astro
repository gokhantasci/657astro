---
import Layout from '../layouts/Layout.astro';
import { ayarlar } from '../lib/settings';
import { gun } from '../lib/bicim';
// İletişim, gizlilik ve kullanım koşulları gibi tek metinli site sayfaları.
interface Props { baslik: string; description: string; path: string; yururluk?: string; tur?: 'WebPage' | 'ContactPage' | 'AboutPage' }
const { baslik, description, path, yururluk, tur = 'WebPage' } = Astro.props;
const site = ayarlar.site.url;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: baslik, item: `${site}${path}` },
  ] },
  { '@context': 'https://schema.org', '@type': tur, name: baslik, url: `${site}${path}`, inLanguage: 'tr-TR', description,
    ...(yururluk ? { dateModified: yururluk } : {}), isPartOf: { '@id': `${site}/#site` }, publisher: { '@id': `${site}/#kurulus` } },
];
---
<Layout title={`${baslik} | 657.com.tr`} description={description} path={path} jsonLd={jsonLd}>
 <div class="container page">
  <nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span aria-hidden="true">/</span><span aria-current="page">{baslik}</span></nav>
  <article class="article panel" data-solid>
   <header class="article__head">
    {yururluk && <div class="news__meta"><span>Son güncelleme: <time datetime={yururluk}>{gun(yururluk)}</time></span></div>}
    <h1>{baslik}</h1>
   </header>
   <div class="prose"><slot/></div>
  </article>
 </div>
</Layout>

---
import {terimler,terimHref} from '../lib/sozluk';
import {sorular,soruHref} from '../lib/mulakat';
import {okunma} from '../lib/okunma';
interface Props{grup:'hukuk'|'mulakat';adet?:number;varsayilanDonem?:'bugun'|'hafta'|'ay'|'yil'|'toplam'}
const {grup,adet=12,varsayilanDonem='toplam'}=Astro.props;
const donemler=[['bugun','Bugün'],['hafta','Bu hafta'],['ay','Bu ay'],['yil','Bu yıl'],['toplam','Tüm zamanlar']] as const;
const rows=(grup==='hukuk'?terimler.map(t=>({baslik:t.terim,yol:terimHref(t)})):sorular.map(s=>({baslik:s.soru,yol:soruHref(s)}))).map(r=>({...r,sayi:okunma(r.yol)})).sort((a,b)=>b.sayi-a.sayi||a.baslik.localeCompare(b.baslik,'tr')).slice(0,adet);
---
<section class="panel" data-solid data-cok-okunan={grup} data-adet={adet} data-varsayilan-donem={varsayilanDonem} aria-labelledby={`cok-okunan-${grup}`}>
 <div class="panel__head cok-okunan__ust">
  <h2 id={`cok-okunan-${grup}`} data-cok-okunan-baslik>{grup==='hukuk'?(varsayilanDonem==='bugun'?'Bugün en çok okunan hukuk terimleri':'En çok okunan hukuk terimleri'):(varsayilanDonem==='bugun'?'Bugün en çok okunan sorular':'En çok okunan sorular')}</h2>
  <div class="cok-okunan__donemler" role="group" aria-label="Görüntülenme dönemi">
   {donemler.map(([id,ad])=><button type="button" data-cok-okunan-donem={id} aria-pressed={id===varsayilanDonem}>{ad}</button>)}
  </div>
 </div>
 <p class="not" data-cok-okunan-durum role="status">Arşiv sıralaması gösteriliyor; güncel görüntülenmeler yükleniyor…</p>
 <ol class="terimler terimler--iki" data-cok-okunan-liste>{rows.map(r=><li><a href={r.yol}><strong>{r.baslik}</strong><span>{r.sayi.toLocaleString('tr-TR')} görüntülenme</span></a></li>)}</ol>
 <button class="btn btn--quiet tekrar" type="button" data-cok-okunan-tekrar hidden>Yeniden dene</button>
</section>
<script>import '../scripts/cok-okunanlar';</script>
<style>
/* Hallmark · pre-emit critique: P5 H4 E5 S5 R5 V4 */
.cok-okunan__ust{display:flex;align-items:center;justify-content:space-between;gap:var(--space-sm);flex-wrap:wrap;}
.cok-okunan__donemler{display:flex;flex-wrap:wrap;border:1px solid var(--color-rule);border-radius:var(--radius-pill);background:var(--color-paper-2);}
.cok-okunan__donemler button{min-height:36px;padding:var(--space-2xs) var(--space-sm);border:0;border-radius:var(--radius-pill);background:transparent;color:var(--color-ink);font:inherit;font-size:var(--text-xs);cursor:pointer;white-space:nowrap;}
.cok-okunan__donemler button[aria-pressed="true"]{background:var(--color-accent-soft);color:var(--color-accent-text);font-weight:700;}
.cok-okunan__donemler button:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px;}
.not{padding:var(--space-sm) var(--space-lg);color:var(--color-muted);font-size:var(--text-xs);margin:0;}
.tekrar{margin:var(--space-md) var(--space-lg);}
</style>

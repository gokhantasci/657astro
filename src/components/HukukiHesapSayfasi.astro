---
import Layout from '../layouts/Layout.astro';
import {hukukiAraclar,hukukiAlanlar,hukukiBaglantilar} from '../lib/hukuki-katalog';
import {hukukiKurallar,hukukiKaynaklar} from '../lib/hukuki-veri';
import {hukukiHesap,type HukukiTur} from '../lib/hukuki-hesap';
import {tl} from '../lib/bicim';
interface Props{tur:HukukiTur}
const {tur}=Astro.props,arac=hukukiAraclar.find(a=>a.tur===tur)!,path=`/${arac.slug}/`,alanlar=hukukiAlanlar(tur);
const r=hukukiHesap(tur,Object.fromEntries(alanlar.map(a=>[a.id,a.deger])),hukukiKurallar);
const bicim=(n:number,birim?:string)=>birim==='TL'?tl(n):`${n.toLocaleString('tr-TR',{maximumFractionDigits:2})}${birim?' '+birim:''}`;
---
<Layout title={`${arac.ad} | 657.com.tr`} description={arac.aciklama} path={path} jsonLd={[{'@context':'https://schema.org','@type':'WebApplication',name:arac.ad,description:arac.aciklama,url:new URL(path,Astro.site).href,applicationCategory:'UtilitiesApplication',isAccessibleForFree:true,inLanguage:'tr-TR'}]}>
 <header class="portal-sayfa-basligi"><div class="container"><nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span>/</span><a href="/hukuki-hesaplamalar/">Hukuki hesaplamalar</a></nav><div class="portal-sayfa-basligi__satir"><div class="dir__head"><h1>{arac.ad}</h1><p>{arac.aciklama}</p></div></div></div></header>
 <div class="container page">
 {tur==='infaz'&&<p class="maas-not">Süreli hapis için yaklaşık hesap. Oran ve denetimli serbestlik hakkı dosyadan doğrulanmalıdır. Suç kataloğu ve geçici infaz hükümleri otomatik uygulanmaz; resmî müddetname değildir.</p>}
 <div class="arac">
  <section class="panel" data-solid aria-labelledby="hh-girdi"><div class="panel__head"><h2 id="hh-girdi">Hesap bilgileri</h2><button type="button" class="btn btn--quiet btn--kucuk" data-hh-sifirla>Sıfırla</button></div>
   <form id="hukuki-form" class="maas-form"><div class="maas-form__grid">
   {alanlar.map(a=><div class="maas-alan" data-hh-alan={a.id}>
    <label for={a.id}>{a.ad}</label>
    {a.secenekler?<select id={a.id} name={a.id} aria-describedby={a.aciklama?`${a.id}-not`:undefined}>{a.secenekler.map(o=><option value={o.value} selected={String(o.value)===String(a.deger)}>{o.label}</option>)}</select>:<input id={a.id} name={a.id} type={a.tip??'number'} value={a.deger} min={a.min} max={a.max} step={a.adim} required aria-describedby={a.aciklama?`${a.id}-not`:undefined}/>}
    {a.aciklama&&<p class="maas-not" id={`${a.id}-not`}>{a.aciklama}</p>}
   </div>)}
   </div><p class="arac__hata" role="alert" data-hh-hata hidden></p><button class="btn" type="submit">Hesapla</button></form>
  </section>
  <section class="panel sonuc" data-solid aria-labelledby="hh-sonuc"><div class="panel__head"><h2 id="hh-sonuc">Sonuç</h2></div><div class="sonuc__ana" role="status" aria-live="polite"><p class="sonuc__etiket" data-hh-etiket>{r.etiket}</p><p class="sonuc__deger num" data-hh-ana>{bicim(r.ana,r.birim)}</p></div>
   <dl class="sonuc__satirlar" data-hh-satirlar>{r.satirlar.map(s=><div><dt>{s.ad}</dt><dd class="num">{typeof s.deger==='number'?bicim(s.deger,s.birim):s.deger}</dd></div>)}</dl>
  </section>
 </div>
 <section class="panel" data-solid><div class="panel__head"><h2>Hesap dökümü</h2><button type="button" class="btn btn--quiet btn--kucuk" data-hh-kopyala>Metni kopyala</button></div><pre class="dokum" data-hh-metin>{[`${r.etiket}: ${bicim(r.ana,r.birim)}`,...r.satirlar.map(s=>`${s.ad}: ${typeof s.deger==='number'?bicim(s.deger,s.birim):s.deger}`),...r.notlar].join('\n')}</pre><p class="maas-not" role="status" data-hh-durum></p></section>
 <section class="panel" data-solid><div class="panel__head"><h2>Kapsam ve kullanılan kaynaklar</h2></div><div class="prose prose--kisa"><div data-hh-notlar>{r.notlar.map(n=><p>{n}</p>)}</div><ul>{hukukiKaynaklar[tur].map(k=><li><a href={k.url}>{k.ad}</a></li>)}</ul></div></section>
 <section class="panel" data-solid><div class="panel__head"><h2>Diğer hukuki hesaplamalar</h2></div><ol class="terimler terimler--iki">{hukukiBaglantilar.filter(a=>a.path!==path).map(a=><li><a href={a.path}><strong>{a.ad}</strong><span>{a.aciklama}</span></a></li>)}</ol></section>
 </div>
 <script type="application/json" id="hukuki-veri" set:html={JSON.stringify({tur,alanlar,kurallar:hukukiKurallar}).replace(/</g,'\u003c')}/>
</Layout>
<script>import '../scripts/hukuki-hesap';</script>

          <label>
            <span>Şık Modu</span>
            <select data-gys-pdf-mod>
              <option value="klasik">Klasik (5 Şıklı — A–E)</option>
              <option value="ikili">Hızlı Tekrar (2 Şıklı — A–B)</option>
            </select>
          </label>
          <button type="button" class="btn" data-gys-pdf-uret>Renkli Kitapçık Oluştur</button>
        </div>
        <div class="gys-pdf-eylem" data-gys-pdf-eylem hidden>
          <button type="button" class="btn btn--kucuk" data-gys-pdf-yazdir>Kitap Baskısı Yazdır / PDF Kaydet</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-gys-pdf-indir>HTML Kitapçık İndir</button>
        </div>
        <div class="gys-pdf-onizleme" data-gys-pdf-onizleme></div>
      </div>
    </section>

    <!-- 5. SORU HAZIRLA, İNDİR & SİSTEME YÜKLE -->
    <section class="panel" id="gys-studyo" data-gys-panel="ekle" data-solid hidden>
      <div class="panel__head">
        <h2>Kendi Sorunu Hazırla, İndir veya Sisteme Yükle</h2>
        <button type="button" class="btn btn--quiet btn--kucuk" data-gys-ozel-indir hidden>Hazırladıklarımı İndir (JSON)</button>
      </div>
      <div class="gys-ic">
        <p style="margin:0 0 var(--space-md);font-size:var(--text-sm);color:var(--color-ink-2);">
          Hazırladığınız soruları kendi bilgisayarınıza <strong>JSON</strong> olarak indirebilir veya <strong>topluluk/admin onayına</strong> gönderebilirsiniz. Onay bekleyen sorular diğer kullanıcılara uyarı etiketiyle sorulur ve yeterli onay oyu (+5) veya yönetici onayı aldığında resmî havuza katılır.
        </p>
        <form class="gys-ekle-form" data-gys-ekle-form>
          <div class="gys-filtreler">
            <label>
              <span>Kanun / Alan</span>
              <select data-gys-ekle-kanun>
                <option value="7201">7201 Tebligat Kanunu</option>
                <option value="657">657 Devlet Memurları Kanunu</option>
                <option value="anayasa">2709 T.C. Anayasası</option>
                <option value="6100">HMK / CMK / Yazı İşleri</option>
                <option value="5275">5275 CGTİHK (CTE)</option>
                <option value="5018">5018 Mali / 4734 İhale</option>
                <option value="icra">İcra MY (İİK / TTK / TBK / Vergi)</option>
                <option value="genelge">Adalet Bakanlığı Genelgeleri</option>
                <option value="ortak">Ortak Konular</option>
              </select>
            </label>
            <label>
              <span>Alt Bölüm / Ünite</span>
              <select data-gys-ekle-bolum>
                <option value="7201:genel">7201:genel</option>
                <option value="7201:usul">7201:usul</option>
                <option value="7201:ozel">7201:ozel</option>
                <option value="7201:kaza-idari-mali">7201:kaza-idari-mali</option>
                <option value="7201:cezai">7201:cezai</option>
                <option value="7201:elektronik">7201:elektronik</option>
                <option value="657:temel">657:temel</option>
                <option value="657:disiplin">657:disiplin</option>
                <option value="anayasa:temel">anayasa:temel</option>
                <option value="6100:usul">6100:usul</option>
                <option value="5275:infaz">5275:infaz</option>
                <option value="5018:mali">5018:mali</option>
                <option value="icra:iik">icra:iik</option>
                <option value="icra:vergi-harc">icra:vergi-harc</option>
                <option value="icra:ttk-tbk">icra:ttk-tbk</option>
                <option value="genelge:disiplin-personel">genelge:disiplin-personel</option>
                <option value="genelge:ceza-sorusturma">genelge:ceza-sorusturma</option>
                <option value="genelge:hukuk-uyap">genelge:hukuk-uyap</option>
                <option value="ortak:yazisma">ortak:yazisma</option>
              </select>
            </label>
            <label>
              <span>Zorluk Seviyesi</span>
              <select data-gys-ekle-seviye>
                <option value="kolay">Kolay</option>
                <option value="orta" selected>Orta</option>
                <option value="zor">Zor</option>
                <option value="akademik">Akademik</option>
                <option value="dip">En Dip</option>
              </select>
            </label>
          </div>
          <label><span>Soru Metni (Kanuni metne sadık, en az 20 karakter)</span><textarea rows="3" required minlength="20" data-gys-ekle-soru placeholder="Örn: 7201 sayılı Tebligat Kanunu m. 7/a uyarınca..."></textarea></label>
          <label><span>Doğru Cevap(lar) — Her satıra 1 doğru cevap (en az 1 satır)</span><textarea rows="2" required data-gys-ekle-dogru placeholder="Her satıra bir doğru şık yazın (birden fazla doğru yazarsanız kombinatoryal çalışır)"></textarea></label>
          <label><span>Yanlış Çeldiriciler — Her satıra 1 yanlış şık (en az 4 satır)</span><textarea rows="4" required data-gys-ekle-yanlis placeholder="En az 4 satır yanlış şık yazın"></textarea></label>
          <div class="gys-filtreler">

---
import Layout from '../layouts/Layout.astro';
import SubdomainLayout from '../layouts/SubdomainLayout.astro';
import PlatformSayacSeridi from './PlatformSayacSeridi.astro';
import mufredat from '../data/gys-mufredat.json';
import agac from '../data/gys-agac.json';
import konular from '../data/gys-konular.json';
import sorularTemel from '../data/gys-sorular.json';
import sorularIcra from '../data/gys-sorular-icra.json';
import sorularGenelge from '../data/gys-sorular-genelgeler.json';
import ilanlarMevzuat from '../data/gys-ilanlar-mevzuat.json';
import { ayarlar } from '../lib/settings';

interface Props {
  standalone?: boolean;
  initialTab?: 'sinav' | 'konular' | 'canli' | 'performans' | 'hatalar' | 'kitapcik' | 'pdf' | 'ekle' | 'takvim';
  activeHref?: string;
}
const { standalone = false, initialTab = 'sinav', activeHref = '/' } = Astro.props;

const tumSorular = [...sorularTemel, ...sorularIcra, ...sorularGenelge];
const site = ayarlar.site.url;
const path = '/gys/';
const title = 'Adalet Bakanlığı, CTE & İcra MY Görevde Yükselme Sınavı (GYS 2026) | gys.657.com.tr';
const description = 'Adalet Bakanlığı (PGM), CTE Görevde Yükselme, Ünvan Değişikliği ve ÖSYM İcra Müdür Yardımcılığı ücretsiz sınav platformu. 35 resmî konu takibi, sonsuz rastgele test, 60 sn yarış, canlı ortak sınav ve 2 sütunlu kitapçık.';

const gysNav = [
  { href: '/', label: 'Sınav Merkezi' },
  { href: '/konular/', label: `Tüm Konular (${konular.length})` },
  { href: '/canli-sinav/', label: 'Canlı Sınav' },
  { href: '/performans/', label: 'Performansım' },
  { href: '/studyo/', label: 'Soru Stüdyosu' },
  { href: '/ilanlar/', label: 'İlanlar & Mevzuat' },
];
const Kabuk: any = standalone ? SubdomainLayout : Layout;
const kabukProps = standalone
  ? { title, description, canonical: `https://gys.657.com.tr${activeHref}`, brand: 'GYS Sınav Platformu', brandTag: 'GYS · 657', themeVariant: 'gys' as const, manifest: '/gys-manifest.webmanifest', nav: gysNav }
  : { title, description, path };

const gysHaberler = [
  { baslik: 'Adalet Bakanlığı Görevde Yükselme Sınav Süreçleri (2015–2026 Takvim)', url: '/adalet-bakanligi-gorevde-yukselme-sinav-surecleri-2015-2026-yillara-gore-takvim/', etiket: 'PGM Takvim' },
  { baslik: 'Yazı İşleri Müdürü Görevde Yükselme Sınav Şartları Nelerdir?', url: '/adalet-bakanligi-yazi-isleri-muduru-gorevde-yukselme-sinav-sartlari-nelerdir/', etiket: 'Yazı İşleri' },
  { baslik: 'İdari İşler Müdürü Görevde Yükselme Sınav Şartları Nelerdir?', url: '/adalet-bakanligi-idari-isler-muduru-gorevde-yukselme-sinav-sartlari-nelerdir/', etiket: 'İdari İşler' },
  { baslik: 'Adalet Bakanlığı Şef Görevde Yükselme Sınav Şartları Nelerdir?', url: '/adalet-bakanligi-sef-gorevde-yukselme-sinav-sartlari-nelerdir/', etiket: 'Şef' },
  { baslik: 'CTE Kurum İkinci Müdürü, İdare Memuru ve İKBM GYS Şartları', url: '/cte-kurum-ikinci-muduru-idare-memuru-infaz-koruma-basmemuru-gys-sartlari-nelerdir/', etiket: 'CTE GYS' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '657.com.tr GYS & İcra MY Sınav Platformu',
    url: new URL(path, site).href,
    description,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Tarayıcı',
    inLanguage: 'tr-TR',
    isAccessibleForFree: true,
  },
];
---
<Kabuk {...kabukProps} jsonLd={jsonLd}>
  <div class="gys-shell" id="gys-sinav-alani" data-gys-app data-gys-initial-tab={initialTab}>
    <script id="gys-mufredat-veri" type="application/json" set:html={JSON.stringify(mufredat)}></script>
    <script id="gys-agac-veri" type="application/json" set:html={JSON.stringify(agac)}></script>
    <script id="gys-konular-veri" type="application/json" set:html={JSON.stringify(konular)}></script>
    <script id="gys-sorular-veri" type="application/json" set:html={JSON.stringify(tumSorular)}></script>

    <!-- SOL KOYU LACİVERT UYGULAMA MENÜSÜ -->
    <aside class="gys-sidebar" aria-label="GYS çalışma menüsü">
      <div class="gys-sb-profil">
        <div class="gys-sb-profil__ust">
          <span class="gys-sb-avatar" aria-hidden="true">657</span>
          <div>
            <strong>Hoş geldin</strong>
            <span class="gys-sb-rozet">Ücretsiz Tam Erişim</span>
          </div>
        </div>
        <label class="gys-sb-unvan">
          <span>Hazırlandığın Sınav</span>
          <select data-gys-unvan>
            {mufredat.unvanlar.map((u) => (
              <option value={u.id}>{u.ad} ({u.toplamSoru} soru)</option>
            ))}
          </select>
        </label>
        <div class="gys-sb-kpi">
          <div class="gys-sb-kpi--d"><span>Doğru</span><strong class="num" data-gys-sb-dogru>0</strong></div>
          <div class="gys-sb-kpi--y"><span>Yanlış</span><strong class="num" data-gys-sb-yanlis>0</strong></div>
          <div class="gys-sb-kpi--o"><span>İsabet</span><strong class="num" data-gys-st-oran>%0</strong></div>
        </div>
        <div class="gys-sb-baraj">
          <div class="gys-sb-baraj__ust"><span>Genel Başarı (Baraj %70)</span><strong class="num" data-gys-st-toplam>0</strong></div>
          <div class="gys-sb-baraj__ray"><div class="gys-sb-baraj__dolgu" data-gys-baraj-bar style="width:0%"></div></div>
        </div>
      </div>

      <nav class="gys-sb-nav" role="tablist" aria-label="GYS modülleri">
        <div class="gys-sb-grup">ÇALIŞ</div>
        <button type="button" class="gys-sb-btn is-active" role="tab" data-gys-tab="sinav" aria-selected="true">Sınav &amp; Soru Ağacı</button>
        <button type="button" class="gys-sb-btn" role="tab" data-gys-tab="konular" aria-selected="false">Tüm Konular <span class="gys-sb-pill num">{konular.length}</span></button>
        <button type="button" class="gys-sb-btn" data-gys-hizli-rastgele>∞ Rastgele Soru Çöz</button>
        <button type="button" class="gys-sb-btn" data-gys-yaris-60>⏱ 60 sn Yarış</button>

        <div class="gys-sb-grup">TEKRAR ET</div>
        <button type="button" class="gys-sb-btn" role="tab" data-gys-tab="hatalar" aria-selected="false">Hatalı Sorular <span class="gys-sb-pill num" data-gys-st-hata>0</span></button>
        <button type="button" class="gys-sb-btn" data-gys-kayitli-coz>🔖 Kaydedilenler <span class="gys-sb-pill num" data-gys-kayitli-sayi>0</span></button>
        <button type="button" class="gys-sb-btn" role="tab" data-gys-tab="kitapcik" aria-selected="false">Konu Kitapçıkları</button>
        <button type="button" class="gys-sb-btn" role="tab" data-gys-tab="pdf" aria-selected="false">Baskı Kitapçığı (PDF)</button>

        <div class="gys-sb-grup">YARIŞ &amp; ANALİZ</div>
        <button type="button" class="gys-sb-btn" role="tab" data-gys-tab="canli" aria-selected="false">Canlı Sınav &amp; Sıralama</button>
        <button type="button" class="gys-sb-btn" role="tab" data-gys-tab="performans" aria-selected="false">Performansım</button>
        <button type="button" class="gys-sb-btn" data-gys-zayif-coz>🎯 Zayıf Konu Tekrarı</button>

        <div class="gys-sb-grup">TOPLULUK &amp; RESMÎ</div>
        <button type="button" class="gys-sb-btn" role="tab" data-gys-tab="ekle" aria-selected="false">Soru Stüdyosu</button>
        <button type="button" class="gys-sb-btn" role="tab" data-gys-tab="takvim" aria-selected="false">İlanlar &amp; Mevzuat</button>
      </nav>
    </aside>

    <!-- SAĞ ANA ÇALIŞMA TUVALİ -->
    <div class="gys-main gys-sayfa">
      <section class="gys-hero-serit" aria-label="Özet ve hızlı başlat">
        <div class="gys-hero-serit__sol">
          <h1>Görevde Yükselme Sınav Merkezi</h1>
          <p>Kaldığın yerden devam et, hedefe her gün biraz daha yaklaş.</p>
          <p class="gys-son-ders" data-gys-son-ders></p>
          <div class="gys-zayif-bar" data-gys-zayif hidden></div>
        </div>
        <div class="gys-hero-serit__sag">
          <div class="gys-kpi-hap"><span>Aktif Havuz</span><strong class="num" data-gys-havuz-sayi>{tumSorular.length}</strong></div>
          <div class="gys-kpi-hap"><span>Konu Takibi</span><strong class="num" data-gys-ust-konu>0 / {konular.length}</strong></div>
          <div class="gys-kpi-hap gys-kpi-hap--vurgu"><span>Bugün Hedef</span><strong class="num" data-gys-ust-bugun>0 / 50</strong></div>
          <button type="button" class="btn gys-hero-cta" data-gys-hizli-10>⚡ Hızlı 10 Soru</button>
        </div>
      </section>

      <PlatformSayacSeridi tur="gys" baslik="GYS Platformu — Çözülen Soru İstatistikleri" birim="soru" />

    <!-- 1. SINAV UYGULAMASI: SOL KATEGORİ AĞACI + SAĞ SINAV SAHNESİ -->
    <div class="gys-calisma" data-gys-panel="sinav">
      <aside class="panel gys-agac-panel" id="gys-agac-bolum" data-solid aria-label="Sınav ve mevzuat kategori ağacı">
        <div class="panel__head">
          <h2>Soru Havuzu Ağacı</h2>
          <span class="num gys-toplam-rozet" data-gys-toplam-havuz>{tumSorular.length} soru</span>
        </div>
        <div class="gys-agac-ic" data-gys-agac></div>
      </aside>

      <section class="panel gys-ana-panel" data-solid>
        <div class="panel__head">
          <div>
            <h2 data-gys-dugum-baslik>İnteraktif GYS Sınav Ekranı</h2>
            <p class="gys-yol" data-gys-dugum-yol>Adalet Bakanlığı</p>
          </div>
          <div class="gys-ust-etiketler">
            <span class="gys-mod-etiket" data-gys-aktif-mod>Klasik Mod (5 Şık)</span>
            <span class="gys-kronometre num" data-gys-sure hidden>00:00</span>
            <span class="gys-seri num" data-gys-seri hidden>Seri: 0</span>
          </div>
        </div>
        <div class="gys-ic">
          <div class="gys-filtreler">
            <label>
              <span>Ders / Mevzuat</span>
              <select data-gys-kanun></select>
            </label>
            <label>
              <span>Zorluk Seviyesi</span>
              <select data-gys-seviye>
                <option value="">Tüm Seviyeler</option>
                <option value="kolay">Kolay (Temel Ezber)</option>
                <option value="orta">Orta (Sınav Standardı)</option>
                <option value="zor">Zor (Tuzak &amp; İstisna)</option>
                <option value="akademik">Akademik (Yüksek Detay)</option>
                <option value="dip">En Dip (Madde İncelikleri)</option>
              </select>
            </label>
            <label>
              <span>Şık Modu</span>
              <select data-gys-mod>
                <option value="klasik">Klasik (1 Doğru · 4 Yanlış)</option>
                <option value="ikili">Hızlı Tekrar (1 Doğru · 1 Yanlış)</option>
              </select>
            </label>
            <label>
              <span>Soru Sayısı</span>
              <select data-gys-adet>
                <option value="10">10 Soru</option>
                <option value="20" selected>20 Soru</option>
                <option value="40">40 Soru</option>
                <option value="100">Tüm Havuz</option>
              </select>
            </label>
          </div>

          <div class="gys-eylem-bar">
            <button type="button" class="btn" data-gys-baslat>Testi Başlat</button>
            <button type="button" class="btn btn--quiet" data-gys-karisik>Karışık Çöz</button>
            <button type="button" class="btn btn--quiet" data-gys-sonsuz>∞ Sonsuz Test (Rastgele)</button>
            <button type="button" class="btn btn--quiet" data-gys-deneme>Kronometreli Deneme</button>
            <button type="button" class="btn btn--quiet" data-gys-topluluk-coz>Onay Bekleyen Sorular (<span data-gys-bekleyen-sayi>0</span>)</button>
            <button type="button" class="btn btn--quiet" data-gys-json-indir>Soruları İndir (JSON)</button>
          </div>

          <div class="gys-sahne" data-gys-sahne hidden>
            <div class="gys-ilerleme-ray" aria-hidden="true"><div class="gys-ilerleme-dolgu" data-gys-ilerleme-dolgu style="width:0%"></div></div>
            <div class="gys-sahne-duzen">
              <div class="gys-sahne-ana">
                <div class="gys-topluluk-uyari" data-gys-topluluk-uyari hidden>
                  ⚠️ <strong>Topluluk Sorusu (Henüz Onaylanmadı):</strong> Bu soru bir kullanıcı tarafından eklendi. Cevapladıktan sonra havuza eklenmesi için oy verebilirsiniz.
                </div>
                <div class="gys-soru-ust">
                  <span class="num gys-soru-no-hap" data-gys-sira>Soru 1 / 20</span>
                  <span class="gys-rozet" data-gys-rozet></span>
                  <span class="gys-varyasyon" data-gys-varyasyon></span>
                </div>
                <div class="gys-soru-istatistik" data-gys-soru-istatistik></div>
                <p class="gys-soru-metin" data-gys-soru-metin></p>
                <div class="gys-siklar" data-gys-siklar></div>
                <div class="gys-aciklama" data-gys-aciklama hidden></div>
                <div class="gys-oyla-bar" data-gys-oyla-bar hidden>
                  <span><strong>Bu soru resmî havuza eklensin mi?</strong></span>
                  <button type="button" class="btn btn--kucuk" data-gys-oy="evet">✓ Evet, Havuza Ekle</button>
                  <button type="button" class="btn btn--quiet btn--kucuk" data-gys-oy="hayir">✗ Hayır, Uygun Değil</button>
                  <span class="gys-oy-sonuc" data-gys-oy-sonuc></span>
                </div>
                <div class="gys-bildir-satir">
                  <button type="button" class="btn btn--quiet btn--kucuk" data-gys-kaydet>🔖 Soruyu Kaydet</button>
                  <button type="button" class="btn btn--quiet btn--kucuk" data-gys-bildir-ac="hata">⚠️ Hata Bildir</button>
                  <button type="button" class="btn btn--quiet btn--kucuk" data-gys-bildir-ac="telif">© Telif Bildir</button>
                </div>
                <form class="gys-bildir-form" data-gys-bildir-form hidden>
                  <input type="hidden" data-gys-bildir-tur value="hata" />
                  <label>
                    <span data-gys-bildir-baslik>Hata / Telif İhlali Açıklaması (en az 10 karakter)</span>
                    <textarea rows="2" required minlength="10" maxlength="1000" data-gys-bildir-metin placeholder="Madde numarası, hatalı şık veya telif kaynağını belirtin…"></textarea>
                  </label>
                  <div style="display:flex;gap:8px;align-items:center;">
                    <button type="submit" class="btn btn--kucuk">Bildirimi Gönder</button>
                    <button type="button" class="btn btn--quiet btn--kucuk" data-gys-bildir-iptal>Vazgeç</button>
                    <span data-gys-bildir-durum style="font-size:12px;"></span>
                  </div>
                </form>
                <div class="gys-soru-alt">
                  <div class="gys-soru-alt__sol">
                    <button type="button" class="btn btn--quiet btn--kucuk" data-gys-onceki hidden>← Önceki</button>
                    <button type="button" class="btn btn--kucuk" data-gys-sonraki hidden>Sonraki Soru →</button>
                    <button type="button" class="btn btn--quiet btn--kucuk" data-gys-bitir>Testi Bitir</button>
                  </div>
                  <label class="gys-oto-anahtar" title="Cevap verdikten 3 saniye sonra sonraki soruya otomatik geç">
                    <input type="checkbox" data-gys-otomatik />
                    <span>Otomatik geçiş (3 sn)</span>
                  </label>
                </div>
                <p class="gys-kisayol-not">Klavye kısayolları: <kbd>A–E</kbd> veya <kbd>1–5</kbd> işaretle · <kbd>→</kbd> sonraki · <kbd>K</kbd> kaydet</p>
              </div>
              <aside class="gys-skor-ray" aria-label="Canlı oturum sayacı">
                <div class="gys-skor-kutu gys-skor-kutu--dogru"><span>Doğru</span><strong class="num" data-gys-ray-dogru>0</strong></div>
                <div class="gys-skor-kutu gys-skor-kutu--yanlis"><span>Yanlış</span><strong class="num" data-gys-ray-yanlis>0</strong></div>
                <div class="gys-skor-kutu gys-skor-kutu--bugun"><span>Bugün</span><strong class="num" data-gys-ray-bugun>0</strong></div>
                <div class="gys-skor-kutu gys-skor-kutu--puan" data-gys-ray-puan-kutu hidden><span>Yarış Puanı</span><strong class="num" data-gys-ray-puan>0</strong></div>
              </aside>
            </div>
          </div>

          <div class="gys-sonuc" data-gys-sonuc hidden></div>
        </div>
      </section>
    </div>

    <!-- 1B. TÜM KONULAR (35 RESMÎ MEVZUAT & İLERLEME TAKİBİ) -->
    <section class="panel" data-gys-panel="konular" data-solid hidden>
      <div class="gys-konu-hero">
        <div>
          <h2>Tüm GYS Konuları ve Mevzuat Sıralaması ({konular.length} Konu)</h2>
          <p data-gys-konu-ozet>{konular.length} konudan 0 tanesini tamamladın (%0)</p>
          <div class="gys-konu-hero__ray"><div class="gys-konu-hero__dolgu" data-gys-konu-bar style="width:0%"></div></div>
        </div>
        <div class="gys-konu-hero__stat">
          <div><span>Tamamlanan</span><strong class="num" data-gys-konu-tamam-sayi>0</strong></div>
          <div><span>Kalan</span><strong class="num" data-gys-konu-kalan-sayi>{konular.length}</strong></div>
        </div>
      </div>
      <div class="gys-ic">
        <div class="gys-konu-filtre-bar">
          <input type="search" class="gys-konu-ara" data-gys-konu-ara placeholder={`${konular.length} konu içinde ara (ör. 657, Tebligat, HMK, Yazı İşleri, UYAP)...`} />
          <div class="gys-konu-haplar" role="group" aria-label="Konu filtresi">
            <button type="button" class="btn btn--kucuk" data-gys-konu-filtre="tumu" aria-pressed="true">Tümü ({konular.length})</button>
            <button type="button" class="btn btn--quiet btn--kucuk" data-gys-konu-filtre="ortak" aria-pressed="false">Ortak Konular</button>
            <button type="button" class="btn btn--quiet btn--kucuk" data-gys-konu-filtre="alan" aria-pressed="false">Alan Konuları</button>
            <button type="button" class="btn btn--quiet btn--kucuk" data-gys-konu-filtre="kalan" aria-pressed="false">Kalanlar</button>
            <button type="button" class="btn btn--quiet btn--kucuk" data-gys-konu-filtre="tamam" aria-pressed="false">Tamamlananlar</button>
          </div>
        </div>
        <div class="gys-konu-grid" data-gys-konu-liste></div>
      </div>
    </section>

    <!-- 2. HATALI SORULAR & DÖNEMSEL TEKRAR -->
    <section class="panel" data-gys-panel="hatalar" data-solid hidden>
      <div class="panel__head">
        <h2>Hatalı Sorular ve Zorunlu Öğrenme Tekrarı</h2>
        <button type="button" class="btn btn--quiet btn--kucuk" data-gys-istatistik-sifirla>İstatistikleri Sıfırla</button>
      </div>
      <div class="gys-ic">
        <div class="gys-hata-bar" role="group" aria-label="Hata dönemi">
          <button type="button" class="btn btn--kucuk" data-gys-hata-filtre="tumu" aria-pressed="true">Tüm Hatalılar</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-gys-hata-filtre="gunluk" aria-pressed="false">Bugün</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-gys-hata-filtre="haftalik" aria-pressed="false">Bu Hafta</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-gys-hata-filtre="aylik" aria-pressed="false">Bu Ay</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-gys-hata-filtre="encok" aria-pressed="false">En Çok Hatalı</button>
          <button type="button" class="btn btn--kucuk" data-gys-hata-coz style="margin-left:auto;">Seçili Hataları Tam Öğrenene Kadar Çöz →</button>
        </div>
        <div data-gys-hata-liste></div>
      </div>
    </section>

    <!-- 3. KONU ÇALIŞMA KİTAPÇIKLARI -->
    <section class="panel" data-gys-panel="kitapcik" data-solid hidden>
      <div class="panel__head"><h2>2026 GYS Konu Çalışma Kitapçıkları</h2></div>
      <div class="gys-ic">
        {mufredat.kitapciklar.map((k) => (
          <article class="gys-ders-kitap">
            <div class="gys-ders-kitap__ust">
              <div>
                <h3>{k.baslik}</h3>
                <p>{k.altBaslik}</p>
              </div>
              <button type="button" class="btn btn--kucuk" data-gys-kitap-coz={k.kanun}>Bu Konudan Soru Çöz →</button>
            </div>
            <div class="gys-ders-maddeler">
              {k.maddeler.map((m) => (
                <details open>
                  <summary>{m.baslik}</summary>
                  <p>{m.ozet}</p>
                </details>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 4. KİTAP BASKISI RENKLİ TEST KİTAPÇIĞI OLUŞTURUCU -->

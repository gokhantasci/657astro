---
// gys.657.com.tr çalışma uygulaması. Aynı bileşen /, /mulakat/, /canli-sinav/, /performans/, /studyo/ ve /ilanlar/
// adreslerinde farklı başlangıç paneliyle derlenir. Konu, soru ve sınav dizinleri ayrı statik sayfalardır.
import SubdomainLayout from '../layouts/SubdomainLayout.astro';
import PlatformSayacSeridi from './PlatformSayacSeridi.astro';
import mufredat from '../data/gys-mufredat.json';
import agac from '../data/gys-agac.json';
import konular from '../data/gys-konular.json';
import ilanlarMevzuat from '../data/gys-ilanlar-mevzuat.json';
import {
  GYS_MARKA,
  gysNav,
  gysSinavlar,
  gysSorular,
  gysUrl,
  sadeAd,
  sinavYolu,
  kisaYol,
} from '../lib/gys-yayin';
import '../styles/gys.css';

type Panel = 'sinav' | 'mulakat' | 'canli' | 'performans' | 'hatalar' | 'kitapcik' | 'pdf' | 'ekle' | 'takvim';
interface Props {
  standalone?: boolean;
  initialTab?: Panel;
  activeHref?: string;
}
const { initialTab = 'sinav', activeHref = '/' } = Astro.props;

const sayfa: Record<string, { title: string; description: string; h1: string; alt: string }> = {
  sinav: {
    title: 'GYS Soru Çöz: Adalet Bakanlığı, CTE ve İcra Görevde Yükselme Sınavı 2026 | gys.657.com.tr',
    description: `Bakanlığını, birimini ve ünvanını seç, görevde yükselme ve ünvan değişikliği sınavına ücretsiz çalış. ${gysSorular.length} soruluk havuz, ${konular.length} resmî konu, süreli deneme ve hatalı soru tekrarı.`,
    h1: 'Görevde yükselme sınavına çalış',
    alt: 'Sınavını bir kez seç; seçimin ve ayarların bu tarayıcıda hatırlanır.',
  },
  mulakat: {
    title: 'Sözlü Mülakat Soruları ve Komisyon Simülasyonu | GYS Sınav Platformu',
    description: 'Adalet Bakanlığı ve kamu görevde yükselme sözlü mülakat soruları: rastgele üç soruluk komisyon çekilişi, arama, bildiklerim ve tekrar listesi.',
    h1: 'Sözlü mülakat soruları',
    alt: 'Rastgele üç soru çek ya da konu adıyla ara.',
  },
  canli: {
    title: 'Canlı GYS Deneme Sınavı ve Türkiye Sıralaması | GYS Sınav Platformu',
    description: 'Zamanlı canlı görevde yükselme deneme sınavları ve katılımcı sıralaması.',
    h1: 'Canlı deneme sınavları',
    alt: 'Planlanan sınavlara katıl, skorunu sıralamaya gönder.',
  },
  performans: {
    title: 'GYS Çalışma Performansım | GYS Sınav Platformu',
    description: 'Çözdüğün soruların ders bazlı doğru ve yanlış oranları. Veriler yalnız bu tarayıcıda tutulur.',
    h1: 'Performansım',
    alt: 'Ders bazında başarı oranın ve zayıf konuların.',
  },
  ekle: {
    title: 'GYS Soru Stüdyosu: Soru Hazırla ve Gönder | GYS Sınav Platformu',
    description: 'Kendi görevde yükselme sorunu hazırla, JSON olarak indir veya topluluk onayına gönder.',
    h1: 'Soru stüdyosu',
    alt: 'Kendi sorunu hazırla, indir ya da onaya gönder.',
  },
  takvim: {
    title: 'GYS İlanları, Sınav Takvimi ve Resmî Mevzuat Listesi | GYS Sınav Platformu',
    description: 'Adalet Bakanlığı, CTE ve ÖSYM görevde yükselme sınav ilanları, ekleri, sınav takvimi ve mevzuat.gov.tr bağlantıları.',
    h1: 'İlanlar ve mevzuat',
    alt: 'Resmî duyurular, sınav takvimi ve çalışılacak mevzuatın resmî bağlantıları.',
  },
};
const meta = sayfa[initialTab] ?? sayfa.sinav;

// Sekme çubuğundaki modüller; diğer paneller üst menüdeki kendi sayfalarıyla açılır.
const sekmeler: { id: Panel; ad: string; sayac?: string }[] = [
  { id: 'sinav', ad: 'Test çöz' },
  { id: 'hatalar', ad: 'Hatalı sorularım', sayac: 'data-gys-st-hata' },
  { id: 'kitapcik', ad: 'Konu özetleri' },
  { id: 'pdf', ad: 'Baskı kitapçığı' },
  { id: 'performans', ad: 'Performansım' },
  { id: 'ekle', ad: 'Soru ekle' },
];
const sekmeIdleri = new Set(sekmeler.map((s) => s.id));
const sekmeGorunur = sekmeIdleri.has(initialTab);

const gysHaberler = [
  { baslik: 'Adalet Bakanlığı Görevde Yükselme Sınav Süreçleri (2015–2026 Takvim)', url: '/adalet-bakanligi-gorevde-yukselme-sinav-surecleri-2015-2026-yillara-gore-takvim/', etiket: 'PGM takvimi' },
  { baslik: 'Yazı İşleri Müdürü Görevde Yükselme Sınav Şartları', url: '/adalet-bakanligi-yazi-isleri-muduru-gorevde-yukselme-sinav-sartlari-nelerdir/', etiket: 'Yazı işleri' },
  { baslik: 'İdari İşler Müdürü Görevde Yükselme Sınav Şartları', url: '/adalet-bakanligi-idari-isler-muduru-gorevde-yukselme-sinav-sartlari-nelerdir/', etiket: 'İdari işler' },
  { baslik: 'Adalet Bakanlığı Şef Görevde Yükselme Sınav Şartları', url: '/adalet-bakanligi-sef-gorevde-yukselme-sinav-sartlari-nelerdir/', etiket: 'Şef' },
  { baslik: 'CTE Kurum İkinci Müdürü, İdare Memuru ve İKBM GYS Şartları', url: '/cte-kurum-ikinci-muduru-idare-memuru-infaz-koruma-basmemuru-gys-sartlari-nelerdir/', etiket: 'CTE' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: GYS_MARKA,
    url: gysUrl(activeHref),
    description: meta.description,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Tarayıcı',
    inLanguage: 'tr-TR',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  },
];
---
<SubdomainLayout
  title={meta.title}
  description={meta.description}
  canonical={gysUrl(activeHref)}
  brand={GYS_MARKA}
  brandTag="GYS · 657"
  themeVariant="gys"
  manifest="/gys-manifest.webmanifest"
  nav={gysNav}
  jsonLd={jsonLd}
>
  <div class="gys-sayfa gys-uygulama" id="gys-sinav-alani" data-gys-app data-gys-initial-tab={initialTab}>
    <script id="gys-mufredat-veri" type="application/json" set:html={JSON.stringify(mufredat)}></script>
    <script id="gys-agac-veri" type="application/json" set:html={JSON.stringify(agac)}></script>
    <script id="gys-konular-veri" type="application/json" set:html={JSON.stringify(konular)}></script>
    <script id="gys-sorular-veri" type="application/json" set:html={JSON.stringify(gysSorular)}></script>

    <header class="gys-baslik gys-calis-ust">
      <h1>{meta.h1}</h1>
      <p>{meta.alt}</p>
    </header>

    <nav class="gys-sekmeler" role="tablist" aria-label="Çalışma modülleri" data-gys-sekmeler hidden={!sekmeGorunur}>
      {sekmeler.map((s) => (
        <button type="button" class="gys-sekme" role="tab" data-gys-tab={s.id} aria-selected={s.id === initialTab ? 'true' : 'false'}>
          {s.ad}
          {s.sayac && <span class="gys-sayac" {...{ [s.sayac]: '' }}>0</span>}
        </button>
      ))}
    </nav>

    <!-- TEST ÇÖZ -->
    <div class="gys-panel" data-gys-panel="sinav" hidden={initialTab !== 'sinav'}>
      <div class="gys-calis-ust" style="display:grid;gap:var(--space-md);">
        <section class="gys-kart" aria-labelledby="gys-secim-baslik">
          <div class="gys-secim-ozet">
            <div class="gys-secim-ozet__metin">
              <span class="gys-secim-ozet__etiket" id="gys-secim-baslik">Hazırlandığın sınav</span>
              <strong class="gys-secim-ozet__ad" data-gys-secim-ad>Bütün bakanlıklar</strong>
              <span class="gys-secim-ozet__yol" data-gys-secim-yol>{gysSorular.length} soru · istersen bakanlık, birim ve ünvan seç</span>
            </div>
            <button type="button" class="btn btn--quiet" data-gys-secim-ac aria-expanded="false" aria-controls="gys-secici">Sınavı değiştir</button>
          </div>
          <div class="gys-secici" id="gys-secici" data-gys-secici hidden>
            <div class="gys-secici__ara">
              <label for="gys-secici-ara">Bakanlık, birim ya da ünvan ara</label>
              <input id="gys-secici-ara" type="search" autocomplete="off" placeholder="Örn. yazı işleri, CTE, şef, icra" data-gys-secici-ara role="combobox" aria-expanded="false" aria-controls="gys-secici-sonuc" aria-autocomplete="list" />
              <ul class="gys-secici__sonuc" id="gys-secici-sonuc" role="listbox" data-gys-secici-sonuc hidden></ul>
            </div>
            <div class="gys-secici__satirlar" data-gys-secici-satirlar></div>
            <div class="gys-secici__alt">
              <button type="button" class="btn" data-gys-secim-tamam>Bu sınavla devam et</button>
              <span class="gys-havuz-not" data-gys-secici-not></span>
            </div>
          </div>
        </section>

        <section class="gys-kart gys-kart__ic" aria-labelledby="gys-ayar-baslik">
          <div class="gys-kart__bas">
            <h2 id="gys-ayar-baslik">Test ayarları</h2>
            <p data-gys-havuz-not>{gysSorular.length} soru</p>
          </div>
          <div class="gys-ayarlar">
            <label class="gys-alan">
              <span>Ders</span>
              <select data-gys-kanun><option value="">Bütün dersler</option></select>
            </label>
            <label class="gys-alan">
              <span>Zorluk</span>
              <select data-gys-seviye>
                <option value="">Bütün seviyeler</option>
                <option value="kolay">Kolay</option>
                <option value="orta">Orta (sınav düzeyi)</option>
                <option value="zor">Zor (istisna ve tuzak)</option>
                <option value="akademik">Akademik</option>
                <option value="dip">Madde ayrıntısı</option>
              </select>
            </label>
            <fieldset class="gys-alan">
              <legend>Soru sayısı</legend>
              <div class="gys-segment" data-gys-adet>
                {[['10', '10'], ['20', '20'], ['40', '40'], ['0', 'Tümü']].map(([v, ad]) => (
                  <label><input type="radio" name="gys-adet" value={v} checked={v === '20'} /><span>{ad}</span></label>
                ))}
              </div>
            </fieldset>
            <fieldset class="gys-alan">
              <legend>Şıklar</legend>
              <div class="gys-segment" data-gys-mod>
                <label><input type="radio" name="gys-mod" value="klasik" checked /><span>5 şık</span></label>
                <label><input type="radio" name="gys-mod" value="ikili" /><span>2 şık (hızlı)</span></label>
              </div>
            </fieldset>
          </div>
          <div class="gys-baslat">
            <button type="button" class="btn gys-baslat__ana" data-gys-baslat>Testi başlat</button>
            <button type="button" class="btn btn--quiet" data-gys-deneme>Süreli deneme <span class="num" data-gys-deneme-not>(80 soru · 90 dk)</span></button>
            <button type="button" class="btn btn--quiet" data-gys-sonsuz>Sınırsız soru</button>
          </div>
        </section>

        <section aria-label="Hızlı başla">
          <div class="gys-hizli">
            <button type="button" data-gys-hizli-10><strong>Hızlı 10 soru</strong><span>Seçili sınavdan karışık</span></button>
            <button type="button" data-gys-yaris-60><strong>60 saniye yarışı</strong><span>Doğruya +10, yanlışa −3</span></button>
            <button type="button" data-gys-hatali-coz><strong>Hatalarımı çöz <span class="gys-sayac" data-gys-st-hata-2>0</span></strong><span>Doğru yapana kadar tekrar</span></button>
            <button type="button" data-gys-kayitli-coz><strong>Kaydettiklerim <span class="gys-sayac" data-gys-kayitli-sayi>0</span></strong><span>İşaretlediğin sorular</span></button>
            <button type="button" data-gys-zayif-coz><strong>Zayıf dersim</strong><span>En düşük oranlı dersten 15 soru</span></button>
          </div>
        </section>

        <section class="gys-olcu" aria-label="Çalışma özetim">
          <div><span>Çözülen</span><strong class="num" data-gys-st-toplam>0</strong></div>
          <div><span>Doğru</span><strong class="num" data-gys-sb-dogru>0</strong></div>
          <div><span>Yanlış</span><strong class="num" data-gys-sb-yanlis>0</strong></div>
          <div><span>İsabet</span><strong class="num" data-gys-st-oran>%0</strong></div>
          <div><span>Bugün</span><strong class="num" data-gys-ust-bugun>0 / 50</strong></div>
          <div><span>Tamamlanan konu</span><strong class="num" data-gys-ust-konu>0 / {konular.length}</strong></div>
        </section>
        <div class="gys-zayif-bar" data-gys-zayif hidden></div>
      </div>

      <section class="gys-kart gys-kart__ic gys-sahne" data-gys-sahne hidden aria-live="polite">
        <div class="gys-sahne__ust">
          <div class="gys-sahne__baslik">
            <strong data-gys-dugum-baslik>Test</strong>
            <span data-gys-dugum-yol></span>
          </div>
          <div class="gys-etiketler">
            <span class="gys-etiket" data-gys-aktif-mod>5 şık</span>
            <span class="gys-etiket gys-etiket--sure num" data-gys-sure hidden>00:00</span>
            <span class="gys-etiket gys-etiket--seri num" data-gys-seri hidden>Seri: 0</span>
          </div>
        </div>
        <div class="gys-ilerleme-ray" aria-hidden="true"><div class="gys-ilerleme-dolgu" data-gys-ilerleme-dolgu style="width:0%"></div></div>
        <div class="gys-sahne-duzen">
          <div class="gys-sahne-ana">
            <div class="gys-topluluk-uyari" data-gys-topluluk-uyari hidden>
              <strong>Topluluk sorusu:</strong> Bu soruyu bir kullanıcı ekledi, henüz onaylanmadı. Cevapladıktan sonra oy verebilirsin.
            </div>
            <div class="gys-soru-ust">
              <span class="gys-soru-no num" data-gys-sira>Soru 1 / 20</span>
              <span class="gys-etiket" data-gys-rozet></span>
            </div>
            <p class="gys-soru-metin" data-gys-soru-metin></p>
            <div class="gys-siklar" data-gys-siklar></div>
            <div class="gys-aciklama" data-gys-aciklama hidden></div>
            <div class="gys-oyla-bar" data-gys-oyla-bar hidden>
              <strong>Bu soru resmî havuza eklensin mi?</strong>
              <button type="button" class="btn btn--kucuk" data-gys-oy="evet">Evet, eklensin</button>
              <button type="button" class="btn btn--quiet btn--kucuk" data-gys-oy="hayir">Hayır, uygun değil</button>
              <span data-gys-oy-sonuc></span>
            </div>
            <div class="gys-soru-istatistik" data-gys-soru-istatistik></div>
            <div class="gys-soru-alt">
              <div class="gys-soru-alt__sol">
                <button type="button" class="btn btn--quiet btn--kucuk" data-gys-onceki hidden>← Önceki</button>
                <button type="button" class="btn btn--kucuk" data-gys-sonraki hidden>Sonraki soru →</button>
                <button type="button" class="btn btn--quiet btn--kucuk" data-gys-bitir>Testi bitir</button>
              </div>
              <label class="gys-oto-anahtar" title="Cevap verdikten 3 saniye sonra sonraki soruya geçer">
                <input type="checkbox" data-gys-otomatik />
                <span>Otomatik geç (3 sn)</span>
              </label>
            </div>
            <div class="gys-arac-satir">
              <button type="button" class="gys-metin-btn" data-gys-kaydet>Soruyu kaydet</button>
              <button type="button" class="gys-metin-btn" data-gys-bildir-ac="hata">Hata bildir</button>
              <button type="button" class="gys-metin-btn" data-gys-bildir-ac="telif">Telif bildir</button>
              <a class="gys-metin-btn" data-gys-soru-sayfa href="/sorular/">Soru sayfası</a>
            </div>
            <form class="gys-form" data-gys-bildir-form hidden>
              <input type="hidden" data-gys-bildir-tur value="hata" />
              <label>
                <span data-gys-bildir-baslik>Hata açıklaması (en az 10 karakter)</span>
                <textarea rows="2" required minlength="10" maxlength="1000" data-gys-bildir-metin placeholder="Madde numarası, hatalı şık veya kaynak"></textarea>
              </label>
              <div class="gys-form__eylem">
                <button type="submit" class="btn btn--kucuk">Gönder</button>
                <button type="button" class="btn btn--quiet btn--kucuk" data-gys-bildir-iptal>Vazgeç</button>
                <span class="gys-durum" data-gys-bildir-durum></span>
              </div>
            </form>
            <p class="gys-kisayol-not">Kısayollar: <kbd>A–E</kbd> ya da <kbd>1–5</kbd> şık · <kbd>→</kbd> sonraki · <kbd>K</kbd> kaydet</p>
          </div>
          <aside class="gys-skor-ray" aria-label="Bu testin sayacı">
            <div class="gys-skor-kutu gys-skor-kutu--dogru"><span>Doğru</span><strong data-gys-ray-dogru>0</strong></div>
            <div class="gys-skor-kutu gys-skor-kutu--yanlis"><span>Yanlış</span><strong data-gys-ray-yanlis>0</strong></div>
            <div class="gys-skor-kutu"><span>Bugün</span><strong data-gys-ray-bugun>0</strong></div>
            <div class="gys-skor-kutu" data-gys-ray-puan-kutu hidden><span>Yarış puanı</span><strong data-gys-ray-puan>0</strong></div>
          </aside>
        </div>
      </section>

      <section class="gys-kart gys-sonuc" data-gys-sonuc hidden aria-live="polite"></section>

      <div class="gys-alt-bilgi" style="display:grid;gap:var(--space-md);margin-top:var(--space-lg);">
        <section class="gys-kart gys-kart__ic" aria-labelledby="gys-sinav-dizin">
          <div class="gys-kart__bas">
            <h2 id="gys-sinav-dizin">Sınava göre çalış</h2>
            <a href="/sinavlar/">Bütün sınavlar</a>
          </div>
          <ul class="gys-izgara" style="list-style:none;margin:0;padding:0;">
            {gysSinavlar.map((s) => (
              <li>
                <a class="gys-bag-kart" href={sinavYolu(s.dugum.id)}>
                  <strong>{sadeAd(s.dugum.ad)}</strong>
                  <small>{kisaYol(s.yol) || 'Ortak'} · {s.sorular.length} soru</small>
                </a>
              </li>
            ))}
          </ul>
        </section>
        <PlatformSayacSeridi tur="gys" baslik="Platformda çözülen sorular" birim="soru" />
      </div>
    </div>

    <!-- HATALI SORULAR -->
    <section class="gys-kart gys-kart__ic" data-gys-panel="hatalar" hidden={initialTab !== 'hatalar'}>
      <div class="gys-kart__bas">
        <h2>Hatalı sorularım</h2>
        <button type="button" class="btn btn--quiet btn--kucuk" data-gys-istatistik-sifirla>İstatistikleri sıfırla</button>
      </div>
      <div class="gys-hata-bar" role="group" aria-label="Dönem">
        <button type="button" class="gys-filtre" data-gys-hata-filtre="tumu" aria-pressed="true">Hepsi</button>
        <button type="button" class="gys-filtre" data-gys-hata-filtre="gunluk" aria-pressed="false">Bugün</button>
        <button type="button" class="gys-filtre" data-gys-hata-filtre="haftalik" aria-pressed="false">Bu hafta</button>
        <button type="button" class="gys-filtre" data-gys-hata-filtre="aylik" aria-pressed="false">Bu ay</button>
        <button type="button" class="gys-filtre" data-gys-hata-filtre="encok" aria-pressed="false">En çok yanlış</button>
        <button type="button" class="btn btn--kucuk" data-gys-hata-coz style="margin-left:auto;">Bunları doğru yapana kadar çöz</button>
      </div>
      <div data-gys-hata-liste></div>
    </section>

    <!-- KONU ÖZETLERİ -->
    <section class="gys-kart gys-kart__ic" data-gys-panel="kitapcik" hidden={initialTab !== 'kitapcik'}>
      <div class="gys-kart__bas">
        <h2>Konu özetleri</h2>
        <a href="/konular/">Bütün konular ({konular.length})</a>
      </div>
      {mufredat.kitapciklar.map((k) => (
        <article class="gys-ders-kitap">
          <div class="gys-ders-kitap__ust">
            <div>
              <h3>{k.baslik}</h3>
              <p>{k.altBaslik}</p>
            </div>
            <button type="button" class="btn btn--kucuk" data-gys-kitap-coz={k.kanun}>Bu dersten soru çöz</button>
          </div>
          <div class="gys-ders-maddeler">
            {k.maddeler.map((m) => (
              <details>
                <summary>{m.baslik}</summary>
                <p>{m.ozet}</p>
              </details>
            ))}
          </div>
        </article>
      ))}
    </section>

    <!-- BASKI KİTAPÇIĞI -->
    <section class="gys-kart gys-kart__ic" data-gys-panel="pdf" hidden={initialTab !== 'pdf'}>
      <div class="gys-kart__bas">
        <h2>Baskı kitapçığı</h2>
        <p>İki sütunlu test kitapçığı ve cevap anahtarı; yazdırabilir ya da PDF olarak kaydedebilirsin.</p>
      </div>
      <div class="gys-ayarlar">
        <label class="gys-alan">
          <span>Kitapçık türü</span>
          <select data-gys-pdf-tip>
            <option value="agirlikli">Resmî ders ağırlıklarına göre karma</option>
            <option value="ozel">Seçili sınav ve dersten</option>
          </select>
        </label>
        <label class="gys-alan">
          <span>Ders</span>
          <select data-gys-pdf-kanun><option value="">Bütün dersler</option></select>
        </label>
        <label class="gys-alan">
          <span>Soru sayısı</span>
          <select data-gys-pdf-adet>
            <option value="10">10</option>
            <option value="20" selected>20</option>
            <option value="40">40</option>
            <option value="80">80</option>
          </select>
        </label>
        <label class="gys-alan">
          <span>Şıklar</span>
          <select data-gys-pdf-mod>
            <option value="klasik">5 şık (A–E)</option>
            <option value="ikili">2 şık (A–B)</option>
          </select>
        </label>
      </div>
      <div class="gys-baslat">
        <button type="button" class="btn" data-gys-pdf-uret>Kitapçığı oluştur</button>
      </div>
      <div class="gys-pdf-eylem" data-gys-pdf-eylem hidden>
        <button type="button" class="btn btn--kucuk" data-gys-pdf-yazdir>Yazdır / PDF kaydet</button>
        <button type="button" class="btn btn--quiet btn--kucuk" data-gys-pdf-indir>HTML olarak indir</button>
      </div>
      <div class="gys-pdf-onizleme" data-gys-pdf-onizleme></div>
    </section>

    <!-- PERFORMANS -->
    <section class="gys-kart gys-kart__ic" id="gys-performans" data-gys-panel="performans" hidden={initialTab !== 'performans'}>
      <div class="gys-kart__bas">
        <h2>Ders bazında başarı</h2>
        <p>Veriler yalnız bu tarayıcıda saklanır.</p>
      </div>
      <div data-gys-perf-liste></div>
    </section>

    <!-- SORU STÜDYOSU -->
    <section class="gys-kart gys-kart__ic" id="gys-studyo" data-gys-panel="ekle" hidden={initialTab !== 'ekle'}>
      <div class="gys-kart__bas">
        <h2>Kendi sorunu hazırla</h2>
        <button type="button" class="btn btn--quiet btn--kucuk" data-gys-ozel-indir hidden>Hazırladıklarımı indir (JSON)</button>
      </div>
      <p class="gys-ipucu" style="margin-bottom:var(--space-md);">
        Sorunu kendi listene ekleyip JSON olarak indirebilir ya da onaya gönderebilirsin. Onay bekleyen sorular diğer kullanıcılara uyarıyla sorulur; yeterli onay oyu ya da yönetici onayı alınca havuza katılır.
      </p>
      <div class="gys-eylem-bar">
        <button type="button" class="btn btn--quiet btn--kucuk" data-gys-topluluk-coz>Onay bekleyen soruları çöz (<span class="num" data-gys-bekleyen-sayi>0</span>)</button>
        <button type="button" class="btn btn--quiet btn--kucuk" data-gys-json-indir>Seçili sınavın sorularını indir (JSON)</button>
      </div>
      <form class="gys-form" data-gys-ekle-form>
        <div class="gys-form__satir">
          <label>
            <span>Ders</span>
            <select data-gys-ekle-kanun>
              {mufredat.kanunlar.map((k) => <option value={k.id}>{k.kisa}</option>)}
            </select>
          </label>
          <label>
            <span>Bölüm</span>
            <select data-gys-ekle-bolum>
              {mufredat.kanunlar.flatMap((k) => k.bolumler.map((b) => <option value={b.id} data-kanun={k.id}>{b.ad}</option>))}
            </select>
          </label>
          <label>
            <span>Zorluk</span>
            <select data-gys-ekle-seviye>
              <option value="kolay">Kolay</option>
              <option value="orta" selected>Orta</option>
              <option value="zor">Zor</option>
              <option value="akademik">Akademik</option>
              <option value="dip">Madde ayrıntısı</option>
            </select>
          </label>
        </div>
        <label><span>Soru metni (en az 20 karakter)</span><textarea rows="3" required minlength="20" data-gys-ekle-soru placeholder="Örn. 7201 sayılı Tebligat Kanunu m. 7/a uyarınca…"></textarea></label>
        <label><span>Doğru cevaplar (her satıra bir tane)</span><textarea rows="2" required data-gys-ekle-dogru></textarea></label>
        <label><span>Yanlış şıklar (her satıra bir tane, en az 4)</span><textarea rows="4" required data-gys-ekle-yanlis></textarea></label>
        <div class="gys-form__satir">
          <label><span>Dayanak (madde, genelge)</span><input type="text" required minlength="3" data-gys-ekle-kaynak placeholder="Örn. 7201 sayılı Kanun m. 21/2" /></label>
          <label><span>Açıklama</span><input type="text" required minlength="10" data-gys-ekle-aciklama placeholder="Doğru cevabın gerekçesi" /></label>
        </div>
        <div class="gys-form__eylem">
          <button type="button" class="btn btn--quiet" data-gys-ekle-yerel>Kendi listeme ekle</button>
          <button type="submit" class="btn">Onaya gönder</button>
          <span class="gys-durum" data-gys-ekle-durum></span>
        </div>
      </form>
      <div data-gys-ozel-liste></div>
    </section>

    <!-- MÜLAKAT (gys-mulakat.ts) -->
    <section class="gys-kart gys-kart__ic" data-gys-panel="mulakat" hidden={initialTab !== 'mulakat'}>
      <div class="gys-konu-hero">
        <div>
          <h2>Komisyon simülasyonu</h2>
          <p>Güncellenmiş 2.239 Adalet Bakanlığı ve kamu mülakat sorusu: üç soruluk rastgele çekiliş ya da arama.</p>
        </div>
        <div class="gys-konu-hero__stat">
          <div><span>Bildiklerim</span><strong class="num" data-mul-bildim-sayi>0</strong></div>
          <div><span>Tekrar</span><strong class="num" data-mul-tekrar-sayi>0</strong></div>
        </div>
      </div>
      <div class="gys-eylem-bar">
        <button type="button" class="btn btn--kucuk" data-mul-cek>Üç soruluk mülakat çek</button>
        <span class="gys-toplam-rozet num" data-mul-sayi>2.239 soru</span>
      </div>
      <div data-mul-kart-alan hidden style="margin-bottom:16px;"></div>
      <div class="gys-konu-filtre-bar">
        <input type="search" class="gys-konu-ara" data-mul-ara aria-label="Mülakat sorularında ara" placeholder="Mülakat sorularında ara (ör. 7499, CMK, tebligat, HSK, disiplin)" />
        <div class="gys-konu-haplar" role="group" aria-label="Mülakat filtresi">
          <button type="button" class="btn btn--kucuk" data-mul-filtre="tumu" aria-pressed="true">Tümü</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-mul-filtre="mulakat" aria-pressed="false">Mülakatta çıkanlar</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-mul-filtre="tekrar" aria-pressed="false">Tekrar listem</button>
          <button type="button" class="btn btn--quiet btn--kucuk" data-mul-filtre="bildim" aria-pressed="false">Bildiklerim</button>
        </div>
      </div>
      <div class="mul-liste" data-mul-liste></div>
      <div style="margin-top:12px;text-align:center;">
        <button type="button" class="btn btn--quiet btn--kucuk" data-mul-daha hidden>Sonraki sorular</button>
      </div>
    </section>

    <!-- İLANLAR VE MEVZUAT -->
    <div class="gys-panel gys-panel--yigin" id="gys-takvim" data-gys-panel="takvim" hidden={initialTab !== 'takvim'}>
      <script id="gys-mevzuat-veri" type="application/json" set:html={JSON.stringify(ilanlarMevzuat)}></script>
      <section class="gys-kart gys-kart__ic">
        <div class="gys-kart__bas"><h2>Resmî sınav ilanları</h2></div>
        <div class="gys-izgara">
          {ilanlarMevzuat.ilanlar.map((ilan) => (
            <article class="gys-bag-kart">
              <small>{ilan.kurum} · {ilan.tarih}</small>
              <strong>{ilan.baslik}</strong>
              <p>{ilan.ozet}</p>
              <a class="gys-ek-link" href={ilan.resmiUrl} target="_blank" rel="noopener">Resmî duyuru ↗</a>
              {ilan.ekler.map((ek) => (
                <a class="gys-ek-link" href={ek.url} target="_blank" rel="noopener">{ek.ad} ↗</a>
              ))}
            </article>
          ))}
        </div>
      </section>
      <section class="gys-kart gys-kart__ic">
        <div class="gys-kart__bas">
          <h2>Çalışılacak mevzuat</h2>
          <button type="button" class="btn btn--quiet btn--kucuk" data-gys-mevzuat-indir>Seçili sınavın listesini indir (.txt)</button>
        </div>
        <p class="gys-ipucu" style="margin-bottom:var(--space-md);">Her bağlantı mevzuat.gov.tr'deki güncel resmî metni açar.</p>
        <div class="gys-izgara" data-gys-mevzuat-liste>
          {ilanlarMevzuat.mevzuatlar.map((m) => (
            <a class="gys-bag-kart" href={m.url} target="_blank" rel="noopener">
              <small>{m.grup}</small>
              <strong>{m.ad}</strong>
            </a>
          ))}
        </div>
      </section>
      <section class="gys-kart gys-kart__ic">
        <div class="gys-kart__bas"><h2>Sınav takvimi ve rehberler</h2></div>
        <div class="gys-tablo-sar">
          <table class="gys-tablo">
            <thead>
              <tr><th>Sınav</th><th>Dönem</th><th>Soru ve süre</th><th>Baraj</th><th>Kurum</th></tr>
            </thead>
            <tbody>
              <tr><td>PGM görevde yükselme (taşra ve merkez)</td><td>2015 · 2018 · 2021 · 2023 · 2025–2026</td><td>80 soru (32 ortak + 48 alan) / 100 dk</td><td class="num">60</td><td>ANKÜSEM / MEB</td></tr>
              <tr><td>CTE görevde yükselme (kurum 2. müdürü, idare memuru, İKBM)</td><td>2016 · 2019 · 2022 · 2025–2026</td><td>80–100 soru / 90–110 dk</td><td class="num">60</td><td>ANKÜSEM / MEB</td></tr>
              <tr><td>İcra müdür ve müdür yardımcılığı</td><td>2020 · 2022 · 2024 · 2026</td><td>80 soru (35 GY-GK + 45 alan) / 105 dk</td><td class="num">70</td><td>ÖSYM</td></tr>
            </tbody>
          </table>
        </div>
        <ul class="gys-bag-liste" style="margin-top:var(--space-md);">
          {gysHaberler.map((h) => (
            <li><a href={`https://657.com.tr${h.url}`}>{h.baslik}</a><small>{h.etiket}</small></li>
          ))}
        </ul>
      </section>
    </div>

    <!-- CANLI SINAV -->
    <section class="gys-kart gys-kart__ic" id="gys-canli-sinav" data-gys-panel="canli" data-gys-canli-root hidden={initialTab !== 'canli'}>
      <div class="gys-kart__bas">
        <h2>Planlanan sınavlar</h2>
        <span class="gys-etiket" data-cs-durum>Yükleniyor…</span>
      </div>
      <div class="cs-liste" data-cs-liste></div>
      <details class="cs-admin-kutu">
        <summary>Yönetici: yeni canlı sınav planla</summary>
        <form class="gys-form" data-cs-admin-form>
          <div class="gys-form__satir">
            <label><span>Yönetici anahtarı</span><input type="password" name="adminKey" required autocomplete="current-password" /></label>
            <label><span>Sınav başlığı</span><input type="text" name="baslik" required minlength="5" placeholder="Örn. Kasım 2026 yazı işleri canlı deneme" /></label>
            <label><span>Başlangıç</span><input type="datetime-local" name="baslangic" required /></label>
            <label><span>Bitiş</span><input type="datetime-local" name="bitis" required /></label>
          </div>
          <label><span>Açıklama</span><input type="text" name="aciklama" placeholder="Örn. 80 soru, 100 dakika" /></label>
          <input type="hidden" name="kriter" value="GYS Canlı Deneme" />
          <div class="gys-form__eylem">
            <button type="submit" class="btn btn--kucuk">Yayınla</button>
            <span class="gys-durum" data-cs-admin-mesaj></span>
          </div>
        </form>
      </details>
    </section>
  </div>
</SubdomainLayout>
<script>import '../scripts/gys';</script>

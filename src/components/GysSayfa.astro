          </div>
        </form>
        <div data-gys-ozel-liste></div>
      </div>
    </section>

    <!-- 6. GEÇMİŞ GYS HABERLERİ VE TAKVİMLER -->
    <section class="panel" data-gys-panel="takvim" data-solid hidden>

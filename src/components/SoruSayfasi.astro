---
import Layout from '../layouts/Layout.astro';
import { ayarlar } from '../lib/settings';
import { type Soru, soruHref, komsuSorular, kisaCevap } from '../lib/mulakat';
import Okunma from './Okunma.astro';
import SesliOkuma from './SesliOkuma.astro';
import { buyukHarfDuzelt } from '../lib/bicim';
import { soruyaAitTerimler, benzerSorular } from '../lib/capraz';
import { terimHref, kisa } from '../lib/sozluk';
import { okunmaLd } from '../lib/okunma';
import KayitBilgisi from './KayitBilgisi.astro';

interface Props { s: Soru }
const { s } = Astro.props;
const site = ayarlar.site.url;
const path = soruHref(s);
const { onceki, sonraki, yakin } = komsuSorular(s, 3);
const terimlerde = soruyaAitTerimler(s);
const benzer = benzerSorular(s, [...yakin, ...(onceki ? [onceki] : []), ...(sonraki ? [sonraki] : [])]);
const paragraflar = s.cevap.split(/\n{2,}/);
const tur = s.mulakat ? 'Mülakat sorusu' : 'Hatırlatma kartı';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Çıkmış mülakat soruları', item: `${site}/cikmis-mulakat-sorulari/` },
    { '@type': 'ListItem', position: 3, name: s.soru, item: new URL(path, site).href },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'tr-TR', ...okunmaLd(path),
    mainEntity: [{ '@type': 'Question', name: s.soru, acceptedAnswer: { '@type': 'Answer', text: s.cevap } }] },
];
const soru = buyukHarfDuzelt(s.soru);
const aciklama = (() => { const t = kisaCevap(`${soru} Cevap: ${s.cevap}`, 155); return t.length >= 70 ? t : `${/[.!?…]$/.test(t) ? t : t + '.'} Kamu mülakatlarında sorulmuş soru ve cevabı.`; })();
// Başlık 65 karakteri geçmesin diye sonek kısaltılır; soru metninin kendisi kesilmez.
const baslik = [`${soru} | Çıkmış mülakat soruları | 657.com.tr`, `${soru} | Mülakat | 657.com.tr`].find(b => b.length <= 65) ?? `${soru} | 657.com.tr`;
---
<Layout title={baslik} description={aciklama} path={path} jsonLd={jsonLd} type="article" published={s.tarih}>
 <header class="portal-sayfa-basligi"><div class="container">
  <nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span aria-hidden="true">/</span><a href="/cikmis-mulakat-sorulari/">Çıkmış mülakat soruları</a></nav>
  <div class="portal-sayfa-basligi__satir"><div class="dir__head"><h1>{soru}</h1></div><div class="portal-sayfa-basligi__eylem"><span class="chip">{tur}</span><Okunma path={path}/></div></div>
 </div></header>
 <div class="container page">
  <article class="panel soru" data-solid>
   <div class="soru__cevap">
    <h2>Cevap</h2>
    {paragraflar.map(p => <p>{p.split('\n').flatMap((satir, i) => (i ? [<br/>, satir] : [satir]))}</p>)}
   </div>
   {s.kaynak&&<p class="maas-not">Kaynak: {s.kaynak}</p>}
   <SesliOkuma hedef="main h1, .soru__cevap"/>
   <KayitBilgisi tarih={s.tarih}/>
   <div class="soru__eylem">
    <a class="btn" href={`/cikmis-mulakat-sorulari/?kart=${encodeURIComponent(s.slug)}`}>Kartlarla çalış</a>
    <nav class="soru__gezin" aria-label="Önceki ve sonraki soru">
     {onceki && <a class="btn btn--quiet" href={soruHref(onceki)} rel="prev">Önceki soru</a>}
     {sonraki && <a class="btn btn--quiet" href={soruHref(sonraki)} rel="next">Sonraki soru</a>}
    </nav>
   </div>
  </article>
  {terimlerde.length > 0 && (
   <section class="panel" aria-labelledby="terim-title" data-solid>
    <div class="panel__head"><h2 id="terim-title">Soruda geçen hukuk terimleri</h2><a href="/hukuk-sozlugu/">Hukuk sözlüğü</a></div>
    <ol class="terimler terimler--iki">{terimlerde.map(t => <li><a href={terimHref(t)}><strong>{buyukHarfDuzelt(t.terim)}</strong><span>{kisa(t.anlam)}</span></a></li>)}</ol>
   </section>
  )}
  {benzer.length > 0 && (
   <section class="panel" aria-labelledby="benzer-title" data-solid>
    <div class="panel__head"><h2 id="benzer-title">Benzer sorular</h2></div>
    <ol class="terimler terimler--iki">{benzer.map(y => <li><a href={soruHref(y)}><strong>{buyukHarfDuzelt(y.soru)}</strong><span>{kisaCevap(y.cevap, 100)}</span></a></li>)}</ol>
   </section>
  )}
  {yakin.length > 0 && (
   <section class="panel" aria-labelledby="yakin-title" data-solid>
    <div class="panel__head"><h2 id="yakin-title">Diğer sorular</h2><a href="/cikmis-mulakat-sorulari/">Bütün sorular</a></div>
    <ol class="terimler terimler--iki">
     {yakin.map(y => <li><a href={soruHref(y)}><strong>{buyukHarfDuzelt(y.soru)}</strong><span>{kisaCevap(y.cevap, 100)}</span></a></li>)}
    </ol>
   </section>
  )}
 </div>
</Layout>

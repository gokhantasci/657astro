---
import { okunma, okunmaMetni } from '../lib/okunma';
interface Props { path: string }
const n = okunma(Astro.props.path);
---
<span class="okunma num" data-okunma-path={Astro.props.path}>
 <span title="WordPress arşivi ve son güncellemedeki Analytics toplamı">{okunmaMetni(n)}</span>
 <span data-okunma-yerel hidden></span>
</span>

---
import { okunma, okunmaMetni } from '../lib/okunma';
interface Props { path: string }
const n = okunma(Astro.props.path);
const path = new URL(Astro.props.path, Astro.site ?? 'https://657.com.tr').pathname;
---
<span class="okunma num" data-okunma-path={path} data-okunma-taban={n} data-okunma-api={import.meta.env.PUBLIC_OKUNMA_API??''}>
 <span data-okunma-bugun>Bugün: —</span> · <span data-okunma-toplam title="Arşiv tabanı ve ortak servisteki yeni görüntülemeler">Toplam: {okunmaMetni(n)}</span>
 <span data-okunma-yerel hidden></span>
</span>

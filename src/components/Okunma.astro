---
import { okunma, okunmaMetni } from '../lib/okunma';
interface Props { path: string }
const n = okunma(Astro.props.path);
---
<span class="okunma num" data-okunma-path={Astro.props.path} data-okunma-taban={n} data-okunma-api={import.meta.env.PUBLIC_OKUNMA_API??''}>
 <span data-okunma-toplam title="Arşiv toplamı; bu tarayıcıdaki yeni ziyaretler sayfa açıldığında eklenir">{okunmaMetni(n)}</span>
 <span data-okunma-yerel hidden></span>
</span>

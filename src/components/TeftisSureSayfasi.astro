---
import DogrudanYanit from './DogrudanYanit.astro';
import Layout from '../layouts/Layout.astro';
import {ayarlar} from '../lib/settings';
import {sureAraclari,type SureAraci} from '../lib/teftis-sure';
import {araclar} from '../lib/tools';
interface Props{tur:SureAraci}
const {tur}=Astro.props,c=sureAraclari[tur];
const kayit=araclar.find(a=>a.path===`/${tur}/`);
// Her süre aracının açıklaması kendi kaydından; ortak cümle yalnız dosya biçimini anlatır.
const aciklama=kayit?.description?`${kayit.description} UYAP zaman kontrolü Excel'i tarayıcıda okunur, sonuç Word'e aktarılır.`:"UYAP zaman kontrolü Excel'ini okuyun; süreleri karşılaştırın, hâkim ve dosya bazında arayın, filtrelenmiş listeyi Word'e aktarın.";
---
<Layout title={`${c.baslik} | 657.com.tr`} description={aciklama} path={`/${tur}/`} jsonLd={[{'@context':'https://schema.org','@type':'WebApplication',name:c.baslik,applicationCategory:'BusinessApplication',operatingSystem:'Tarayıcı',isAccessibleForFree:true}]}>
 <header class="portal-sayfa-basligi"><div class="container page--genis"><nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span>/</span><a href="/araclar/#teftis">Teftiş kontrolleri</a></nav><div class="portal-sayfa-basligi__satir"><div class="dir__head"><h1>{c.baslik}</h1><p>UYAP zaman kontrolü Excel dosyasındaki kayıtları inceleyin ve denetim listenizi oluşturun.</p></div></div><DogrudanYanit/></div></header>
 <div class="container page page--genis" data-teftis-sure={tur} data-boyut={ayarlar.site.tablo_sayfa_boyu}>
 <div class="teftis-calisma"> <section class="panel" data-solid><div class="panel__head"><h2>Excel dosyası</h2><button type="button" class="btn btn--quiet btn--kucuk" data-g-temizle>Temizle</button></div><div class="maas-form"><label for="g-dosya">XLS / XLSX dosyası seçin</label><input id="g-dosya" type="file" accept=".xls,.xlsx"/><p>Dosyanız tarayıcıda okunur; sunucuya yüklenmez. StyleSheet varsa o sayfa, yoksa ilk çalışma sayfası okunur.</p><p role="status" data-g-durum></p></div></section>
 <section class="panel" data-solid><div class="panel__head"><h2>Kayıtlar</h2><span data-g-sayi class="panel__not">Henüz veri yok</span></div><form class="maas-form" data-g-form><div class="maas-form__grid"><label class="maas-alan">Dosya, karar veya hâkim ara<input type="search" id="g-ara"/></label><label class="maas-alan">{tur==='hedef-sure-kontrolu'?'En az hedef süre aşımı (gün)':'En az bildirilen gecikme (gün)'}<input id="g-enaz" type="number" value="0" min="0" max="36500" step="1"/></label></div><button type="button" class="btn" data-g-word disabled>Görünen filtreyi Word'e aktar</button></form><div class="maas-tablo"><table class="grid teftis-tablo"><thead><tr>{c.basliklar.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody data-g-rows></tbody></table></div><nav class="pager teftis-pager" aria-label="Kayıt sayfaları"><button type="button" class="btn btn--quiet btn--kucuk" data-g-onceki disabled>Önceki</button><span data-g-sayfa>0 kayıt</span><button type="button" class="btn btn--quiet btn--kucuk" data-g-sonraki disabled>Sonraki</button></nav><details class="maas-form" data-g-uyari hidden><summary>Tarih ve süre uyuşmazlıkları</summary><ul></ul></details></section>
 <section class="panel" data-solid><div class="panel__head"><h2>Kontrol yöntemi</h2></div><div class="prose prose--kisa"><p>{tur==='hedef-sure-kontrolu'?'Hedef süre: D3 başlığı, C/G/J/K/M sütunları ve F5/F6 birim bilgileri.':tur==='iddianame'?'İddianame: D3 başlığı, C/F/G/I/J/K/L sütunları ve F5/F6 birim bilgileri.':'Tensip: D3 başlığı, C/F/H/K/L sütunları ve G5/G6 birim bilgileri.'} Kaynaktaki 657 aracının sütunları kullanılır. Geçersiz numaralar ve tekrarlanan başlıklar atlanır.</p><p>{tur==='hedef-sure-kontrolu'?'Öngörülen süre, aşan süre ve aşım sebebi UYAP raporundaki değerlerdir; yeni bir kanuni süre hesaplanmaz.':'Bildirilen gecikme ile iki tarih arasındaki takvim günü ayrı gösterilir.'} Tatil, yasal zaman kontrolü süresi veya raporun gecikmeden düşürdüğü günler kendiliğinden çıkarılmaz. Uyuşmazlık tek başına mevzuata aykırılık tespiti değildir. Word çıktısı seçili arama ve en az gün filtresindeki tüm kayıtları içerir; yalnız ekrandaki sayfayla sınırlı değildir.</p></div></section></div></div>
</Layout>
<script>import '../scripts/teftis-sure';</script>

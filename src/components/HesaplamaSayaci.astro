---
import { ARAC_SAYACLARI, HESAPLAMA_SAYACLARI_AKTIF } from '../lib/hesaplama-sayaclari';

interface Props {
  tur: string;
}

const { tur } = Astro.props;
const veri = ARAC_SAYACLARI.find(s=>s.anahtar===tur);
const sozluk = tur === 'hukuk-sozlugu';
---

{HESAPLAMA_SAYACLARI_AKTIF && veri && (
  <aside class="hesap-sayac-serit" data-hesap-sayaci={tur} aria-label={sozluk ? 'Sözlük arama sayacı' : `${veri.baslik} sayaç bilgisi`}>
    <span class="hesap-sayac-serit__ikon" aria-hidden="true">📊</span>
    <span class="hesap-sayac-serit__metin">
      {sozluk ? 'Sözlükte bugün ' : 'Bu araçla bugün '}<strong class="num" data-sayac-bugun>—</strong>,
      bu hafta <strong class="num" data-sayac-hafta>—</strong>,
      bu yıl <strong class="num" data-sayac-yil>—</strong>,
      ölçüm başlangıcından bu yana <strong class="num" data-sayac-toplam>—</strong> {sozluk ? 'arama yapıldı.' : 'kullanım gerçekleşti.'}
    </span>
    {sozluk && <small>Bu sayaç yalnızca terim aramalarını sayar. Sayfa ziyaretleri yukarıdaki görüntülenme sayacında gösterilir.</small>}
    <small data-sayac-durum role="status">Sayaç bilgileri yükleniyor…</small>
  </aside>
)}

<style>
  .hesap-sayac-serit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    margin-bottom: var(--space-md);
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    color: var(--color-ink-2);
    line-height: 1.4;
    max-width: 100%;
  }

  .hesap-sayac-serit__ikon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .hesap-sayac-serit strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .hesap-sayac-serit {
      display: flex;
      font-size: 0.75rem;
      padding: 6px 10px;
    }
  }
</style>

<script>
  import '../scripts/hesaplama-sayaci';
</script>

---
import Layout from '../layouts/Layout.astro';
import Alan from './MaasAlan.astro';
import Bolum from './MaasBolum.astro';
import type {KamuAraci} from '../lib/kamu-katalog';
import {kamuHesapla} from '../lib/kamu-hesaplari';
import {donem,maasKatsayilari,secenekler,parametreler,dereceler} from '../lib/maas-veri';
import {ayarlar,getKatsayilar} from '../lib/settings';
import {ondalik,donemAraligi} from '../lib/bicim';
import kurallar from '../data/kamu-kurallari.json' with {type:'json'};
import MaasTahmini from './MaasTahmini.astro';
import {varsayilanMaasTahmini as tahmin} from '../lib/maas-tahmini-veri';
import {TAHMINLI_KAMU_ARACLARI,kamuMaasTahmini} from '../lib/kamu-maas-tahmini';
const katsayili=['ucretli-ogretmen','isci-4d','akademik-ek-ders','ek-ders','ek-ders-saat','muhtar','belediye-baskani','surekli-yolluk','gecici-yolluk','lojman'];
interface Props {arac:KamuAraci}
const {arac}=Astro.props;
const hesapDonemi=arac.donemBaslangic?getKatsayilar(arac.donemBaslangic):donem;
const k=maasKatsayilari(hesapDonemi,'maas');
const baglam={aylik:k.aylik,asgariNet:hesapDonemi.asgari_ucret,muhtarGosterge:ayarlar.sabitler.muhtar_gosterge,seyyanenGosterge:ayarlar.sabitler.seyyanen_zam_gosterge,vergi:k.vergi!,kurallar};
const degerler=Object.fromEntries(arac.fields.map(a=>[a.id,a.value]));
const donemler=katsayili.includes(arac.id)?ayarlar.donemler.filter(d=>Number(d.baslangic.slice(0,4))===k.vergi!.yil&&(!['isci-4d','ucretli-ogretmen'].includes(arac.id)||d.baslangic>=(arac.donemBaslangic??''))).map(d=>({baslangic:d.baslangic,bitis:d.bitis,baglam:{...baglam,aylik:d.memur_maas_aylik_katsayi,asgariNet:d.asgari_ucret}})):[];
const r=kamuHesapla(arac.id,degerler,baglam);
// Maaş araçlarında alanlar kadrolu maaş formundaki sıraya göre katlanır bölümlere ayrılır:
// hesap seçenekleri, görev ve ücret, ek ödeme ve kesinti, vergi. Tek bölüme düşen araçlar düz kalır.
const kesintiAlanlari=/^(besOran|sendikaAidati|digerKesinti|prim|primYontemi|haciz|ilksan|polsan)$/;
const vergiAlanlari=/^(ay|oncekiMatrah|oncekiAsgariMatrah|oncekiPek|kullanilanGv|kullanilanDv|engellilik|gelirVergisiOrani)$/;
const maasAraci=['ucretli-ogretmen','isci-4d','belediye-baskani','ek-ders','ek-ders-saat','akademik-ek-ders'].includes(arac.id);
const gorevAlanlari=arac.fields.filter(f=>!kesintiAlanlari.test(f.id)&&!vergiAlanlari.test(f.id));
const kesintiListe=arac.fields.filter(f=>kesintiAlanlari.test(f.id));
const vergiListe=arac.fields.filter(f=>vergiAlanlari.test(f.id));
const bolumlu=maasAraci&&[gorevAlanlari,kesintiListe,vergiListe].filter(l=>l.length>0).length>=2;
const tahminVar=TAHMINLI_KAMU_ARACLARI.includes(arac.id);
const yollukVar=['surekli-yolluk','gecici-yolluk'].includes(arac.id);
const gelecek=tahminVar&&arac.id!=='isci-4d'?kamuMaasTahmini(arac.id,degerler,baglam,tahmin):null;
---
<Layout title={`${arac.title} | 657.com.tr`} description={arac.description} path={arac.path} jsonLd={[{'@context':'https://schema.org','@type':'WebApplication',name:arac.title,url:new URL(arac.path,Astro.site).href,applicationCategory:'FinanceApplication',operatingSystem:'Tarayıcı',inLanguage:'tr-TR',isAccessibleForFree:true}]}>
 <header class="portal-sayfa-basligi"><div class="container"><nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span aria-hidden="true">/</span><a href="/araclar/?alan=maas">Maaş ve yolluk</a></nav><div class="portal-sayfa-basligi__satir"><div class="dir__head"><h1>{arac.title}</h1><p>{arac.description}</p></div></div></div></header>
 <div class="container page">
  <div class="arac"><section class="panel" data-solid><div class="panel__head"><h2>Hesap bilgileri</h2><button class="btn btn--quiet btn--kucuk" type="button" data-kamu-sifirla>Sıfırla</button></div>
   <form class={bolumlu?"maas-form maas-form--bolumlu":"maas-form"} id="kamu-form">{donemler.length>0&&!bolumlu&&<Alan id="butceDonemi" label="Bütçe / katsayı dönemi" value={hesapDonemi.baslangic} options={donemler.map(d=>({value:d.baslangic,label:donemAraligi(d)}))}/>}{yollukVar&&<fieldset><legend>Unvan ve gündelik grubu</legend><div class="maas-form__grid"><Alan id="yollukUnvan" label="Unvan" value={1} options={secenekler.unvanlar.map(u=>({value:u.kod,label:u.ad}))}/><Alan id="yollukDerece" label="Aylık derecesi" value={3} options={Array.from({length:15},(_,i)=>({value:i+1,label:String(i+1)}))}/><Alan id="yollukKadroDerece" label="Kadro derecesi" value={3} options={Array.from({length:15},(_,i)=>({value:i+1,label:String(i+1)}))}/><Alan id="yollukEkGosterge" label="Kadro ek göstergesi" value={2200} min={0} max={15000}/><Alan id="yollukYontemi" label="Gündeliğin belirlenmesi" value={1} options={[{value:1,label:'Derece / ek göstergeye göre H/B grubu'},{value:0,label:'H cetveli grubunu kendim seçiyorum'}]}/></div><p class="maas-not">Ek göstergeyi görevlendirme belgenizden kontrol edin. H/A kapsamındaki üst görevler için gündelik grubunu kendiniz seçin. Özel denetim/arazi görevi istisnaları bu normal görev hesabında yoktur.</p></fieldset>}{bolumlu?<>{donemler.length>0&&<Bolum no={0} baslik="Hesaplama seçenekleri" aciklama="Bütçe ve katsayı dönemi" alanlar={['butceDonemi']}><div class="maas-form__grid"><Alan id="butceDonemi" label="Bütçe / katsayı dönemi" value={hesapDonemi.baslangic} options={donemler.map(d=>({value:d.baslangic,label:donemAraligi(d)}))}/></div></Bolum>}<Bolum no={1} baslik="Görev ve ücret bilgileri" aciklama="Ücret, süre ve aile bilgileri" alanlar={gorevAlanlari.map(f=>f.id)} acik><div class="maas-form__grid">{gorevAlanlari.map(f=><div><Alan id={f.id} label={f.label} value={f.value} options={f.options} min={f.min} max={f.max}/>{!f.options&&<small class="maas-not">{f.step===1?'Tam sayı':'Ondalık için virgül veya nokta kullanabilirsiniz.'}</small>}</div>)}</div></Bolum>{kesintiListe.length>0&&<Bolum no={2} baslik="Ek ödemeler ve kesintiler" aciklama="Prim, aidat ve diğer kesintiler" alanlar={kesintiListe.map(f=>f.id)}><div class="maas-form__grid">{kesintiListe.map(f=><div><Alan id={f.id} label={f.label} value={f.value} options={f.options} min={f.min} max={f.max}/>{!f.options&&<small class="maas-not">{f.step===1?'Tam sayı':'Ondalık için virgül veya nokta kullanabilirsiniz.'}</small>}</div>)}</div></Bolum>}{vergiListe.length>0&&<Bolum no={kesintiListe.length>0?3:2} baslik="Vergi ve gelişmiş seçenekler" aciklama="Ödeme ayı, kümülatif matrah ve istisnalar" alanlar={vergiListe.map(f=>f.id)}><div class="maas-form__grid">{vergiListe.map(f=><div><Alan id={f.id} label={f.label} value={f.value} options={f.options} min={f.min} max={f.max}/>{!f.options&&<small class="maas-not">{f.step===1?'Tam sayı':'Ondalık için virgül veya nokta kullanabilirsiniz.'}</small>}</div>)}</div></Bolum>}</>:<div class="maas-form__grid">{arac.fields.map(f=><div><Alan id={f.id} label={f.label} value={f.value} options={f.options} min={f.min} max={f.max}/>{!f.options&&<small class="maas-not">{f.step===1?'Tam sayı':'Ondalık için virgül veya nokta kullanabilirsiniz.'}</small>}</div>)}</div>}
    <p class="maas-not">Hesap dönemi: <span data-kamu-donem>{donemAraligi(hesapDonemi)}</span>. Yalnız tarife ve kuralları tanımlı dönemler seçilebilir. Bütün işlemler tarayıcınızda yapılır.</p><p role="alert" class="arac__hata" data-kamu-hata hidden></p><button type="submit" class="btn">Hesapla</button><noscript>Değiştirdiğiniz bilgilerle hesaplamak için JavaScript'i etkinleştirin. Gösterilen sonuç başlangıç örneğidir.</noscript>
   </form></section>
   <div class="maas-ozet-grubu"><section class="panel sonuc" data-solid><div class="panel__head"><h2>Sonuç</h2></div><div class="sonuc__ana" role="status" aria-live="polite"><p class="sonuc__deger num" data-kamu-deger>{ondalik(r.deger)} {r.birim}</p><p class="sonuc__aciklama" data-kamu-not>{r.not}</p></div><dl class="sonuc__satirlar" data-kamu-satirlar>{r.satirlar.map(s=><div><dt>{s.ad}</dt><dd class="num">{ondalik(s.deger)} {s.birim}</dd></div>)}</dl></section>
   {tahminVar&&<MaasTahmini net={gelecek?.net??null} not={gelecek?.not} tis={arac.id==='isci-4d'}/>}</div>
  </div>
  {Astro.slots.has('kapsam') ? <slot name="kapsam"/> : (
   <section class="panel" data-solid><div class="panel__head"><h2>Kaynaklar ve kapsam</h2></div><div class="prose prose--kisa"><p>Sonuç girilen bilgilere ve belirtilen kapsama göre hesaplanır. Kurumun bordro veya tahsis kararının yerine geçmez.</p><ul>{arac.sources.map(s=><li><a href={s.url}>{s.title}</a></li>)}</ul></div></section>
  )}
 </div>
 <script type="application/json" id="kamu-veri" set:html={JSON.stringify({arac,baglam,donemler,...(yollukVar?{yolluk:{parametreler,dereceler}}:{})}).replace(/</g,'\\u003c')}/>
</Layout>
<script>import '../scripts/kamu-hesaplari';import '../scripts/maas-bolum-ozet';</script>

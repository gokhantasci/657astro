---
import {Image} from 'astro:assets';
import type {CollectionEntry} from 'astro:content';
import {gun} from '../lib/bicim';
interface Props {yazilar:CollectionEntry<'yazilar'>[]}
const {yazilar}=Astro.props;
---
<section class="panel yazi-slider" aria-label="Öne çıkan yazılar" aria-roledescription="slayt gösterisi" data-slider>
 <div class="panel__head"><h2>Öne çıkan yazılar</h2><a href="/yazilar/">Tüm yazılar</a></div>
 <div class="yazi-slider__sahneler" aria-live="polite">{yazilar.map((y,i)=><article data-slide hidden={i>0} aria-label={`${i+1} / ${yazilar.length}`}>
  {y.data.gorsel&&<Image src={y.data.gorsel} alt="" width={900} loading={i===0?'eager':'lazy'}/>}
  <div class="yazi-slider__metin"><div class="news__meta"><span class="chip">{y.data.kategori[0]??'Yazı'}</span><time datetime={y.data.date.toISOString()}>{gun(y.data.date.toISOString())}</time></div><h3><a href={`/${y.id}/`}>{y.data.title}</a></h3><p>{y.data.description}</p></div>
 </article>)}</div>
 <nav class="yazi-slider__dugmeler" aria-label="Yazı slaytları"><button type="button" class="btn btn--quiet btn--kucuk" data-slide-prev aria-label="Önceki yazı">‹</button>{yazilar.map((y,i)=><button type="button" class="btn btn--quiet btn--kucuk" data-slide-index={i} aria-label={`${i+1}. yazı: ${y.data.title}`} aria-current={i===0?'true':undefined}>{i+1}</button>)}<button type="button" class="btn btn--quiet btn--kucuk" data-slide-next aria-label="Sonraki yazı">›</button></nav>
</section>
<script>
const root=document.querySelector('[data-slider]');if(root){const slides=[...root.querySelectorAll<HTMLElement>('[data-slide]')],tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-slide-index]')];let n=0;const show=(i:number)=>{n=(i+slides.length)%slides.length;slides.forEach((s,j)=>s.hidden=j!==n);tabs.forEach((t,j)=>{if(j===n)t.setAttribute('aria-current','true');else t.removeAttribute('aria-current');});};tabs.forEach((b,i)=>b.addEventListener('click',()=>show(i)));root.querySelector('[data-slide-prev]')?.addEventListener('click',()=>show(n-1));root.querySelector('[data-slide-next]')?.addEventListener('click',()=>show(n+1));}
</script>
<style>
/* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 · real content, no fabricated cover */
.yazi-slider{min-width:0;display:flex;flex-direction:column;}.yazi-slider__sahneler{flex:1;}.yazi-slider__dugmeler{margin-top:auto;}.yazi-slider article{min-width:0;}.yazi-slider article>img{width:100%;aspect-ratio:16/9;object-fit:cover;}.yazi-slider__metin{padding:var(--space-lg);display:grid;gap:var(--space-md);}.yazi-slider__metin h3{font-size:var(--text-2xl);line-height:1.3;max-width:none;}.yazi-slider__metin h3 a{text-decoration:none;}.yazi-slider__metin h3 a:hover{text-decoration:underline;}.yazi-slider__metin p{color:var(--color-ink-2);line-height:1.7;}.yazi-slider__dugmeler{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-2xs);padding:var(--space-sm) var(--space-md);border-top:1px solid var(--color-rule);}.yazi-slider__dugmeler [aria-current]{background:var(--color-accent);color:var(--color-accent-ink);}
@media(max-width:768px){.yazi-slider__metin{padding:var(--space-md);}.yazi-slider__metin h3{font-size:var(--text-xl);}}
</style>

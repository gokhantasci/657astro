---
import { okunmaLd } from '../lib/okunma';
import Okunma from './Okunma.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import YaziKarti from './YaziKarti.astro';
import { ayarlar } from '../lib/settings';
import {gun as gorunenGun} from '../lib/bicim';
import {kategoriYolu} from '../lib/yazi-kategorileri';
import {resmiKaynaklar} from '../lib/yazi-kaynaklari';
import {araclar} from '../lib/tools';
import {aracOlgusu} from '../lib/arac-olgulari';
import wpYonlendirme from '../data/wp-yonlendirmeler.json';
const eskiYeni = new Map(wpYonlendirme.kurallar.map(k => [k.eski, k.yeni]));

interface Props { yazi: CollectionEntry<'yazilar'> }
const { yazi } = Astro.props;
const { Content,headings } = await render(yazi);
const icindekiler=headings.filter(h=>h.depth===2);
const d = yazi.data;
const site = ayarlar.site.url;
const path = `/${yazi.id}/`;
const gun = (t: Date) => t.toISOString().slice(0, 10);
const tarih = (t: Date) => gorunenGun(t.toISOString());
const digerleri = (await getCollection('yazilar', y => !y.data.taslak && y.id !== yazi.id)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 4);
// Paylaşım ve yapısal veri için 1200 px genişliğinde tek bir görsel üretilir.
const paylasim = d.gorsel ? await getImage({ src: d.gorsel, width: Math.min(1200, d.gorsel.width), format: 'jpeg' }) : undefined;
const gorselUrl = paylasim ? new URL(paylasim.src, site).href : undefined;
const metinKaynaklari = resmiKaynaklar(yazi.body ?? '', d.kategori);
// Araç rehberi: metin kaynak anmıyorsa, bağlantı verdiği aracın dayandığı resmî kaynak gösterilir (araçla aynı kayıt).
const rehberKaynagi = (() => {
  if (metinKaynaklari.length || /gov\.tr|resmigazete/i.test(yazi.body ?? '')) return [];
  const yollar = [...(yazi.body ?? '').matchAll(/href="(?:https:\/\/657\.com\.tr)?(\/[^"#?]*)"/g)].map(m => m[1]);
  for (const y of yollar) { const hedef = eskiYeni.get(y) ?? y; const a = araclar.find(t => t.tasindi && t.path === hedef); const k = a && aracOlgusu(a)?.kaynak; if (a && k) return [{ ad: `${k.ad} (${a.title} aracının dayanağı)`, url: k.url }]; }
  return [];
})();
const kaynaklar = [...metinKaynaklari, ...rehberKaynagi];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Yazılar', item: `${site}/yazilar/` },
    { '@type': 'ListItem', position: 3, name: d.title, item: `${site}${path}` },
  ] },
  { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
    datePublished: gun(d.date), dateModified: gun(d.updated ?? d.date), inLanguage: 'tr-TR',
    ...(gorselUrl ? { image: [gorselUrl] } : {}),
    mainEntityOfPage: `${site}${path}`, author: { '@id': `${site}/#kurulus` }, publisher: { '@id': `${site}/#kurulus` },
    articleSection: d.kategori, ...(kaynaklar.length ? { citation: kaynaklar.map(k => ({ '@type': 'CreativeWork', name: k.ad, url: k.url })) } : {}), ...okunmaLd(path) },
];
// Aynı başlıklı başka yazı varsa (ör. farklı yılların aylık enflasyon haberi) sayfa başlığı yayın tarihiyle ayrışır.
// Aynı açıklamayı paylaşan yazılar (ör. aylık enflasyon haberleri) başlıkla ayrışır.
const kisalt = (s: string, n = 158) => s.length > n ? s.slice(0, n - 1).replace(/\s+\S*$/, '') + '…' : s;
const ayniAciklama = (await getCollection('yazilar', y => !y.data.taslak && y.id !== yazi.id)).some(y => y.data.description === d.description);
const aciklama = ayniAciklama ? kisalt(`${d.title}: ${d.description}`) : d.description;
const ayniBaslik = (await getCollection('yazilar', y => !y.data.taslak)).filter(y => y.data.title.trim().toLocaleLowerCase('tr-TR') === d.title.trim().toLocaleLowerCase('tr-TR')).length > 1;
---
<Layout title={`${d.title}${ayniBaslik ? ` (${gorunenGun(d.date.toISOString())})` : ''} | 657.com.tr`} description={aciklama} path={path} jsonLd={jsonLd} type="article" image={gorselUrl} sayacIcerikte>
 <div class="container page">
  <nav class="crumbs" aria-label="Konum"><a href="/">Anasayfa</a><span aria-hidden="true">/</span><a href="/yazilar/">Yazılar</a></nav>
  <article class="article panel" data-solid>
   {d.gorsel && (
    <figure class:list={['article__gorsel', { 'article__gorsel--kucuk': d.gorsel.width < 1000 }]}>
     <Picture src={d.gorsel} alt={d.gorselAlt!} formats={['avif', 'webp']} widths={[480, 960, 1440].filter(w => w <= d.gorsel!.width).concat(d.gorsel.width < 1440 ? [d.gorsel.width] : [])} sizes="(min-width: 1440px) 1310px, 100vw" loading="eager" fetchpriority="high"/>
    </figure>
   )}
   <header class="article__head">
    <div class="news__meta"><time datetime={gun(d.date)}>{tarih(d.date)}</time>{d.kategori.map(k => <a class="chip" href={kategoriYolu(k)}>{k}</a>)}</div>
    <h1>{d.title}</h1>
    <p class="article__ozet">{d.description}</p>
    <p class="article__yayin">Yayıncı: <a href="/gokhan-tasci-profil/">657.com.tr · Gökhan Taşçı</a>{d.updated&&<> · Son içerik güncellemesi: <time datetime={gun(d.updated)}>{tarih(d.updated)}</time></>} · <a href="/icerik-kaynaklari/">Kaynak ve düzeltme ilkeleri</a></p>
    <div class="news__meta" data-sayfa-okunma aria-label="Yazı okunma sayacı"><Okunma path={path}/></div>
   </header>
   {icindekiler.length>=3&&<nav class="article__icindekiler" aria-label="Yazının bölümleri"><strong>Bu yazıda</strong><ul>{icindekiler.map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>}
   <div class="prose"><Content/></div>
   {kaynaklar.length > 0 && <aside class="yazi-kaynak" aria-label="Resmî kaynaklar"><h2>Resmî kaynaklar</h2><ul>{kaynaklar.map(k => <li><a href={k.url} rel="noopener">{k.ad}</a></li>)}</ul></aside>}
  </article>
  {digerleri.length > 0 && (
   <aside class="panel" aria-labelledby="diger-title" data-solid>
    <div class="panel__head"><h2 id="diger-title">Diğer yazılar</h2><a href="/yazilar/">Tüm yazılar</a></div>
    <ul class="posts__list">{digerleri.map(y => <YaziKarti yazi={y} ozet={false}/>)}</ul>
   </aside>
  )}
 </div>
</Layout>
